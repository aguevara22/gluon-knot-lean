set_option autoImplicit false

namespace DirectGLSSW.HOMFLY.Gemini

open DirectGLSSW.HOMFLY

noncomputable section

/-- Subgroup of `Fin k ≃ Fin k` generated by adjacent transpositions
`adjacentComponentSwap r hr`. -/
inductive AdjacentSwapGenerated : {k : ℕ} → (Fin k ≃ Fin k) → Prop
  | refl {k : ℕ} : AdjacentSwapGenerated (Equiv.refl (Fin k))
  | adj {k : ℕ} (r : Fin k) (hr : r.val + 1 < k) :
      AdjacentSwapGenerated (adjacentComponentSwap r hr)
  | trans {k : ℕ} {σ τ : Fin k ≃ Fin k} :
      AdjacentSwapGenerated σ → AdjacentSwapGenerated τ →
      AdjacentSwapGenerated (σ.trans τ)

private theorem swap_conj_distinct {α : Type*} [DecidableEq α]
    (i m j : α) (him : i ≠ m) (hmj : m ≠ j) (hij : i ≠ j) :
    (Equiv.swap i m).trans ((Equiv.swap m j).trans (Equiv.swap i m)) =
      Equiv.swap i j := by
  ext x
  simp only [Equiv.trans_apply]
  by_cases hxi : x = i
  · subst hxi
    rw [Equiv.swap_apply_left, Equiv.swap_apply_left,
      Equiv.swap_apply_of_ne_of_ne hij.symm hmj.symm, Equiv.swap_apply_left]
  · by_cases hxm : x = m
    · subst hxm
      rw [Equiv.swap_apply_right, Equiv.swap_apply_of_ne_of_ne him hij,
        Equiv.swap_apply_left, Equiv.swap_apply_of_ne_of_ne him.symm hmj]
    · by_cases hxj : x = j
      · subst hxj
        rw [Equiv.swap_apply_of_ne_of_ne hij.symm hmj.symm,
          Equiv.swap_apply_right, Equiv.swap_apply_right, Equiv.swap_apply_right]
      · rw [Equiv.swap_apply_of_ne_of_ne hxi hxm,
          Equiv.swap_apply_of_ne_of_ne hxm hxj,
          Equiv.swap_apply_of_ne_of_ne hxi hxm,
          Equiv.swap_apply_of_ne_of_ne hxi hxj]

theorem adjacentSwapGenerated_swap_of_dist {k : ℕ} :
    ∀ (d : ℕ) (i j : Fin k), i.val ≤ j.val → j.val - i.val = d →
      AdjacentSwapGenerated (Equiv.swap i j)
  | 0, i, j, hle, hdist => by
      have hij : i = j := Fin.ext (by omega)
      subst hij
      rw [Equiv.swap_self]
      exact AdjacentSwapGenerated.refl
  | d + 1, i, j, hle, hdist => by
      have hjlt : j.val < k := j.isLt
      by_cases hd0 : d = 0
      · have hj : j = ⟨i.val + 1, by omega⟩ := Fin.ext (by dsimp; omega)
        rw [hj]
        exact AdjacentSwapGenerated.adj i (by omega)
      · let m : Fin k := ⟨i.val + 1, by omega⟩
        have him : i ≠ m := by
          intro h
          have hv := congrArg Fin.val h
          dsimp [m] at hv
          omega
        have hmj : m ≠ j := by
          intro h
          have hv := congrArg Fin.val h
          dsimp [m] at hv
          omega
        have hij : i ≠ j := by
          intro h
          have hv := congrArg Fin.val h
          omega
        rw [← swap_conj_distinct i m j him hmj hij]
        have hadj : AdjacentSwapGenerated (Equiv.swap i m) :=
          AdjacentSwapGenerated.adj i (by omega)
        have hrec : AdjacentSwapGenerated (Equiv.swap m j) :=
          adjacentSwapGenerated_swap_of_dist d m j (by dsimp [m]; omega) (by dsimp [m]; omega)
        exact AdjacentSwapGenerated.trans hadj (AdjacentSwapGenerated.trans hrec hadj)

theorem adjacentSwapGenerated_swap {k : ℕ} (i j : Fin k) :
    AdjacentSwapGenerated (Equiv.swap i j) := by
  by_cases hle : i.val ≤ j.val
  · exact adjacentSwapGenerated_swap_of_dist (j.val - i.val) i j hle rfl
  · rw [Equiv.swap_comm]
    exact adjacentSwapGenerated_swap_of_dist (i.val - j.val) j i (by omega) rfl

noncomputable def movedFinset {k : ℕ} (σ : Fin k ≃ Fin k) : Finset (Fin k) :=
  Finset.univ.filter (fun i : Fin k => σ i ≠ i)

private theorem movedFinset_trans_swap_subset_erase {k : ℕ}
    (σ : Fin k ≃ Fin k) (i : Fin k) (hi : i ∈ movedFinset σ) :
    movedFinset (σ.trans (Equiv.swap i (σ i))) ⊆ (movedFinset σ).erase i := by
  intro x hx
  have hxMoved : (σ.trans (Equiv.swap i (σ i))) x ≠ x := by
    simpa [movedFinset] using hx
  have hxi : x ≠ i := by
    intro h
    subst h
    apply hxMoved
    simp [Equiv.trans_apply]
  refine Finset.mem_erase.mpr ⟨hxi, ?_⟩
  simp only [movedFinset, Finset.mem_filter, Finset.mem_univ, true_and]
  intro hfix
  apply hxMoved
  have hx_ne_sigma_i : x ≠ σ i := by
    intro h
    apply hxi
    exact σ.injective (hfix.trans h)
  simp only [Equiv.trans_apply, hfix]
  exact Equiv.swap_apply_of_ne_of_ne hxi hx_ne_sigma_i

theorem adjacentSwapGenerated_of_movedCard_lt {k : ℕ} :
    ∀ (m : ℕ) (σ : Fin k ≃ Fin k), (movedFinset σ).card < m →
      AdjacentSwapGenerated σ
  | 0, _, hlt => False.elim (Nat.not_lt_zero _ hlt)
  | m + 1, σ, hlt => by
      by_cases hne : (movedFinset σ).Nonempty
      · obtain ⟨i, hi⟩ := hne
        let σ' := σ.trans (Equiv.swap i (σ i))
        have hsub := movedFinset_trans_swap_subset_erase σ i hi
        have hcard_le : (movedFinset σ').card ≤ ((movedFinset σ).erase i).card :=
          Finset.card_le_card hsub
        have hcard_erase := Finset.card_erase_lt_of_mem hi
        have hcard_lt : (movedFinset σ').card < m := by omega
        have hσ' : AdjacentSwapGenerated σ' :=
          adjacentSwapGenerated_of_movedCard_lt m σ' hcard_lt
        have hswap : AdjacentSwapGenerated (Equiv.swap i (σ i)) :=
          adjacentSwapGenerated_swap i (σ i)
        have hrecover : σ'.trans (Equiv.swap i (σ i)) = σ := by
          apply Equiv.ext
          intro x
          simp [σ', Equiv.trans_apply]
        rw [← hrecover]
        exact AdjacentSwapGenerated.trans hσ' hswap
      · have hEmpty : movedFinset σ = ∅ := Finset.not_nonempty_iff_eq_empty.mp hne
        have hrefl : σ = Equiv.refl (Fin k) := by
          apply Equiv.ext
          intro x
          change σ x = x
          by_contra hne'
          have hmem : x ∈ movedFinset σ := by simp [movedFinset, hne']
          rw [hEmpty] at hmem
          exact Finset.not_mem_empty x hmem
        rw [hrefl]
        exact AdjacentSwapGenerated.refl

theorem adjacentSwapGenerated_all {k : ℕ} (σ : Fin k ≃ Fin k) :
    AdjacentSwapGenerated σ :=
  adjacentSwapGenerated_of_movedCard_lt ((movedFinset σ).card + 1) σ
    (Nat.lt_succ_self _)

theorem reindexTraversalComponents_refl {D : PLLinkDiagram} (T : BasedTraversal D) :
    reindexTraversalComponents T (Equiv.refl (Fin (diagramComponentCount D))) = T := by
  cases T
  rfl

theorem reindexTraversalComponents_trans {D : PLLinkDiagram} (T : BasedTraversal D)
    (σ τ : Fin (diagramComponentCount D) ≃ Fin (diagramComponentCount D)) :
    reindexTraversalComponents T (σ.trans τ) =
      reindexTraversalComponents (reindexTraversalComponents T σ) τ := rfl

theorem descendingEvaluator_eq_reindex_of_adjacentSwap_invariance
    (D : PLLinkDiagram)
    (hAdj : ∀ (V : BasedTraversal D) (r : Fin (diagramComponentCount D))
      (hr : r.val + 1 < diagramComponentCount D),
      descendingLaurentEvaluator D
        (reindexTraversalComponents V (adjacentComponentSwap r hr)) =
        descendingLaurentEvaluator D V)
    (T : BasedTraversal D)
    (σ : Fin (diagramComponentCount D) ≃ Fin (diagramComponentCount D)) :
    descendingLaurentEvaluator D (reindexTraversalComponents T σ) =
      descendingLaurentEvaluator D T := by
  have hgen : AdjacentSwapGenerated σ := adjacentSwapGenerated_all σ
  induction hgen generalizing T with
  | refl =>
      rw [reindexTraversalComponents_refl]
  | adj r hr =>
      exact hAdj T r hr
  | trans _ _ ihσ ihτ =>
      rw [reindexTraversalComponents_trans]
      exact (ihτ (reindexTraversalComponents T _)).trans (ihσ T)

theorem descendingEvaluator_eq_any_traversal_of_adjacentSwap_invariance {n : ℕ}
    (outer : LowerCrossingEvaluatorSkeinIH n)
    (D : PLLinkDiagram) (hD : D.nCrossing = n)
    (hAdj : ∀ (V : BasedTraversal D) (r : Fin (diagramComponentCount D))
      (hr : r.val + 1 < diagramComponentCount D),
      descendingLaurentEvaluator D
        (reindexTraversalComponents V (adjacentComponentSwap r hr)) =
        descendingLaurentEvaluator D V)
    (T U : BasedTraversal D) :
    descendingLaurentEvaluator D T = descendingLaurentEvaluator D U := by
  let σ : Fin (diagramComponentCount D) ≃ Fin (diagramComponentCount D) :=
    T.componentIndex.symm.trans U.componentIndex
  have hOrder : (reindexTraversalComponents T σ).componentIndex = U.componentIndex := by
    ext C
    simp [reindexTraversalComponents, σ]
  have hBase := descendingEvaluator_eq_of_componentIndex_eq outer hD
    (reindexTraversalComponents T σ) U hOrder
  have hPerm := descendingEvaluator_eq_reindex_of_adjacentSwap_invariance D hAdj T σ
  exact hPerm.symm.trans hBase

theorem lowerCrossingEvaluatorSkeinIH_succ_of_descending_terminal {n : ℕ}
    (outer : LowerCrossingEvaluatorSkeinIH n)
    (hTerm : ∀ (D : PLLinkDiagram), D.nCrossing = n →
      ∀ (T : BasedTraversal D), badCrossings T = ∅ →
        ∀ (r : Fin (diagramComponentCount D))
          (hr : r.val + 1 < diagramComponentCount D),
          descendingLaurentEvaluator D
            (reindexTraversalComponents T (adjacentComponentSwap r hr)) =
            descendingUnlinkValue D) :
    LowerCrossingEvaluatorSkeinIH (n + 1) := by
  have hAdjAll' := (adjacentSwap_invariance_iff_descending_terminal outer).mpr hTerm
  have hAdjAll : ∀ (D : PLLinkDiagram), D.nCrossing = n →
      ∀ (T : BasedTraversal D) (r : Fin (diagramComponentCount D))
        (hr : r.val + 1 < diagramComponentCount D),
        descendingLaurentEvaluator D
          (reindexTraversalComponents T (adjacentComponentSwap r hr)) =
          descendingLaurentEvaluator D T := by
    intro D hD T r hr
    exact (hAdjAll' D hD T r hr).symm
  refine ⟨?_, ?_⟩
  · intro D E I hlt T U
    by_cases hlt' : D.nCrossing < n
    · exact outer.1 I hlt' T U
    · have hD : D.nCrossing = n := by omega
      have hDE : D.nCrossing = E.nCrossing := by
        simpa using Fintype.card_congr I.crossingEquiv
      have hE : E.nCrossing = n := hDE.symm.trans hD
      have hTransport : descendingLaurentEvaluator D T =
          descendingLaurentEvaluator E (I.transportTraversal T) :=
        (innerBadCard_simultaneous_induction outer ((badCrossings T).card + 1)).2
          I hD T (Nat.lt_succ_self _)
      have hSameE : descendingLaurentEvaluator E (I.transportTraversal T) =
          descendingLaurentEvaluator E U :=
        descendingEvaluator_eq_any_traversal_of_adjacentSwap_invariance outer E hE
          (hAdjAll E hE) (I.transportTraversal T) U
      exact hTransport.trans hSameE
  · intro D hlt T c
    by_cases hlt' : D.nCrossing < n
    · exact outer.2 hlt' T c
    · have hD : D.nCrossing = n := by omega
      exact descendingEvaluator_eq_any_pivot outer D hD T c

theorem lowerCrossingEvaluatorSkeinIH_zero : LowerCrossingEvaluatorSkeinIH 0 := by
  refine ⟨?_, ?_⟩
  · intro D E I hlt T U
    exact False.elim (Nat.not_lt_zero _ hlt)
  · intro D hlt T c
    exact False.elim (Nat.not_lt_zero _ hlt)

theorem all_skeinIH_of_descending_terminal_step
    (hStep : ∀ (n : ℕ), LowerCrossingEvaluatorSkeinIH n →
      ∀ (D : PLLinkDiagram), D.nCrossing = n →
        ∀ (T : BasedTraversal D), badCrossings T = ∅ →
          ∀ (r : Fin (diagramComponentCount D))
            (hr : r.val + 1 < diagramComponentCount D),
            descendingLaurentEvaluator D
              (reindexTraversalComponents T (adjacentComponentSwap r hr)) =
              descendingUnlinkValue D) :
    ∀ n : ℕ, LowerCrossingEvaluatorSkeinIH n
  | 0 => lowerCrossingEvaluatorSkeinIH_zero
  | n + 1 =>
      let outer := all_skeinIH_of_descending_terminal_step hStep n
      lowerCrossingEvaluatorSkeinIH_succ_of_descending_terminal outer (hStep n outer)

end

end DirectGLSSW.HOMFLY.Gemini




