@RProof.extreme_selected : ∀ {n : ℕ} [inst : NeZero n] (hn : 3 ≤ n) (E : CV.Event n) (e f g : ZMod n)
  (h3 : SM.remote e f ∧ SM.remote f g ∧ SM.remote e g ∧ CV.rep e < CV.rep f ∧ CV.rep f < CV.rep g)
  (h4e : SM.remote e f ∧ SM.remote e g ∧ f ≠ g ∧ CV.rep f < CV.rep g)
  (h4f : SM.remote f e ∧ SM.remote f g ∧ e ≠ g ∧ CV.rep e < CV.rep g)
  (h4g : SM.remote g e ∧ SM.remote g f ∧ e ≠ f ∧ CV.rep e < CV.rep f),
  E.IsSimpleRIII e f g h3 h4e h4f h4g → ∃ δ, 0 < δ ∧ δ ≤ E.radius ∧ RProof.ExtremeSelectedData hn E e f g δ
