open Set

-- Only the source curve hypotheses are inputs; no supplied cube cover,
-- waypoint-domain data or algebraic nonvanishing certificates.
example {n : ℕ} (hn : 3 ≤ n)
    (gamma : unitInterval → SM.LabelledTuple n) (hgamma : Continuous gamma)
    (hregular : ∀ t, SM.Regular (gamma t))
    (hfirst : SM.Generic (gamma 0)) (hlast : SM.Generic (gamma 1))
    (delta : ℝ) (hdelta : 0 < delta) :
    ∃ d : SM.CurveCubeSubdivision gamma delta,
      ∃ W : d.InternalWaypoint × SM.ScalarCoordinate n → ℝ,
        (∀ k, SM.tupleOfScalarCoordinates (SM.waypointProjection k W) ∈ d.overlap k) ∧
        (∀ j : d.CentralLegIndex, SM.JointLegConditions (d.centralLeg hn j) W) ∧
        d.waypoint W ⟨0, by omega⟩ = gamma 0 ∧
        d.waypoint W ⟨d.count, by omega⟩ = gamma 1 := by
  obtain ⟨d⟩ := SM.nonempty_curveCubeSubdivision hn gamma hgamma hregular hfirst hlast delta hdelta
  obtain ⟨W, hW, hj⟩ := d.exists_joint_central_waypoints hn
  exact ⟨d, W, hW, hj, d.waypoint_first W, d.waypoint_last W⟩

-- Every old source time has a cell, and every point of every local ordered
-- leg in that cell lies within delta of the actual old curve point.
example {n : ℕ} [NeZero n] {gamma : unitInterval → SM.LabelledTuple n} {delta : ℝ}
    (d : SM.CurveCubeSubdivision gamma delta)
    (W : d.InternalWaypoint × SM.ScalarCoordinate n → ℝ)
    (hW : ∀ k, SM.tupleOfScalarCoordinates (SM.waypointProjection k W) ∈ d.overlap k)
    (t : unitInterval) :
    ∃ i : Fin d.count, t ∈ d.cell i ∧ ∀ j : Fin (2*n), ∀ u : ℝ, u ∈ Icc 0 1 →
      dist (SM.tupleCoordinates (SM.tupleOfScalarCoordinates
        (SM.orderedScalarLeg (SM.scalarCoordinateOrder n)
          (SM.scalarCoordinates (d.waypoint W i.castSucc))
          (SM.scalarCoordinates (d.waypoint W i.succ)) j u)))
        (SM.tupleCoordinates (gamma t)) < delta := by
  obtain ⟨i, hi⟩ := SM.exists_uniformMeshCell d.count d.count_pos t
  refine ⟨i, hi, ?_⟩
  intro j u hu
  exact d.pairwise_dist_lt i _ (d.ordered_tuple_leg_mem_cube W hW i j u hu)
    _ (d.curve_mem_cube i t hi)

-- The actual central leg built from the chosen tuple waypoints receives
-- the collision consequence of the joint conditions for that very leg.
example {n : ℕ} [NeZero n] (hn : 3 ≤ n)
    {gamma : unitInterval → SM.LabelledTuple n} {delta : ℝ}
    (d : SM.CurveCubeSubdivision gamma delta)
    (W : d.InternalWaypoint × SM.ScalarCoordinate n → ℝ)
    (hJ : ∀ j : d.CentralLegIndex, SM.JointLegConditions (d.centralLeg hn j) W)
    (i : d.CentralCell) (j : Fin (2*n)) (u : ℝ) :
    Function.Injective (SM.tupleOfScalarCoordinates
      (SM.orderedScalarLeg (SM.scalarCoordinateOrder n)
        (SM.scalarCoordinates (d.waypoint W i.val.castSucc))
        (SM.scalarCoordinates (d.waypoint W i.val.succ)) j u)) := by
  rw [d.central_orderedLeg_eq_assignment hn W i j u]
  exact SM.central_leg_collision_free (d.centralLeg hn (i,j)) W (hJ (i,j)) u
