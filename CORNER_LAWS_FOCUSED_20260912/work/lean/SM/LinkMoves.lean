namespace SM.Link

open SM

noncomputable section

/-! ## Discs

The local replacements below happen inside a "clean disc" (sm-3:1086 "creates no other crossing in
its clean disc"; sm-3:1368-1369 "contained in a clean disc").  We take a disc to be a compact convex
subset of the plane with nonempty interior: this includes the round discs, the closed balls of the
sup metric (axis-parallel squares) and the SM's rectangles Δ (sm-3:4259-4267), and excludes the
shapes (annuli, disconnected regions) for which a local replacement would not be a Reidemeister
move. -/

/-- A *disc* of the plane for the local replacements: compact, convex, with nonempty interior
(the polygonal reading of the "clean disc" of sm-3:1086 and sm-3:1368-1369; the SM's own local
regions are round discs and rectangles Δ, sm-3:4259-4267, all of this kind). -/
def IsDisc (U : Set Plane) : Prop := Convex ℝ U ∧ IsCompact U ∧ (interior U).Nonempty

/-- Sanity: every closed ball of positive radius (in the product metric of `Plane = ℝ × ℝ`, an
axis-parallel square) is a disc. -/
theorem isDisc_closedBall (c : Plane) {r : ℝ} (hr : 0 < r) : IsDisc (Metric.closedBall c r) :=
  ⟨convex_closedBall c r, isCompact_closedBall c r,
    ⟨c, Metric.ball_subset_interior_closedBall (Metric.mem_ball_self hr)⟩⟩

theorem IsDisc.convex {U : Set Plane} (h : IsDisc U) : Convex ℝ U := h.1
theorem IsDisc.isCompact {U : Set Plane} (h : IsDisc U) : IsCompact U := h.2.1
theorem IsDisc.interior_nonempty {U : Set Plane} (h : IsDisc U) : (interior U).Nonempty := h.2.2
theorem IsDisc.nonempty {U : Set Plane} (h : IsDisc U) : U.Nonempty :=
  h.interior_nonempty.mono interior_subset

/-! ## Traversal arcs inside a region -/

namespace Shadow

variable (Γ : Shadow)

/-- The strand (directed edge) carrying a traversal point: the component and the edge label. -/
def strandOf (p : Γ.Pt) : Γ.Strand := ⟨p.1, p.2.1⟩

@[simp] theorem strandOf_mk (i : Fin Γ.c) (p : TraversalPoint (Γ.comp i).k) :
    Γ.strandOf ⟨i, p⟩ = ⟨i, p.1⟩ := rfl

/-- The strand along which the traversal *arrives* at a traversal point: the same strand for an
interior point of an edge, the preceding edge `⟨i, j − 1⟩` at the vertex `⟨i, (j, 0)⟩`. -/
def strandBefore (p : Γ.Pt) : Γ.Strand :=
  if p.2.2.val = 0 then ⟨p.1, p.2.1 - 1⟩ else ⟨p.1, p.2.1⟩

theorem strandBefore_of_zero (p : Γ.Pt) (h : p.2.2.val = 0) : Γ.strandBefore p = ⟨p.1, p.2.1 - 1⟩ := by
  unfold strandBefore; rw [ite_eq_left h]

theorem strandBefore_of_ne_zero (p : Γ.Pt) (h : p.2.2.val ≠ 0) : Γ.strandBefore p = Γ.strandOf p := by
  unfold strandBefore; rw [ite_eq_right h]; rfl

/-- The traversal points of a shadow evaluating *outside* the open region `interior U` (on the
frontier or beyond): the part of the diagram a local replacement leaves untouched. -/
abbrev Outside (U : Set Plane) : Type := {p : Γ.Pt // Γ.eval p ∉ _root_.interior U}

/-- A closed *traversal arc* of a shadow: a component `i` and two traversal points `start ≠ stop`
on it; the arc is the closed cyclic interval from `start` to `stop` in the orientation of the
component.  Used for the pieces of a diagram inside a disc (mp:join sm-3:1367-1368: "a specified
closed nonsingular oriented interval I on one component"). -/
structure Arc where
  /-- the component carrying the arc -/
  i : Fin Γ.c
  /-- the entering end (first point of the arc along the orientation) -/
  start : TraversalPoint (Γ.comp i).k
  /-- the exiting end (last point of the arc along the orientation) -/
  stop : TraversalPoint (Γ.comp i).k

namespace Arc

variable {Γ} (a : Γ.Arc)

/-- The entering end as a traversal point of the shadow. -/
def startPt : Γ.Pt := ⟨a.i, a.start⟩

/-- The exiting end as a traversal point of the shadow. -/
def stopPt : Γ.Pt := ⟨a.i, a.stop⟩

/-- `p` is an *inner* point of the arc: strictly between `start` and `stop` in the accepted cyclic
order `traversalBetween` of the component. -/
def Inner (p : Γ.Pt) : Prop := ∃ r, traversalBetween a.start r a.stop ∧ p = ⟨a.i, r⟩

/-- `p` lies on the closed arc: it is an end or an inner point. -/
def Mem (p : Γ.Pt) : Prop := p = a.startPt ∨ p = a.stopPt ∨ a.Inner p

/-- Two inner points of the arc in traversal order: `p` is met before `q` when the arc is traversed
from `start` to `stop`. -/
def Before (p q : Γ.Pt) : Prop :=
  a.Inner p ∧ a.Inner q ∧ ∃ r s, p = ⟨a.i, r⟩ ∧ q = ⟨a.i, s⟩ ∧ traversalBetween a.start r s

theorem Inner.mem {p : Γ.Pt} (h : a.Inner p) : a.Mem p := Or.inr (Or.inr h)

theorem startPt_mem : a.Mem a.startPt := Or.inl rfl

theorem stopPt_mem : a.Mem a.stopPt := Or.inr (Or.inl rfl)

theorem Inner.fst {p : Γ.Pt} (h : a.Inner p) : p.1 = a.i := by
  obtain ⟨r, -, rfl⟩ := h
  rfl

theorem Mem.fst {p : Γ.Pt} (h : a.Mem p) : p.1 = a.i := by
  rcases h with rfl | rfl | h
  · rfl
  · rfl
  · exact h.fst

theorem Before.inner_left {p q : Γ.Pt} (h : a.Before p q) : a.Inner p := h.1
theorem Before.inner_right {p q : Γ.Pt} (h : a.Before p q) : a.Inner q := h.2.1

end Arc

/-- `a` is an *arc of `U`*: its two ends lie on the frontier of `U` and all its inner points lie in
the open interior (the traversal enters `U` at `start` and leaves it at `stop`). -/
structure IsArc (U : Set Plane) (a : Γ.Arc) : Prop where
  start_ne_stop : a.start ≠ a.stop
  start_frontier : Γ.eval a.startPt ∈ frontier U
  stop_frontier : Γ.eval a.stopPt ∈ frontier U
  inner_interior : ∀ p, a.Inner p → Γ.eval p ∈ _root_.interior U

/-- The part of the shadow inside `U` is exactly the family of arcs `A`: every member of `A` is an
arc of `U`, a traversal point evaluates into `U` iff it lies on one of the arcs, and distinct arcs
of `A` are disjoint.  (Together with `Clean` below this says "`D ∩ U` consists of the arcs `A` and
nothing else".) -/
structure ArcCover (U : Set Plane) (A : Set Γ.Arc) : Prop where
  isArc : ∀ a ∈ A, Γ.IsArc U a
  mem_iff : ∀ p : Γ.Pt, Γ.eval p ∈ U ↔ ∃ a ∈ A, a.Mem p
  disjoint : ∀ a ∈ A, ∀ b ∈ A, a ≠ b → ∀ p, a.Mem p → ¬ b.Mem p

/-! ### Vertex tuples of a shadow (for `Deform`) -/

/-- The vertex tuples of a shadow: one `LabelledTuple` per component, with the shadow's vertex
counts. -/
abbrev Vertices : Type := ∀ i : Fin Γ.c, LabelledTuple (Γ.comp i).k

/-- The vertex tuples of the shadow itself. -/
def vertices : Γ.Vertices := fun i => (Γ.comp i).P

/-- The shadow with the same component and vertex counts and the vertex tuples `V`.  Its strands,
traversal points and strand pairs are literally those of `Γ`. -/
abbrev withVertices (V : Γ.Vertices) : Shadow :=
  ⟨Γ.c, Γ.hc, fun i => ⟨(Γ.comp i).k, (Γ.comp i).hk, V i⟩⟩

/-- Sanity: reinstalling a shadow's own vertices gives back the shadow. -/
theorem withVertices_vertices : Γ.withVertices Γ.vertices = Γ := rfl

theorem withVertices_c (V : Γ.Vertices) : (Γ.withVertices V).c = Γ.c := rfl

theorem withVertices_k (V : Γ.Vertices) (i : Fin Γ.c) :
    ((Γ.withVertices V).comp i).k = (Γ.comp i).k := rfl

theorem withVertices_P (V : Γ.Vertices) (i : Fin Γ.c) :
    ((Γ.withVertices V).comp i).P = V i := rfl

/-- Sanity: the strands of a re-vertexed shadow are the strands of the shadow. -/
theorem withVertices_Strand (V : Γ.Vertices) : (Γ.withVertices V).Strand = Γ.Strand := rfl

end Shadow

/-! ## Outer and inner crossings; the outside match -/

namespace Diagram

variable (D : Diagram)

/-- The crossings whose double point is not in the open region `interior U`. -/
abbrev OuterCrossing (U : Set Plane) : Type :=
  {x : D.Γ.Crossing // D.Γ.crossingPoint x ∉ interior U}

/-- The crossings whose double point lies in the open region `interior U`. -/
abbrev InnerCrossing (U : Set Plane) : Type :=
  {x : D.Γ.Crossing // D.Γ.crossingPoint x ∈ interior U}

instance instFintypeOuterCrossing (U : Set Plane) : Fintype (D.OuterCrossing U) := by
  classical
  exact inferInstance

instance instFintypeInnerCrossing (U : Set Plane) : Fintype (D.InnerCrossing U) := by
  classical
  exact inferInstance

/-- Sanity: every crossing is inner or outer. -/
theorem card_crossing_eq_inner_add_outer (U : Set Plane) :
    Fintype.card D.Γ.Crossing =
      Fintype.card (D.InnerCrossing U) + Fintype.card (D.OuterCrossing U) := by
  classical
  rw [← Fintype.card_sum]
  exact (Fintype.card_congr
    (Equiv.sumCompl (fun x : D.Γ.Crossing => D.Γ.crossingPoint x ∈ interior U))).symm

/-- The over occurrence of an outer crossing, as an outside traversal point. -/
def outerOverPt {U : Set Plane} (x : D.OuterCrossing U) : D.Γ.Outside U :=
  ⟨D.visitPt (D.overVisit x.1), by rw [eval_visitPt]; exact x.2⟩

/-- The under occurrence of an outer crossing, as an outside traversal point. -/
def outerUnderPt {U : Set Plane} (x : D.OuterCrossing U) : D.Γ.Outside U :=
  ⟨D.visitPt (D.underVisit x.1), by rw [eval_visitPt]; exact x.2⟩

@[simp] theorem outerOverPt_val {U : Set Plane} (x : D.OuterCrossing U) :
    (D.outerOverPt x).1 = D.visitPt (D.overVisit x.1) := rfl

@[simp] theorem outerUnderPt_val {U : Set Plane} (x : D.OuterCrossing U) :
    (D.outerUnderPt x).1 = D.visitPt (D.underVisit x.1) := rfl

/-- The arc `a` carries the over occurrence of the crossing `x`. -/
def OverOn (a : D.Γ.Arc) (x : D.Γ.Crossing) : Prop := a.Mem (D.visitPt (D.overVisit x))

/-- The arc `a` carries the under occurrence of the crossing `x`. -/
def UnderOn (a : D.Γ.Arc) (x : D.Γ.Crossing) : Prop := a.Mem (D.visitPt (D.underVisit x))

/-- The crossing `x` is a crossing *between* the two arcs `a` and `b`: one occurrence on each. -/
def Separates (a b : D.Γ.Arc) (x : D.Γ.Crossing) : Prop :=
  (D.OverOn a x ∧ D.UnderOn b x) ∨ (D.OverOn b x ∧ D.UnderOn a x)

/-- Along the arc `a`, the occurrence of the crossing `x` on `a` is met before the occurrence of
the crossing `y` on `a`. -/
def BeforeOn (a : D.Γ.Arc) (x y : D.Γ.Crossing) : Prop :=
  ∃ v w : D.Γ.Visit, v.1 = x ∧ w.1 = y ∧ a.Before (D.visitPt v) (D.visitPt w)

end Diagram

/-- The *outside match* of two diagrams relative to a region `U`: the traversal points outside the
open region `interior U` correspond bijectively, with the same plane points (identical traces
outside `U`), the same forward and arriving directions up to a positive factor at every point
strictly outside `U` (identical orientations; the trace meets `∂U` only at the finitely many arc
ends, so every outside piece has such points), and the
crossings outside `interior U` correspond bijectively with over occurrence to over occurrence and
under occurrence to under occurrence (identical over data outside `U`).  This is the primitive
"identical outside a disc" of the moves and of the skein triple (design file, section
skein_and_moves: "`AgreeOutside (B : Set Plane) D D'`: ... `eval' (φ p) = eval p` whenever
`eval p ∉ interior B`, crossings with point outside `interior B` correspond under φ with the same
over visit"). -/
structure OutsideMatch (U : Set Plane) (D D' : Diagram) where
  /-- the correspondence of outside traversal points -/
  φ : D.Γ.Outside U ≃ D'.Γ.Outside U
  /-- same traced points outside -/
  eval_eq : ∀ p, D'.Γ.eval (φ p).1 = D.Γ.eval p.1
  /-- same forward direction at every point strictly outside `U` (up to a positive factor:
  subdivision and reparametrization); at a frontier point the outgoing direction may enter `U` -/
  dir_pos : ∀ p, D.Γ.eval p.1 ∉ U → ∃ l : ℝ, 0 < l ∧
    D'.Γ.dir (D'.Γ.strandOf (φ p).1) = l • D.Γ.dir (D.Γ.strandOf p.1)
  /-- same arriving direction at every point strictly outside `U` (the two one-sided tangents of
  the oriented curve; needed so that reversal, which exchanges them, transports the match) -/
  dir_pos_before : ∀ p, D.Γ.eval p.1 ∉ U → ∃ l : ℝ, 0 < l ∧
    D'.Γ.dir (D'.Γ.strandBefore (φ p).1) = l • D.Γ.dir (D.Γ.strandBefore p.1)
  /-- the correspondence of outer crossings -/
  ψ : D.OuterCrossing U ≃ D'.OuterCrossing U
  /-- over occurrences correspond -/
  over_eq : ∀ x, φ (D.outerOverPt x) = D'.outerOverPt (ψ x)
  /-- under occurrences correspond -/
  under_eq : ∀ x, φ (D.outerUnderPt x) = D'.outerUnderPt (ψ x)

/-- `D` and `D'` agree outside the region `U` (design file: `AgreeOutside`). -/
def AgreeOutside (U : Set Plane) (D D' : Diagram) : Prop := Nonempty (OutsideMatch U D D')

/-- A diagram meets the region `U` *cleanly*: each frontier point of its trace is traversed exactly
once (so no crossing point and no tangency lies on `∂U`), and no component lies entirely inside
`U`. -/
structure Clean (U : Set Plane) (D : Diagram) : Prop where
  frontier_injOn : Set.InjOn D.Γ.eval {p | D.Γ.eval p ∈ frontier U}
  exits : ∀ i : Fin D.Γ.c, ∃ p, D.Γ.eval ⟨i, p⟩ ∉ U

/-- The common frame of every disc-local replacement: `U` is a disc and both diagrams meet it
cleanly. -/
structure LocalFrame (U : Set Plane) (D D' : Diagram) : Prop where
  disc : IsDisc U
  clean : Clean U D
  clean' : Clean U D'

/-- An outside match together with a bijection of the components respected by the match: a
Reidemeister move never changes which component a strand belongs to (the three moves keep the
components; the smoothing does not, so it uses the bare `OutsideMatch`). -/
structure MoveMatch (U : Set Plane) (D D' : Diagram) extends OutsideMatch U D D' where
  /-- the component bijection -/
  e : Fin D.Γ.c ≃ Fin D'.Γ.c
  /-- the match respects it -/
  comp_eq : ∀ p, (φ p).1.1 = e p.1.1

/-! ## Reparametrization -/

/-- The data of a *reparametrization* of `D` as `D'` (design file: "same trace, subdivision,
relabelling, component reindexing"): a bijection `e` of the components and, on each component, a
bijection `φ i` of the parameter circles preserving the accepted strict cyclic order
`traversalBetween` (so orientations are kept), tracing the same plane points, and carrying the over
occurrence of every crossing to the over occurrence of a crossing (both ways).  Cyclic shifts of
the labels, subdivisions of edges and relabellings of components are reparametrizations. -/
structure ReparamData (D D' : Diagram) where
  /-- the component relabelling -/
  e : Fin D.Γ.c ≃ Fin D'.Γ.c
  /-- the parameter-circle bijections -/
  φ : ∀ i, TraversalPoint (D.Γ.comp i).k ≃ TraversalPoint (D'.Γ.comp (e i)).k
  /-- orientation kept: the strict cyclic order is preserved -/
  between : ∀ i p q r, traversalBetween p q r → traversalBetween (φ i p) (φ i q) (φ i r)
  /-- same traced points -/
  eval_eq : ∀ i p, D'.Γ.eval ⟨e i, φ i p⟩ = D.Γ.eval ⟨i, p⟩
  /-- over occurrences are carried to over occurrences -/
  over_map : ∀ x : D.Γ.Crossing, ∃ x' : D'.Γ.Crossing,
    (⟨e _, φ _ (D.visitPt (D.overVisit x)).2⟩ : D'.Γ.Pt) = D'.visitPt (D'.overVisit x')
  /-- every over occurrence of `D'` comes from one of `D` -/
  over_surj : ∀ x' : D'.Γ.Crossing, ∃ x : D.Γ.Crossing,
    (⟨e _, φ _ (D.visitPt (D.overVisit x)).2⟩ : D'.Γ.Pt) = D'.visitPt (D'.overVisit x')

/-- `D'` is a reparametrization of `D`. -/
def Reparam (D D' : Diagram) : Prop := Nonempty (ReparamData D D')

namespace ReparamData

variable {D D' : Diagram}

/-- The induced map on traversal points. -/
def mapPt (r : ReparamData D D') (p : D.Γ.Pt) : D'.Γ.Pt := ⟨r.e p.1, r.φ p.1 p.2⟩

theorem eval_mapPt (r : ReparamData D D') (p : D.Γ.Pt) : D'.Γ.eval (r.mapPt p) = D.Γ.eval p :=
  r.eval_eq p.1 p.2

/-- The identity reparametrization. -/
def refl (D : Diagram) : ReparamData D D where
  e := Equiv.refl _
  φ := fun _ => Equiv.refl _
  between := fun _ _ _ _ h => h
  eval_eq := fun _ _ => rfl
  over_map := fun x => ⟨x, rfl⟩
  over_surj := fun x => ⟨x, rfl⟩

/-- Sanity: a reparametrization preserves the component count. -/
theorem componentCount_eq (r : ReparamData D D') : D.componentCount = D'.componentCount := by
  show D.Γ.c = D'.Γ.c
  simpa using Fintype.card_congr r.e

end ReparamData

theorem Reparam.refl (D : Diagram) : Reparam D D := ⟨ReparamData.refl D⟩

theorem Reparam.componentCount_eq {D D' : Diagram} (h : Reparam D D') :
    D.componentCount = D'.componentCount := h.elim fun r => r.componentCount_eq

/-! ## Generic deformation -/

namespace Diagram

variable (D : Diagram)

/-- The diagram on the re-vertexed shadow `D.Γ.withVertices V` with the over data of `D`, given that
the new shadow is generic and has literally the same crossing pairs (the strands are the same
type). -/
def deform (V : D.Γ.Vertices) (hgen : (D.Γ.withVertices V).Generic)
    (hcross : ∀ x : Finset D.Γ.Strand, (D.Γ.withVertices V).IsCrossing x ↔ D.Γ.IsCrossing x) :
    Diagram where
  Γ := D.Γ.withVertices V
  generic := hgen
  overStrand := fun x => D.overStrand ⟨x.val, (hcross x.val).mp x.2⟩
  over_mem := fun x => D.over_mem ⟨x.val, (hcross x.val).mp x.2⟩

variable (V : D.Γ.Vertices) (hgen : (D.Γ.withVertices V).Generic)
  (hcross : ∀ x : Finset D.Γ.Strand, (D.Γ.withVertices V).IsCrossing x ↔ D.Γ.IsCrossing x)

@[simp] theorem deform_Γ : (D.deform V hgen hcross).Γ = D.Γ.withVertices V := rfl

/-- Sanity: the over strand is kept (same strand labels). -/
theorem deform_overStrand (x : (D.Γ.withVertices V).Crossing) :
    (D.deform V hgen hcross).overStrand x = D.overStrand ⟨x.val, (hcross x.val).mp x.2⟩ := rfl

theorem deform_componentCount : (D.deform V hgen hcross).componentCount = D.componentCount := rfl

/-- Sanity: reinstalling the diagram's own vertices changes nothing. -/
theorem deform_vertices (hgen : (D.Γ.withVertices D.Γ.vertices).Generic)
    (hcross : ∀ x : Finset D.Γ.Strand,
      (D.Γ.withVertices D.Γ.vertices).IsCrossing x ↔ D.Γ.IsCrossing x) :
    D.deform D.Γ.vertices hgen hcross = D := rfl

end Diagram

/-- The data of a *generic deformation* of `D` into `D'` (design file: "a continuous path of
shadows through generic shadows with the same combinatorics, keeping over data"): a path `γ` of
vertex tuples, each vertex moving continuously on `[0,1]`, starting at the vertices of `D`, every
intermediate shadow generic with literally the same crossing pairs as `D`, and ending at `D'`,
which carries the over data of `D` (`Diagram.deform`).  Component count and vertex counts are the
same by construction. -/
structure DeformData (D D' : Diagram) where
  /-- the path of vertex tuples -/
  γ : ℝ → D.Γ.Vertices
  /-- each vertex moves continuously on `[0,1]` -/
  continuous : ∀ i j, ContinuousOn (fun t => γ t i j) (Set.Icc 0 1)
  /-- the path starts at `D` -/
  start : γ 0 = D.Γ.vertices
  /-- every intermediate shadow is generic -/
  generic : ∀ t ∈ Set.Icc (0 : ℝ) 1, (D.Γ.withVertices (γ t)).Generic
  /-- the crossing pairs are constant along the path -/
  crossings : ∀ t ∈ Set.Icc (0 : ℝ) 1, ∀ x : Finset D.Γ.Strand,
    (D.Γ.withVertices (γ t)).IsCrossing x ↔ D.Γ.IsCrossing x
  /-- the path ends at `D'`, with the over data of `D` -/
  stop : D' = D.deform (γ 1) (generic 1 ⟨zero_le_one, le_rfl⟩) (crossings 1 ⟨zero_le_one, le_rfl⟩)

/-- `D'` is a generic deformation of `D`. -/
def Deform (D D' : Diagram) : Prop := Nonempty (DeformData D D')

namespace DeformData

/-- The constant path. -/
def refl (D : Diagram) : DeformData D D where
  γ := fun _ => D.Γ.vertices
  continuous := fun _ _ => continuousOn_const
  start := rfl
  generic := fun _ _ => D.generic
  crossings := fun _ _ _ => Iff.rfl
  stop := rfl

variable {D D' : Diagram}

/-- Sanity: a deformation preserves the shadow's component count. -/
theorem componentCount_eq (d : DeformData D D') : D'.componentCount = D.componentCount := by
  have h := congrArg Diagram.componentCount d.stop
  exact h

/-- Sanity: the shadow of `D'` is the re-vertexed shadow of `D`. -/
theorem Γ_eq (d : DeformData D D') : D'.Γ = D.Γ.withVertices (d.γ 1) := by
  have h := congrArg Diagram.Γ d.stop
  exact h

end DeformData

theorem Deform.refl (D : Diagram) : Deform D D := ⟨DeformData.refl D⟩

theorem Deform.componentCount_eq {D D' : Diagram} (h : Deform D D') :
    D'.componentCount = D.componentCount := h.elim fun d => d.componentCount_eq

/-! ## Planar isotopy -/

/-- *Planar isotopy* ("planar isotopy" of lit:homfly sm-3:918; "positive page isotopy" of lp:lm
sm-3:941): the equivalence relation generated by reparametrizations and generic deformations
(design decision D2: `PlanarIsotopic := EqvGen (Reparam ∨ Deform)`, PL page isotopy in the class of
sm-3:340-341). -/
def PlanarIsotopic : Diagram → Diagram → Prop :=
  Relation.EqvGen fun D D' => Reparam D D' ∨ Deform D D'

theorem PlanarIsotopic.of_reparam {D D' : Diagram} (h : Reparam D D') : PlanarIsotopic D D' :=
  Relation.EqvGen.rel _ _ (Or.inl h)

theorem PlanarIsotopic.of_deform {D D' : Diagram} (h : Deform D D') : PlanarIsotopic D D' :=
  Relation.EqvGen.rel _ _ (Or.inr h)

/-- Planar isotopy is an equivalence relation. -/
theorem planarIsotopic_equivalence : Equivalence PlanarIsotopic :=
  Relation.EqvGen.is_equivalence _

theorem PlanarIsotopic.refl (D : Diagram) : PlanarIsotopic D D := Relation.EqvGen.refl D

theorem PlanarIsotopic.symm {D D' : Diagram} (h : PlanarIsotopic D D') : PlanarIsotopic D' D :=
  Relation.EqvGen.symm _ _ h

theorem PlanarIsotopic.trans {D D' D'' : Diagram} (h : PlanarIsotopic D D')
    (h' : PlanarIsotopic D' D'') : PlanarIsotopic D D'' :=
  Relation.EqvGen.trans _ _ _ h h'

/-- A function invariant under reparametrizations and generic deformations is invariant under
planar isotopy (the generators generate). -/
theorem eq_of_planarIsotopic {α : Sort*} (H : Diagram → α)
    (hR : ∀ D D', Reparam D D' → H D = H D') (hD : ∀ D D', Deform D D' → H D = H D')
    {D D' : Diagram} (h : PlanarIsotopic D D') : H D = H D' := by
  induction h with
  | rel x y hxy => exact hxy.elim (hR x y) (hD x y)
  | refl x => rfl
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Sanity: planar isotopy preserves the component count. -/
theorem PlanarIsotopic.componentCount_eq {D D' : Diagram} (h : PlanarIsotopic D D') :
    D.componentCount = D'.componentCount :=
  eq_of_planarIsotopic Diagram.componentCount (fun _ _ h => h.componentCount_eq)
    (fun _ _ h => h.componentCount_eq.symm) h

/-! ## The three Reidemeister moves

Each move is a local replacement inside a disc `U` (`LocalFrame`, `MoveMatch`) whose inside is
described by its arcs and its inner crossings.  The one-directional pattern (`RIData U D D'`: `D`
is the side without the kink) is symmetrised in the move relation (`RI D D'`: the kink is added or
removed), as in lp:lm "each actual ordinary oriented Reidemeister move" (sm-3:953-954), which is
performed in either direction (cf:lem-curl deletes a monogon, sm-3:4259-4267; ng:type-I creates a
curl, sm-3:1964). -/

/-- The data of a *Reidemeister I* site (design file: "`RI D D'`: one arc in B on each side; D's arc
crossing-free, D''s arc with exactly one self-crossing (a kink), either sign"): inside the disc `U`
the diagram `D` has exactly one arc `a` and no crossing, the diagram `D'` has exactly one arc `a'`
with the same two ends (same entering point, same exiting point) and exactly one crossing (the
kink, of either sign), and the two diagrams agree outside `U` with the components corresponding. -/
structure RIData (U : Set Plane) (D D' : Diagram) where
  frame : LocalFrame U D D'
  out : MoveMatch U D D'
  /-- the crossing-free arc of `D` inside `U` -/
  a : D.Γ.Arc
  /-- the kinked arc of `D'` inside `U` -/
  a' : D'.Γ.Arc
  cover : D.Γ.ArcCover U {a}
  cover' : D'.Γ.ArcCover U {a'}
  /-- same entering end -/
  start_eq : D'.Γ.eval a'.startPt = D.Γ.eval a.startPt
  /-- same exiting end -/
  stop_eq : D'.Γ.eval a'.stopPt = D.Γ.eval a.stopPt
  /-- `D` has no crossing inside `U` -/
  no_inner : ∀ x : D.Γ.Crossing, D.Γ.crossingPoint x ∉ interior U
  /-- the kink of `D'` -/
  kink : D'.Γ.Crossing
  /-- `D'` has exactly the kink inside `U` -/
  inner_iff' : ∀ y : D'.Γ.Crossing, D'.Γ.crossingPoint y ∈ interior U ↔ y = kink

/-- *Reidemeister move I* between two diagrams: a kink is added or removed inside some disc. -/
def RI (D D' : Diagram) : Prop := ∃ U, Nonempty (RIData U D D') ∨ Nonempty (RIData U D' D)

/-- The data of a *Reidemeister II* site (design file: "`RII D D'`: two arcs on each side, same
endpoint pairing and directions; D's arcs disjoint, D''s arcs crossing exactly twice with the SAME
over strand at both crossings"): inside `U` the diagram `D` has exactly the two disjoint arcs `a`,
`b` and no crossing; `D'` has exactly the two arcs `a'`, `b'` with the same ends as `a`, `b`
respectively (same pairing, same directions) and exactly two crossings `x₁ ≠ x₂`, each between the
two arcs, with the over occurrences of both on the same arc (cf. sm-3:1982-1984 "an empty ordinary
bigon with one common over-strand: an oriented Reidemeister-II site"). -/
structure RIIData (U : Set Plane) (D D' : Diagram) where
  frame : LocalFrame U D D'
  out : MoveMatch U D D'
  a : D.Γ.Arc
  b : D.Γ.Arc
  a' : D'.Γ.Arc
  b' : D'.Γ.Arc
  ab : a ≠ b
  ab' : a' ≠ b'
  cover : D.Γ.ArcCover U {a, b}
  cover' : D'.Γ.ArcCover U {a', b'}
  a_start : D'.Γ.eval a'.startPt = D.Γ.eval a.startPt
  a_stop : D'.Γ.eval a'.stopPt = D.Γ.eval a.stopPt
  b_start : D'.Γ.eval b'.startPt = D.Γ.eval b.startPt
  b_stop : D'.Γ.eval b'.stopPt = D.Γ.eval b.stopPt
  /-- `D`'s arcs are disjoint: no crossing inside `U` -/
  no_inner : ∀ x : D.Γ.Crossing, D.Γ.crossingPoint x ∉ interior U
  x₁ : D'.Γ.Crossing
  x₂ : D'.Γ.Crossing
  ne : x₁ ≠ x₂
  /-- `D'` has exactly the two crossings inside `U` -/
  inner_iff' : ∀ y : D'.Γ.Crossing, D'.Γ.crossingPoint y ∈ interior U ↔ y = x₁ ∨ y = x₂
  /-- both crossings are between the two arcs -/
  sep₁ : D'.Separates a' b' x₁
  sep₂ : D'.Separates a' b' x₂
  /-- the same over strand at both crossings -/
  same_over : (D'.OverOn a' x₁ ∧ D'.OverOn a' x₂) ∨ (D'.OverOn b' x₁ ∧ D'.OverOn b' x₂)

/-- *Reidemeister move II* between two diagrams: a bigon with one common over strand is created
or removed inside some disc. -/
def RII (D D' : Diagram) : Prop := ∃ U, Nonempty (RIIData U D D') ∨ Nonempty (RIIData U D' D)

/-- The data of a *Reidemeister III* site (design file: "`RIII D D'`: three arcs on each side,
pairwise crossing exactly once (a triangle) on both sides, the same over/under relation on each of
the three pairs (one strict height order), and the order of the two visits along every arc
reversed"; sm-3:1997-2003 "The three over/under choices give one strict height order, not a cyclic
order. Each physical pair crosses on both sides with the same over/under bit and transported
arrows").  The arcs are named by height: `a` (top) is over at both its crossings, `b` (middle) is
under `a` and over `c`, `c` (bottom) is under at both, on both sides; the arcs correspond by their
ends; and along each arc the two crossings are met in the opposite order on the two sides. -/
structure RIIIData (U : Set Plane) (D D' : Diagram) where
  frame : LocalFrame U D D'
  out : MoveMatch U D D'
  a : D.Γ.Arc
  b : D.Γ.Arc
  c : D.Γ.Arc
  a' : D'.Γ.Arc
  b' : D'.Γ.Arc
  c' : D'.Γ.Arc
  ab : a ≠ b
  bc : b ≠ c
  ac : a ≠ c
  ab' : a' ≠ b'
  bc' : b' ≠ c'
  ac' : a' ≠ c'
  cover : D.Γ.ArcCover U {a, b, c}
  cover' : D'.Γ.ArcCover U {a', b', c'}
  a_start : D'.Γ.eval a'.startPt = D.Γ.eval a.startPt
  a_stop : D'.Γ.eval a'.stopPt = D.Γ.eval a.stopPt
  b_start : D'.Γ.eval b'.startPt = D.Γ.eval b.startPt
  b_stop : D'.Γ.eval b'.stopPt = D.Γ.eval b.stopPt
  c_start : D'.Γ.eval c'.startPt = D.Γ.eval c.startPt
  c_stop : D'.Γ.eval c'.stopPt = D.Γ.eval c.stopPt
  /-- the three crossings of `D` inside `U`, named by the pair of arcs they join -/
  xab : D.Γ.Crossing
  xac : D.Γ.Crossing
  xbc : D.Γ.Crossing
  xab_ne_xac : xab ≠ xac
  xab_ne_xbc : xab ≠ xbc
  xac_ne_xbc : xac ≠ xbc
  inner_iff : ∀ y : D.Γ.Crossing, D.Γ.crossingPoint y ∈ interior U ↔ y = xab ∨ y = xac ∨ y = xbc
  sep_ab : D.Separates a b xab
  sep_ac : D.Separates a c xac
  sep_bc : D.Separates b c xbc
  /-- the three crossings of `D'` inside `U` -/
  xab' : D'.Γ.Crossing
  xac' : D'.Γ.Crossing
  xbc' : D'.Γ.Crossing
  xab_ne_xac' : xab' ≠ xac'
  xab_ne_xbc' : xab' ≠ xbc'
  xac_ne_xbc' : xac' ≠ xbc'
  inner_iff' : ∀ y : D'.Γ.Crossing,
    D'.Γ.crossingPoint y ∈ interior U ↔ y = xab' ∨ y = xac' ∨ y = xbc'
  sep_ab' : D'.Separates a' b' xab'
  sep_ac' : D'.Separates a' c' xac'
  sep_bc' : D'.Separates b' c' xbc'
  /-- the strict height order `a` over `b` over `c` on the `D` side ... -/
  top_ab : D.OverOn a xab
  top_ac : D.OverOn a xac
  mid_bc : D.OverOn b xbc
  /-- ... and the same over/under bits on the `D'` side -/
  top_ab' : D'.OverOn a' xab'
  top_ac' : D'.OverOn a' xac'
  mid_bc' : D'.OverOn b' xbc'
  /-- the order of the two occurrences along every arc is reversed -/
  rev_a : D.BeforeOn a xab xac ↔ D'.BeforeOn a' xac' xab'
  rev_b : D.BeforeOn b xab xbc ↔ D'.BeforeOn b' xbc' xab'
  rev_c : D.BeforeOn c xac xbc ↔ D'.BeforeOn c' xbc' xac'

/-- *Reidemeister move III* between two diagrams: a strand is moved across a crossing of two
others inside some disc, keeping the strict height order. -/
def RIII (D D' : Diagram) : Prop := ∃ U, Nonempty (RIIIData U D D') ∨ Nonempty (RIIIData U D' D)

/-! ## Oriented smoothing and skein triples -/

/-- The data of an *oriented smoothing* of `D` at its crossing `x` into `D₀` (sm-3:1084-1086:
"Oriented smoothing reconnects each incoming strand to the other strand's outgoing end. It removes
just the selected crossing and creates no other crossing in its clean disc"): a disc `U` about the
double point of `x`, inside which `D` consists exactly of the two arcs `a` (through the over
occurrence) and `b` (through the under occurrence) with `x` its only crossing, and `D₀` consists
exactly of two crossing-free arcs `a₀`, `b₀`, `a₀` running from the entering end of `a` to the
exiting end of `b` and `b₀` from the entering end of `b` to the exiting end of `a`; outside `U`
the two diagrams agree (`OutsideMatch`, no component bijection: "A self crossing splits one
parameter circle into two; a mixed crossing joins two into one", sm-3:1087-1088). -/
structure OrientedSmoothingData (U : Set Plane) (D : Diagram) (x : D.Γ.Crossing) (D₀ : Diagram) where
  frame : LocalFrame U D D₀
  /-- the disc is about the selected double point -/
  center : D.Γ.crossingPoint x ∈ interior U
  out : OutsideMatch U D D₀
  /-- the arc of `D` through the over occurrence of `x` -/
  a : D.Γ.Arc
  /-- the arc of `D` through the under occurrence of `x` -/
  b : D.Γ.Arc
  ab : a ≠ b
  cover : D.Γ.ArcCover U {a, b}
  over_on_a : D.OverOn a x
  under_on_b : D.UnderOn b x
  /-- "just the selected crossing": `x` is the only crossing of `D` inside `U` -/
  inner_iff : ∀ y : D.Γ.Crossing, D.Γ.crossingPoint y ∈ interior U ↔ y = x
  /-- the two arcs of the smoothing -/
  a₀ : D₀.Γ.Arc
  b₀ : D₀.Γ.Arc
  ab₀ : a₀ ≠ b₀
  cover₀ : D₀.Γ.ArcCover U {a₀, b₀}
  /-- "creates no other crossing in its clean disc" -/
  no_inner₀ : ∀ y : D₀.Γ.Crossing, D₀.Γ.crossingPoint y ∉ interior U
  /-- "reconnects each incoming strand to the other strand's outgoing end" -/
  a₀_start : D₀.Γ.eval a₀.startPt = D.Γ.eval a.startPt
  a₀_stop : D₀.Γ.eval a₀.stopPt = D.Γ.eval b.stopPt
  b₀_start : D₀.Γ.eval b₀.startPt = D.Γ.eval b.startPt
  b₀_stop : D₀.Γ.eval b₀.stopPt = D.Γ.eval a.stopPt

/-- `D₀` is an oriented smoothing of `D` at the crossing `x` (relational: any diagram obtained by
the disc-local reconnection of sm-3:1084-1086). -/
def IsOrientedSmoothing (D : Diagram) (x : D.Γ.Crossing) (D₀ : Diagram) : Prop :=
  ∃ U, Nonempty (OrientedSmoothingData U D x D₀)

/-- A *skein triple* `(D₊, D₋, D₀)` (lit:homfly sm-3:919-920 "for every skein triple"; lp:lm
sm-3:942-945 `l F_{D_+} + l^{-1} F_{D_-} + m F_{D_0} = 0`): a crossing `x` of `D₊` which is positive
(det(u_o, u_u) > 0, def:positive-lift), `D₋` the switch of `D₊` at `x` (sm-3:1082-1083, 1088-1089),
and `D₀` an oriented smoothing of `D₊` at `x`.  Design decision D3: `D₋` is literally the switch
(LM pp. 112-113, "identical except for a single right, left and vacuous crossing"). -/
def IsSkeinTriple (Dp Dm D0 : Diagram) : Prop :=
  ∃ x : Dp.Γ.Crossing, Dp.IsPositive x ∧ Dm = Dp.switch x ∧ IsOrientedSmoothing Dp x D0

/-! ## Link equivalence -/

/-- *Link equivalence* — "the oriented link presented by D" (lit:homfly sm-3:920-921), read per
SOURCES/INDEX.md §D as the equivalence relation generated by planar isotopy and the three
Reidemeister moves (design decision D2; Reidemeister's theorem is outside the formal scope and is
admitted as no axiom.  Since 2026-09-15 the printed descent sentence is ALSO declared spatially as the
axiom `SM.lit_homfly_descent : SM.AmbientIsotopyDescent` (SM/LitHomflyDescent.lean, the second declaration
of lit:homfly authorised by D-GAP2 — five literature interfaces, six axiom constants); that axiom is the
sentence itself, not Reidemeister's theorem, and `LinkEquiv` is unchanged). -/
def LinkEquiv : Diagram → Diagram → Prop :=
  Relation.EqvGen fun D D' => PlanarIsotopic D D' ∨ RI D D' ∨ RII D D' ∨ RIII D D'

/-- Link equivalence is an equivalence relation. -/
theorem linkEquiv_equivalence : Equivalence LinkEquiv := Relation.EqvGen.is_equivalence _

theorem LinkEquiv.refl (D : Diagram) : LinkEquiv D D := Relation.EqvGen.refl D

theorem LinkEquiv.symm {D D' : Diagram} (h : LinkEquiv D D') : LinkEquiv D' D :=
  Relation.EqvGen.symm _ _ h

theorem LinkEquiv.trans {D D' D'' : Diagram} (h : LinkEquiv D D') (h' : LinkEquiv D' D'') :
    LinkEquiv D D'' :=
  Relation.EqvGen.trans _ _ _ h h'

theorem LinkEquiv.of_planarIsotopic {D D' : Diagram} (h : PlanarIsotopic D D') : LinkEquiv D D' :=
  Relation.EqvGen.rel _ _ (Or.inl h)

theorem LinkEquiv.of_RI {D D' : Diagram} (h : RI D D') : LinkEquiv D D' :=
  Relation.EqvGen.rel _ _ (Or.inr (Or.inl h))

theorem LinkEquiv.of_RII {D D' : Diagram} (h : RII D D') : LinkEquiv D D' :=
  Relation.EqvGen.rel _ _ (Or.inr (Or.inr (Or.inl h)))

theorem LinkEquiv.of_RIII {D D' : Diagram} (h : RIII D D') : LinkEquiv D D' :=
  Relation.EqvGen.rel _ _ (Or.inr (Or.inr (Or.inr h)))

/-- The descent principle behind lit:homfly's last sentence: a function invariant under planar
isotopy and the three Reidemeister moves depends only on the link presented (the
`LinkEquiv` conjunct of `lit_homfly` follows from its four invariance conjuncts; design decision
D4/D5 `lit_homfly_descent_redundant` is this lemma applied to `homfly`). -/
theorem eq_of_linkEquiv {α : Sort*} (H : Diagram → α)
    (hP : ∀ D D', PlanarIsotopic D D' → H D = H D')
    (h1 : ∀ D D', RI D D' → H D = H D') (h2 : ∀ D D', RII D D' → H D = H D')
    (h3 : ∀ D D', RIII D D' → H D = H D') {D D' : Diagram} (h : LinkEquiv D D') : H D = H D' := by
  induction h with
  | rel x y hxy =>
    rcases hxy with hxy | hxy | hxy | hxy
    · exact hP x y hxy
    · exact h1 x y hxy
    · exact h2 x y hxy
    · exact h3 x y hxy
  | refl x => rfl
  | symm x y _ ih => exact ih.symm
  | trans x y z _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-! ## Symmetry of the moves and of the outside match -/

theorem RI.symm {D D' : Diagram} (h : RI D D') : RI D' D := by
  obtain ⟨U, h⟩ := h
  exact ⟨U, h.symm⟩

theorem RII.symm {D D' : Diagram} (h : RII D D') : RII D' D := by
  obtain ⟨U, h⟩ := h
  exact ⟨U, h.symm⟩

theorem RIII.symm {D D' : Diagram} (h : RIII D D') : RIII D' D := by
  obtain ⟨U, h⟩ := h
  exact ⟨U, h.symm⟩

namespace OutsideMatch

variable {U : Set Plane} {D D' : Diagram} (m : OutsideMatch U D D')

theorem eval_symm (q : D'.Γ.Outside U) : D.Γ.eval (m.φ.symm q).1 = D'.Γ.eval q.1 := by
  have h := m.eval_eq (m.φ.symm q)
  rw [Equiv.apply_symm_apply] at h
  exact h.symm

theorem over_symm (y : D'.OuterCrossing U) :
    m.φ.symm (D'.outerOverPt y) = D.outerOverPt (m.ψ.symm y) := by
  rw [Equiv.symm_apply_eq, m.over_eq, Equiv.apply_symm_apply]

theorem under_symm (y : D'.OuterCrossing U) :
    m.φ.symm (D'.outerUnderPt y) = D.outerUnderPt (m.ψ.symm y) := by
  rw [Equiv.symm_apply_eq, m.under_eq, Equiv.apply_symm_apply]

/-- The outside match read backwards. -/
def symm : OutsideMatch U D' D where
  φ := m.φ.symm
  eval_eq := m.eval_symm
  dir_pos := fun q hq => by
    obtain ⟨l, hl, h⟩ := m.dir_pos (m.φ.symm q) (by rw [m.eval_symm q]; exact hq)
    rw [Equiv.apply_symm_apply] at h
    refine ⟨l⁻¹, inv_pos.mpr hl, ?_⟩
    rw [h, smul_smul, inv_mul_cancel₀ hl.ne', one_smul]
  dir_pos_before := fun q hq => by
    obtain ⟨l, hl, h⟩ := m.dir_pos_before (m.φ.symm q) (by rw [m.eval_symm q]; exact hq)
    rw [Equiv.apply_symm_apply] at h
    refine ⟨l⁻¹, inv_pos.mpr hl, ?_⟩
    rw [h, smul_smul, inv_mul_cancel₀ hl.ne', one_smul]
  ψ := m.ψ.symm
  over_eq := m.over_symm
  under_eq := m.under_symm

/-- Sanity: the outer crossings correspond bijectively. -/
theorem card_outer_eq (m : OutsideMatch U D D') :
    Fintype.card (D.OuterCrossing U) = Fintype.card (D'.OuterCrossing U) :=
  Fintype.card_congr m.ψ

end OutsideMatch

theorem AgreeOutside.symm {U : Set Plane} {D D' : Diagram} (h : AgreeOutside U D D') :
    AgreeOutside U D' D :=
  h.elim fun m => ⟨m.symm⟩

/-- Sanity (`Clean`): no crossing point lies on the frontier of the region — its two occurrences
are distinct traversal points with the same plane point. -/
theorem Clean.crossingPoint_not_mem_frontier {U : Set Plane} {D : Diagram} (h : Clean U D)
    (x : D.Γ.Crossing) : D.Γ.crossingPoint x ∉ frontier U := by
  intro hx
  apply D.overVisit_ne_underVisit x
  apply D.visitPt_injective
  apply h.frontier_injOn
  · show D.Γ.eval (D.visitPt (D.overVisit x)) ∈ frontier U
    rw [D.eval_visitPt]; exact hx
  · show D.Γ.eval (D.visitPt (D.underVisit x)) ∈ frontier U
    rw [D.eval_visitPt]; exact hx
  · rw [D.eval_visitPt, D.eval_visitPt]
    rfl

/-! ## Sanity counts: crossings and components -/

namespace Diagram

variable (D : Diagram)

theorem card_inner_eq_zero {U : Set Plane}
    (h : ∀ x : D.Γ.Crossing, D.Γ.crossingPoint x ∉ interior U) :
    Fintype.card (D.InnerCrossing U) = 0 :=
  Fintype.card_eq_zero_iff.mpr ⟨fun x => h x.1 x.2⟩

theorem card_inner_eq_one {U : Set Plane} (x₀ : D.Γ.Crossing)
    (h : ∀ y : D.Γ.Crossing, D.Γ.crossingPoint y ∈ interior U ↔ y = x₀) :
    Fintype.card (D.InnerCrossing U) = 1 := by
  classical
  rw [Fintype.card_eq_one_iff]
  refine ⟨⟨x₀, (h x₀).mpr rfl⟩, fun y => Subtype.ext ((h y.1).mp y.2)⟩

theorem card_inner_eq_two {U : Set Plane} (x₁ x₂ : D.Γ.Crossing) (hne : x₁ ≠ x₂)
    (h : ∀ y : D.Γ.Crossing, D.Γ.crossingPoint y ∈ interior U ↔ y = x₁ ∨ y = x₂) :
    Fintype.card (D.InnerCrossing U) = 2 := by
  classical
  have : Fintype.card (D.InnerCrossing U) = Fintype.card {y : D.Γ.Crossing // y = x₁ ∨ y = x₂} :=
    Fintype.card_congr (Equiv.subtypeEquivRight h)
  rw [this, Fintype.card_subtype]
  have hs : ({y : D.Γ.Crossing | y = x₁ ∨ y = x₂} : Finset D.Γ.Crossing) = {x₁, x₂} := by
    ext y; simp
  rw [hs, Finset.card_pair hne]

theorem card_inner_eq_three {U : Set Plane} (x₁ x₂ x₃ : D.Γ.Crossing) (h12 : x₁ ≠ x₂)
    (h13 : x₁ ≠ x₃) (h23 : x₂ ≠ x₃)
    (h : ∀ y : D.Γ.Crossing, D.Γ.crossingPoint y ∈ interior U ↔ y = x₁ ∨ y = x₂ ∨ y = x₃) :
    Fintype.card (D.InnerCrossing U) = 3 := by
  classical
  have : Fintype.card (D.InnerCrossing U) =
      Fintype.card {y : D.Γ.Crossing // y = x₁ ∨ y = x₂ ∨ y = x₃} :=
    Fintype.card_congr (Equiv.subtypeEquivRight h)
  rw [this, Fintype.card_subtype]
  have hs : ({y : D.Γ.Crossing | y = x₁ ∨ y = x₂ ∨ y = x₃} : Finset D.Γ.Crossing) =
      {x₁, x₂, x₃} := by
    ext y; simp
  rw [hs, Finset.card_insert_of_notMem (by simp [h12, h13]), Finset.card_pair h23]

end Diagram

namespace MoveMatch

variable {U : Set Plane} {D D' : Diagram}

/-- Sanity: a move keeps the component count. -/
theorem componentCount_eq (m : MoveMatch U D D') : D'.componentCount = D.componentCount := by
  show D'.Γ.c = D.Γ.c
  simpa using (Fintype.card_congr m.e).symm

end MoveMatch

namespace RIData

variable {U : Set Plane} {D D' : Diagram}

/-- Sanity count (design decision D3 / fidelity risk 2): a Reidemeister I site changes the crossing
number by one. -/
theorem card_crossing (h : RIData U D D') : Fintype.card D'.Γ.Crossing = Fintype.card D.Γ.Crossing + 1 := by
  rw [D'.card_crossing_eq_inner_add_outer U, D.card_crossing_eq_inner_add_outer U,
    D'.card_inner_eq_one h.kink h.inner_iff', D.card_inner_eq_zero h.no_inner,
    h.out.toOutsideMatch.card_outer_eq]
  ring

theorem componentCount_eq (h : RIData U D D') : D'.componentCount = D.componentCount :=
  h.out.componentCount_eq

end RIData

namespace RIIData

variable {U : Set Plane} {D D' : Diagram}

/-- Sanity count: a Reidemeister II site changes the crossing number by two. -/
theorem card_crossing (h : RIIData U D D') : Fintype.card D'.Γ.Crossing = Fintype.card D.Γ.Crossing + 2 := by
  rw [D'.card_crossing_eq_inner_add_outer U, D.card_crossing_eq_inner_add_outer U,
    D'.card_inner_eq_two h.x₁ h.x₂ h.ne h.inner_iff', D.card_inner_eq_zero h.no_inner,
    h.out.toOutsideMatch.card_outer_eq]
  ring

theorem componentCount_eq (h : RIIData U D D') : D'.componentCount = D.componentCount :=
  h.out.componentCount_eq

end RIIData

namespace RIIIData

variable {U : Set Plane} {D D' : Diagram}

/-- Sanity count: a Reidemeister III site keeps the crossing number. -/
theorem card_crossing (h : RIIIData U D D') : Fintype.card D'.Γ.Crossing = Fintype.card D.Γ.Crossing := by
  rw [D'.card_crossing_eq_inner_add_outer U, D.card_crossing_eq_inner_add_outer U,
    D'.card_inner_eq_three h.xab' h.xac' h.xbc' h.xab_ne_xac' h.xab_ne_xbc' h.xac_ne_xbc'
      h.inner_iff',
    D.card_inner_eq_three h.xab h.xac h.xbc h.xab_ne_xac h.xab_ne_xbc h.xac_ne_xbc h.inner_iff,
    h.out.toOutsideMatch.card_outer_eq]

theorem componentCount_eq (h : RIIIData U D D') : D'.componentCount = D.componentCount :=
  h.out.componentCount_eq

end RIIIData

/-- Sanity count: Reidemeister I changes the crossing number by ±1. -/
theorem RI.card_crossing {D D' : Diagram} (h : RI D D') :
    Fintype.card D'.Γ.Crossing = Fintype.card D.Γ.Crossing + 1 ∨
      Fintype.card D.Γ.Crossing = Fintype.card D'.Γ.Crossing + 1 := by
  obtain ⟨U, h | h⟩ := h
  · exact Or.inl h.some.card_crossing
  · exact Or.inr h.some.card_crossing

/-- Sanity count: Reidemeister II changes the crossing number by ±2. -/
theorem RII.card_crossing {D D' : Diagram} (h : RII D D') :
    Fintype.card D'.Γ.Crossing = Fintype.card D.Γ.Crossing + 2 ∨
      Fintype.card D.Γ.Crossing = Fintype.card D'.Γ.Crossing + 2 := by
  obtain ⟨U, h | h⟩ := h
  · exact Or.inl h.some.card_crossing
  · exact Or.inr h.some.card_crossing

/-- Sanity count: Reidemeister III keeps the crossing number. -/
theorem RIII.card_crossing {D D' : Diagram} (h : RIII D D') :
    Fintype.card D'.Γ.Crossing = Fintype.card D.Γ.Crossing := by
  obtain ⟨U, h | h⟩ := h
  · exact h.some.card_crossing
  · exact h.some.card_crossing.symm

/-- Sanity: the three moves keep the component count. -/
theorem RI.componentCount_eq {D D' : Diagram} (h : RI D D') :
    D'.componentCount = D.componentCount := by
  obtain ⟨U, h | h⟩ := h
  · exact h.some.componentCount_eq
  · exact h.some.componentCount_eq.symm

theorem RII.componentCount_eq {D D' : Diagram} (h : RII D D') :
    D'.componentCount = D.componentCount := by
  obtain ⟨U, h | h⟩ := h
  · exact h.some.componentCount_eq
  · exact h.some.componentCount_eq.symm

theorem RIII.componentCount_eq {D D' : Diagram} (h : RIII D D') :
    D'.componentCount = D.componentCount := by
  obtain ⟨U, h | h⟩ := h
  · exact h.some.componentCount_eq
  · exact h.some.componentCount_eq.symm

/-- Sanity: link equivalence keeps the component count (as every generator does). -/
theorem LinkEquiv.componentCount_eq {D D' : Diagram} (h : LinkEquiv D D') :
    D.componentCount = D'.componentCount :=
  eq_of_linkEquiv Diagram.componentCount (fun _ _ h => h.componentCount_eq)
    (fun _ _ h => h.componentCount_eq.symm) (fun _ _ h => h.componentCount_eq.symm)
    (fun _ _ h => h.componentCount_eq.symm) h

namespace OrientedSmoothingData

variable {U : Set Plane} {D : Diagram} {x : D.Γ.Crossing} {D₀ : Diagram}

/-- Sanity count (sm-3:1102 "Its crossing count is N−1"). -/
theorem card_crossing (h : OrientedSmoothingData U D x D₀) :
    Fintype.card D₀.Γ.Crossing + 1 = Fintype.card D.Γ.Crossing := by
  rw [D₀.card_crossing_eq_inner_add_outer U, D.card_crossing_eq_inner_add_outer U,
    D₀.card_inner_eq_zero h.no_inner₀, D.card_inner_eq_one x h.inner_iff,
    h.out.card_outer_eq]
  ring

end OrientedSmoothingData

/-- Sanity count: an oriented smoothing has one crossing fewer (sm-3:1102). -/
theorem IsOrientedSmoothing.card_crossing {D : Diagram} {x : D.Γ.Crossing} {D₀ : Diagram}
    (h : IsOrientedSmoothing D x D₀) :
    Fintype.card D₀.Γ.Crossing + 1 = Fintype.card D.Γ.Crossing := by
  obtain ⟨U, h⟩ := h
  exact h.some.card_crossing

theorem IsSkeinTriple.card_crossing_zero {Dp Dm D0 : Diagram} (h : IsSkeinTriple Dp Dm D0) :
    Fintype.card D0.Γ.Crossing + 1 = Fintype.card Dp.Γ.Crossing := by
  obtain ⟨x, -, -, h⟩ := h
  exact h.card_crossing

/-- Sanity: `D₋` has the same shadow, hence the same crossings and components, as `D₊`. -/
theorem IsSkeinTriple.Γ_minus_eq {Dp Dm D0 : Diagram} (h : IsSkeinTriple Dp Dm D0) :
    Dm.Γ = Dp.Γ := by
  obtain ⟨x, -, rfl, -⟩ := h
  rfl

theorem IsSkeinTriple.componentCount_minus {Dp Dm D0 : Diagram} (h : IsSkeinTriple Dp Dm D0) :
    Dm.componentCount = Dp.componentCount := by
  obtain ⟨x, -, rfl, -⟩ := h
  rfl

/-- Sanity (sm-3:1088-1089 "Its chosen crossing sign is negated"): in a skein triple the writhe of
`D₋` is that of `D₊` minus two. -/
theorem IsSkeinTriple.writhe_minus {Dp Dm D0 : Diagram} (h : IsSkeinTriple Dp Dm D0) :
    Dm.writhe = Dp.writhe - 2 := by
  obtain ⟨x, hx, rfl, -⟩ := h
  rw [Dp.switch_writhe x, (Dp.isPositive_iff_sign_eq_one x).mp hx]
  simp

/-! ## Two further disc-local relations used by the consumers -/

/-- lp:split-circle (sm-3:1181-1185): "Let D' be the actual diagram formed from D by adding one
simple crossing-free component having no crossings with D. It may surround some components of D;
it need not lie in the unbounded complementary face."  Rendered as: some component `j` of `D'`
carries no crossing occurrence, and the restriction of `D'` to the other components is a
reparametrization of `D` (nothing is said about nesting). -/
def IsSplitCircleAddition (D D' : Diagram) : Prop :=
  ∃ j : Fin D'.Γ.c, (∀ x : D'.Γ.Crossing, ∀ s ∈ x.val, s.1 ≠ j) ∧
    ∃ hne : (Finset.univ.erase j).Nonempty, Reparam D (D'.restrict (Finset.univ.erase j) hne)

/-- Sanity: adding a split circle raises the component count by one. -/
theorem IsSplitCircleAddition.componentCount {D D' : Diagram} (h : IsSplitCircleAddition D D') :
    D'.componentCount = D.componentCount + 1 := by
  obtain ⟨j, -, hne, hr⟩ := h
  have h1 := hr.componentCount_eq
  rw [Diagram.restrict_componentCount, Finset.card_erase_of_mem (Finset.mem_univ j),
    Finset.card_univ, Fintype.card_fin] at h1
  have := D'.Γ.hc
  unfold Diagram.componentCount at *
  omega

/-- mp:join (sm-3:1367-1369): "a specified closed nonsingular oriented interval I on one
component; I contains no crossing and is contained in a clean disc".  Rendered as: the arc `a`
carries no crossing occurrence, and there is a disc `U` in which the diagram consists exactly of
`a` (with the ends of `a` on `∂U`). -/
def IsMarkedInterval (D : Diagram) (a : D.Γ.Arc) : Prop :=
  (∀ v : D.Γ.Visit, ¬ a.Mem (D.visitPt v)) ∧
    ∃ U, IsDisc U ∧ Clean U D ∧ D.Γ.ArcCover U {a}

/-! ## Record clauses, parameterised by the record map

`Diagram.record` is written in the parallel module `LinkDiagramRecord`; the two bridge clauses of
the design (section record_type: "`record (switch D x) = (record D).switch x` (definitional up to
iso) and `IsOrientedSmoothing D x D₀ → RecordIso (record D₀) ((record D).smooth x)`") are stated
here for an arbitrary record map `rec` with an occurrence map `toM`, to be instantiated with
`Diagram.record` and the identity on `Γ.Visit`. -/

/-- The record clause of the switch: the record of `D^{sw}` is isomorphic to the record of `D`
switched at the over occurrence of `x`. -/
def SwitchRecordClause (rec : Diagram → Record) (toM : ∀ D : Diagram, D.Γ.Visit → (rec D).M)
    (D : Diagram) (x : D.Γ.Crossing) : Prop :=
  Nonempty (RecordIso (rec (D.switch x)) ((rec D).switch (toM D (D.overVisit x))))

/-- The record clause of the oriented smoothing: the record of `D₀` is isomorphic to the record of
`D` smoothed at the over occurrence of `x` (sm-3:1090-1096, the cycle rewriting
`(x A y B) ↦ (x B), (y A)` and `(x A), (y B) ↦ (x B y A)`). -/
def SmoothingRecordClause (rec : Diagram → Record) (toM : ∀ D : Diagram, D.Γ.Visit → (rec D).M)
    (D : Diagram) (x : D.Γ.Crossing) (D₀ : Diagram) : Prop :=
  Nonempty (RecordIso (rec D₀) ((rec D).smooth (toM D (D.overVisit x))))

/-! ## Transport statements: reversal and mirror -/

/-- `R` is carried to itself by the mirror image (`Diagram.mirror`). -/
def MirrorCarries (R : Diagram → Diagram → Prop) : Prop :=
  ∀ D D', R D D' → R D.mirror D'.mirror

/-- `R` is carried to itself by reversal of every component (`Diagram.reverse`). -/
def ReverseCarries (R : Diagram → Diagram → Prop) : Prop :=
  ∀ D D', R D D' → R D.reverse D'.reverse

/-- Generators carried ⇒ the generated equivalence carried. -/
theorem eqvGen_carries (f : Diagram → Diagram) (r : Diagram → Diagram → Prop)
    (hr : ∀ D D', r D D' → r (f D) (f D')) {D D' : Diagram} (h : Relation.EqvGen r D D') :
    Relation.EqvGen r (f D) (f D') := by
  induction h with
  | rel x y hxy => exact Relation.EqvGen.rel _ _ (hr x y hxy)
  | refl x => exact Relation.EqvGen.refl _
  | symm x y _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans x y z _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

theorem mirrorCarries_planarIsotopic_of (hR : MirrorCarries Reparam) (hD : MirrorCarries Deform) :
    MirrorCarries PlanarIsotopic := fun _ _ h =>
  eqvGen_carries Diagram.mirror _ (fun E E' hEE' => hEE'.elim (fun h => Or.inl (hR E E' h))
    (fun h => Or.inr (hD E E' h))) h

theorem reverseCarries_planarIsotopic_of (hR : ReverseCarries Reparam)
    (hD : ReverseCarries Deform) : ReverseCarries PlanarIsotopic := fun _ _ h =>
  eqvGen_carries Diagram.reverse _ (fun E E' hEE' => hEE'.elim (fun h => Or.inl (hR E E' h))
    (fun h => Or.inr (hD E E' h))) h

theorem mirrorCarries_linkEquiv_of (hP : MirrorCarries PlanarIsotopic) (h1 : MirrorCarries RI)
    (h2 : MirrorCarries RII) (h3 : MirrorCarries RIII) : MirrorCarries LinkEquiv := fun _ _ h =>
  eqvGen_carries Diagram.mirror _ (fun E E' hEE' => by
    rcases hEE' with hEE' | hEE' | hEE' | hEE'
    · exact Or.inl (hP E E' hEE')
    · exact Or.inr (Or.inl (h1 E E' hEE'))
    · exact Or.inr (Or.inr (Or.inl (h2 E E' hEE')))
    · exact Or.inr (Or.inr (Or.inr (h3 E E' hEE')))) h

theorem reverseCarries_linkEquiv_of (hP : ReverseCarries PlanarIsotopic) (h1 : ReverseCarries RI)
    (h2 : ReverseCarries RII) (h3 : ReverseCarries RIII) : ReverseCarries LinkEquiv :=
  fun _ _ h =>
  eqvGen_carries Diagram.reverse _ (fun E E' hEE' => by
    rcases hEE' with hEE' | hEE' | hEE' | hEE'
    · exact Or.inl (hP E E' hEE')
    · exact Or.inr (Or.inl (h1 E E' hEE'))
    · exact Or.inr (Or.inr (Or.inl (h2 E E' hEE')))
    · exact Or.inr (Or.inr (Or.inr (h3 E E' hEE')))) h

/-! ## Mirror transport, part 1: the mirror image at the level of shadows, visits and traversal points

`Diagram.mirror` (LinkDiagram) keeps every label: the strands, crossings (as strand pairs),
visits and traversal points of `D.mirror` are those of `D`, and every plane point is reflected.
The lemmas below make this explicit; they are typed on `D.mirror.Γ` so that they rewrite. -/

theorem continuous_reflect : Continuous reflect := continuous_fst.prodMk continuous_snd.neg

/-- The reflection `(x, y) ↦ (x, −y)` as a homeomorphism of the plane. -/
def reflectHomeo : Plane ≃ₜ Plane where
  toFun := reflect
  invFun := reflect
  left_inv := reflect_reflect
  right_inv := reflect_reflect
  continuous_toFun := continuous_reflect
  continuous_invFun := continuous_reflect

@[simp] theorem reflectHomeo_apply (p : Plane) : reflectHomeo p = reflect p := rfl

theorem reflect_mem_image_iff {S : Set Plane} {p : Plane} : reflect p ∈ reflect '' S ↔ p ∈ S :=
  reflect_injective.mem_set_image

theorem interior_reflect_image (U : Set Plane) : interior (reflect '' U) = reflect '' interior U :=
  (reflectHomeo.image_interior U).symm

theorem frontier_reflect_image (U : Set Plane) : frontier (reflect '' U) = reflect '' frontier U :=
  (reflectHomeo.image_frontier U).symm

theorem reflect_mem_interior_image_iff {U : Set Plane} {p : Plane} :
    reflect p ∈ interior (reflect '' U) ↔ p ∈ interior U := by
  rw [interior_reflect_image, reflect_mem_image_iff]

theorem reflect_mem_frontier_image_iff {U : Set Plane} {p : Plane} :
    reflect p ∈ frontier (reflect '' U) ↔ p ∈ frontier U := by
  rw [frontier_reflect_image, reflect_mem_image_iff]

/-- Sanity: the reflection of a disc is a disc. -/
theorem IsDisc.reflect_image {U : Set Plane} (h : IsDisc U) : IsDisc (reflect '' U) := by
  obtain ⟨hc, hk, hi⟩ := h
  refine ⟨?_, hk.image continuous_reflect, ?_⟩
  · rintro _ ⟨p, hp, rfl⟩ _ ⟨q, hq, rfl⟩ a b ha hb hab
    exact ⟨a • p + b • q, hc hp hq ha hb hab, by rw [reflect_add, reflect_smul, reflect_smul]⟩
  · rw [interior_reflect_image]
    exact hi.image _

namespace Shadow

variable (Γ : Shadow)

theorem mirror_generic {Γ : Shadow} (h : Γ.Generic) : Γ.mirrorShadow.Generic :=
  Γ.mirrorMap.generic_pullback h fun i => regular_reflect (h.regular i)

theorem map_mirrorMap_emb (x : Finset Γ.mirrorShadow.Strand) : x.map Γ.mirrorMap.emb = x := by
  ext s
  rw [Finset.mem_map]
  constructor
  · rintro ⟨a, ha, rfl⟩; exact ha
  · intro hs; exact ⟨s, hs, rfl⟩

/-- Sanity: the mirror shadow has literally the same crossing pairs. -/
theorem mirror_isCrossing_iff (x : Finset Γ.Strand) :
    Γ.mirrorShadow.IsCrossing x ↔ Γ.IsCrossing x := by
  rw [← Γ.mirrorMap.isCrossing_map_iff, map_mirrorMap_emb]

theorem mirror_eval (p : Γ.Pt) : Γ.mirrorShadow.eval p = reflect (Γ.eval p) := by
  obtain ⟨i, j, t⟩ := p
  exact edgePoint_reflect _ _ _

theorem mirror_dir (s : Γ.Strand) : Γ.mirrorShadow.dir s = reflect (Γ.dir s) := edge_reflect _ _

theorem mirror_crossingPoint (hΓ : Γ.Generic) (x : Γ.mirrorShadow.Crossing) :
    Γ.mirrorShadow.crossingPoint x = reflect (Γ.crossingPoint (Γ.mirrorCrossingEquiv x)) := by
  rw [mirrorCrossingEquiv_apply, Γ.mirrorMap.crossingPoint_mapCrossing hΓ]
  exact (reflect_reflect _).symm

/-- Edges of a generic shadow are nonzero (accepted `Regular`). -/
theorem edge_ne_zero (hΓ : Γ.Generic) (s : Γ.Strand) : Γ.dir s ≠ 0 :=
  ((regular_iff_edges _).mp (hΓ.regular s.1) s.2).1

end Shadow

namespace Diagram

variable (D : Diagram)

@[simp] theorem mirror_Γ : D.mirror.Γ = D.Γ.mirrorShadow := rfl

/-- The crossings of the mirror image are those of `D` (same strand pairs), typed on `D.mirror`. -/
def mirrorCrossing : D.mirror.Γ.Crossing ≃ D.Γ.Crossing := D.Γ.mirrorCrossingEquiv

theorem mirrorCrossing_val (x : D.mirror.Γ.Crossing) : (D.mirrorCrossing x).val = x.val :=
  D.Γ.mirrorCrossingEquiv_val x

theorem mem_mirrorCrossing {x : D.mirror.Γ.Crossing} {s : D.mirror.Γ.Strand} (hs : s ∈ x.val) :
    s ∈ (D.mirrorCrossing x).val := by
  rw [D.mirrorCrossing_val x]; exact hs

theorem mem_of_mem_mirrorCrossing {x : D.mirror.Γ.Crossing} {s : D.mirror.Γ.Strand}
    (hs : s ∈ (D.mirrorCrossing x).val) : s ∈ x.val := by
  rw [D.mirrorCrossing_val x] at hs; exact hs

/-- Sanity: the over data is kept by the mirror image. -/
theorem mirror_overStrand_mv (x : D.mirror.Γ.Crossing) :
    D.mirror.overStrand x = D.overStrand (D.mirrorCrossing x) :=
  toFun_pullback_overStrand D D.Γ.mirrorMap (fun i => regular_reflect (D.generic.regular i)) x

theorem mirror_underStrand_mv (x : D.mirror.Γ.Crossing) :
    D.mirror.underStrand x = D.underStrand (D.mirrorCrossing x) :=
  toFun_pullback_underStrand D D.Γ.mirrorMap (fun i => regular_reflect (D.generic.regular i)) x

/-- The visits of the mirror image are those of `D`. -/
def mirrorVisit : D.mirror.Γ.Visit ≃ D.Γ.Visit :=
  Equiv.sigmaCongr D.mirrorCrossing fun _ =>
    Equiv.subtypeEquivRight fun _ => ⟨D.mem_mirrorCrossing, D.mem_of_mem_mirrorCrossing⟩

@[simp] theorem mirrorVisit_fst (v : D.mirror.Γ.Visit) :
    (D.mirrorVisit v).1 = D.mirrorCrossing v.1 := rfl

@[simp] theorem mirrorVisit_snd (v : D.mirror.Γ.Visit) : (D.mirrorVisit v).2.1 = v.2.1 := rfl

theorem mirrorVisit_symm_fst (v : D.Γ.Visit) :
    (D.mirrorVisit.symm v).1 = D.mirrorCrossing.symm v.1 := by
  apply D.mirrorCrossing.injective
  rw [Equiv.apply_symm_apply, ← mirrorVisit_fst, Equiv.apply_symm_apply]

theorem mirrorVisit_overVisit (x : D.mirror.Γ.Crossing) :
    D.mirrorVisit (D.mirror.overVisit x) = D.overVisit (D.mirrorCrossing x) := by
  refine Sigma.ext rfl ?_
  exact heq_of_eq (Subtype.ext (D.mirror_overStrand_mv x))

theorem mirrorVisit_underVisit (x : D.mirror.Γ.Crossing) :
    D.mirrorVisit (D.mirror.underVisit x) = D.underVisit (D.mirrorCrossing x) := by
  refine Sigma.ext rfl ?_
  exact heq_of_eq (Subtype.ext (D.mirror_underStrand_mv x))

theorem mirror_eval (p : D.mirror.Γ.Pt) : D.mirror.Γ.eval p = reflect (D.Γ.eval p) :=
  D.Γ.mirror_eval p

theorem mirror_dir (s : D.mirror.Γ.Strand) : D.mirror.Γ.dir s = reflect (D.Γ.dir s) :=
  D.Γ.mirror_dir s

theorem mirror_crossingPoint (x : D.mirror.Γ.Crossing) :
    D.mirror.Γ.crossingPoint x = reflect (D.Γ.crossingPoint (D.mirrorCrossing x)) :=
  D.Γ.mirror_crossingPoint D.generic x

theorem mirror_crossingParam (x : D.mirror.Γ.Crossing) {s : D.mirror.Γ.Strand} (hs : s ∈ x.val) :
    D.mirror.crossingParam x hs = D.crossingParam (D.mirrorCrossing x) (D.mem_mirrorCrossing hs) := by
  have h1 := (D.mirror.crossingParam_spec x hs).2.2
  have h2 := (D.crossingParam_spec (D.mirrorCrossing x) (D.mem_mirrorCrossing hs)).2.2
  have h3 : reflect (edgePoint (D.Γ.comp s.1).P s.2
        (D.crossingParam (D.mirrorCrossing x) (D.mem_mirrorCrossing hs))) =
      reflect (edgePoint (D.Γ.comp s.1).P s.2 (D.mirror.crossingParam x hs)) :=
    (congrArg reflect h2).symm.trans
      ((D.mirror_crossingPoint x).symm.trans (h1.trans (edgePoint_reflect _ _ _)))
  exact (edgePoint_injective (D.Γ.edge_ne_zero D.generic s) (reflect_injective h3)).symm

/-- Sanity: the traversal point of a visit is kept by the mirror image. -/
theorem visitPt_of_mirror (v : D.mirror.Γ.Visit) :
    D.mirror.visitPt v = D.visitPt (D.mirrorVisit v) := by
  unfold visitPt
  exact Sigma.ext rfl (heq_of_eq (Prod.ext rfl (Subtype.ext (D.mirror_crossingParam v.1 v.2.2))))

theorem mirror_visitPt_overVisit (x : D.mirror.Γ.Crossing) :
    D.mirror.visitPt (D.mirror.overVisit x) = D.visitPt (D.overVisit (D.mirrorCrossing x)) := by
  rw [visitPt_of_mirror, mirrorVisit_overVisit]

theorem mirror_visitPt_underVisit (x : D.mirror.Γ.Crossing) :
    D.mirror.visitPt (D.mirror.underVisit x) = D.visitPt (D.underVisit (D.mirrorCrossing x)) := by
  rw [visitPt_of_mirror, mirrorVisit_underVisit]

theorem mirror_visitPt_overVisit_symm (x : D.Γ.Crossing) :
    D.mirror.visitPt (D.mirror.overVisit (D.mirrorCrossing.symm x)) =
      D.visitPt (D.overVisit x) := by
  rw [mirror_visitPt_overVisit, Equiv.apply_symm_apply]

theorem mirror_visitPt_underVisit_symm (x : D.Γ.Crossing) :
    D.mirror.visitPt (D.mirror.underVisit (D.mirrorCrossing.symm x)) =
      D.visitPt (D.underVisit x) := by
  rw [mirror_visitPt_underVisit, Equiv.apply_symm_apply]

/-- Two diagrams on one shadow with the same over strands are equal. -/
theorem mk_eq_of_overStrand_eq {Γ : Shadow} {g₁ g₂ : Γ.Generic} {o₁ o₂ : Γ.Crossing → Γ.Strand}
    {h₁ : ∀ x, o₁ x ∈ x.val} {h₂ : ∀ x, o₂ x ∈ x.val} (h : o₁ = o₂) :
    (Diagram.mk Γ g₁ o₁ h₁ : Diagram) = Diagram.mk Γ g₂ o₂ h₂ := by
  subst h; rfl

/-- Sanity: mirror and generic re-vertexing commute. -/
theorem mirror_deform (V : D.Γ.Vertices) (hgen : (D.Γ.withVertices V).Generic)
    (hcross : ∀ x : Finset D.Γ.Strand, (D.Γ.withVertices V).IsCrossing x ↔ D.Γ.IsCrossing x)
    (hgen' : (D.mirror.Γ.withVertices (fun i => reflect ∘ V i)).Generic)
    (hcross' : ∀ x : Finset D.mirror.Γ.Strand,
      (D.mirror.Γ.withVertices (fun i => reflect ∘ V i)).IsCrossing x ↔ D.mirror.Γ.IsCrossing x) :
    (D.deform V hgen hcross).mirror = D.mirror.deform (fun i => reflect ∘ V i) hgen' hcross' := by
  apply mk_eq_of_overStrand_eq
  funext x
  have e1 : (D.deform V hgen hcross).mirror.overStrand x =
      D.overStrand ⟨((D.deform V hgen hcross).mirrorCrossing x).val, _⟩ :=
    (D.deform V hgen hcross).mirror_overStrand_mv x
  have e2 : D.mirror.overStrand ⟨x.val, (hcross' x.val).mp x.2⟩ =
      D.overStrand (D.mirrorCrossing ⟨x.val, (hcross' x.val).mp x.2⟩) :=
    D.mirror_overStrand_mv _
  refine e1.trans ((congrArg D.overStrand (Subtype.ext ?_)).trans e2.symm)
  exact ((D.deform V hgen hcross).mirrorCrossing_val x).trans
    (D.mirrorCrossing_val ⟨x.val, (hcross' x.val).mp x.2⟩).symm

end Diagram

/-! ## Mirror transport, part 2: reparametrizations, deformations, planar isotopy -/

/-- The mirror image of a reparametrization (same `e`, same `φ`). -/
def ReparamData.mirror {D D' : Diagram} (r : ReparamData D D') :
    ReparamData D.mirror D'.mirror where
  e := r.e
  φ := r.φ
  between := r.between
  eval_eq := fun i p =>
    (D'.mirror_eval ⟨r.e i, r.φ i p⟩).trans
      ((congrArg reflect (r.eval_eq i p)).trans (D.mirror_eval ⟨i, p⟩).symm)
  over_map := fun x => by
    obtain ⟨x', hx'⟩ := r.over_map (D.mirrorCrossing x)
    exact ⟨D'.mirrorCrossing.symm x', (congrArg r.mapPt (D.mirror_visitPt_overVisit x)).trans
      (hx'.trans (D'.mirror_visitPt_overVisit_symm x').symm)⟩
  over_surj := fun x' => by
    obtain ⟨x, hx⟩ := r.over_surj (D'.mirrorCrossing x')
    exact ⟨D.mirrorCrossing.symm x, (congrArg r.mapPt (D.mirror_visitPt_overVisit_symm x)).trans
      (hx.trans (D'.mirror_visitPt_overVisit x').symm)⟩

/-- The mirror image carries reparametrizations to reparametrizations. -/
theorem mirrorCarries_reparam : MirrorCarries Reparam := fun _ _ h => h.elim fun r => ⟨r.mirror⟩

/-- The mirror image of a generic deformation (every vertex path reflected). -/
def DeformData.mirror {D D' : Diagram} (d : DeformData D D') : DeformData D.mirror D'.mirror := by
  obtain ⟨γ, cont, start, gen, cross, rfl⟩ := d
  exact
    { γ := fun t i => reflect ∘ γ t i
      continuous := fun i j => continuous_reflect.comp_continuousOn (cont i j)
      start := funext fun i => by
        show reflect ∘ γ 0 i = reflect ∘ (D.Γ.comp i).P
        rw [start]; rfl
      generic := fun t ht => Shadow.mirror_generic (gen t ht)
      crossings := fun t ht x =>
        ((D.Γ.withVertices (γ t)).mirror_isCrossing_iff x).trans
          ((cross t ht x).trans (D.Γ.mirror_isCrossing_iff x).symm)
      stop := D.mirror_deform (γ 1) _ _ _ _ }

/-- The mirror image carries generic deformations to generic deformations. -/
theorem mirrorCarries_deform : MirrorCarries Deform := fun _ _ h => h.elim fun d => ⟨d.mirror⟩

/-- The mirror image carries planar isotopy to planar isotopy (design decision D2, reviewer check
"reversal and mirror carry generators to generators", mirror half). -/
theorem mirrorCarries_planarIsotopic : MirrorCarries PlanarIsotopic :=
  mirrorCarries_planarIsotopic_of mirrorCarries_reparam mirrorCarries_deform

theorem PlanarIsotopic.mirror {D D' : Diagram} (h : PlanarIsotopic D D') :
    PlanarIsotopic D.mirror D'.mirror :=
  mirrorCarries_planarIsotopic D D' h

/-! ## Mirror transport, part 3: regions, arcs, the local frame -/

namespace Diagram

variable (D : Diagram) {U : Set Plane}

theorem mirror_eval_mem_iff (p : D.mirror.Γ.Pt) :
    D.mirror.Γ.eval p ∈ reflect '' U ↔ D.Γ.eval p ∈ U := by
  rw [D.mirror_eval]; exact reflect_mem_image_iff

theorem mirror_eval_mem_interior_iff (p : D.mirror.Γ.Pt) :
    D.mirror.Γ.eval p ∈ interior (reflect '' U) ↔ D.Γ.eval p ∈ interior U := by
  rw [D.mirror_eval]; exact reflect_mem_interior_image_iff

theorem mirror_eval_mem_frontier_iff (p : D.mirror.Γ.Pt) :
    D.mirror.Γ.eval p ∈ frontier (reflect '' U) ↔ D.Γ.eval p ∈ frontier U := by
  rw [D.mirror_eval]; exact reflect_mem_frontier_image_iff

theorem mirror_crossingPoint_mem_interior_iff (x : D.mirror.Γ.Crossing) :
    D.mirror.Γ.crossingPoint x ∈ interior (reflect '' U) ↔
      D.Γ.crossingPoint (D.mirrorCrossing x) ∈ interior U := by
  rw [D.mirror_crossingPoint]; exact reflect_mem_interior_image_iff

/-- The outside traversal points of the mirror image relative to the reflected region. -/
def mirrorOutside (U : Set Plane) : D.mirror.Γ.Outside (reflect '' U) ≃ D.Γ.Outside U :=
  Equiv.subtypeEquivRight fun p => not_congr (D.mirror_eval_mem_interior_iff p)

@[simp] theorem mirrorOutside_val (p : D.mirror.Γ.Outside (reflect '' U)) :
    (D.mirrorOutside U p).1 = p.1 := rfl

@[simp] theorem mirrorOutside_symm_val (p : D.Γ.Outside U) :
    ((D.mirrorOutside U).symm p).1 = p.1 := rfl

/-- The outer crossings of the mirror image relative to the reflected region. -/
def mirrorOuter (U : Set Plane) : D.mirror.OuterCrossing (reflect '' U) ≃ D.OuterCrossing U :=
  Equiv.subtypeEquiv D.mirrorCrossing fun x => not_congr (D.mirror_crossingPoint_mem_interior_iff x)

@[simp] theorem mirrorOuter_val (x : D.mirror.OuterCrossing (reflect '' U)) :
    (D.mirrorOuter U x).1 = D.mirrorCrossing x.1 := rfl

@[simp] theorem mirrorOuter_symm_val (x : D.OuterCrossing U) :
    ((D.mirrorOuter U).symm x).1 = D.mirrorCrossing.symm x.1 := rfl

theorem mirrorOutside_outerOverPt (x : D.mirror.OuterCrossing (reflect '' U)) :
    D.mirrorOutside U (D.mirror.outerOverPt x) = D.outerOverPt (D.mirrorOuter U x) :=
  Subtype.ext (D.mirror_visitPt_overVisit x.1)

theorem mirrorOutside_outerUnderPt (x : D.mirror.OuterCrossing (reflect '' U)) :
    D.mirrorOutside U (D.mirror.outerUnderPt x) = D.outerUnderPt (D.mirrorOuter U x) :=
  Subtype.ext (D.mirror_visitPt_underVisit x.1)

/-- Arcs of the mirror image: same component, same ends. -/
def mirrorArc (a : D.Γ.Arc) : D.mirror.Γ.Arc := ⟨a.i, a.start, a.stop⟩

/-- The inverse relabelling of arcs. -/
def unmirrorArc (a : D.mirror.Γ.Arc) : D.Γ.Arc := ⟨a.i, a.start, a.stop⟩

theorem unmirrorArc_mirrorArc (a : D.Γ.Arc) : D.unmirrorArc (D.mirrorArc a) = a := rfl

theorem mirrorArc_injective : Function.Injective D.mirrorArc :=
  Function.LeftInverse.injective D.unmirrorArc_mirrorArc

theorem mirrorArc_inner (a : D.Γ.Arc) (p : D.mirror.Γ.Pt) :
    (D.mirrorArc a).Inner p ↔ a.Inner p := Iff.rfl

theorem mirrorArc_mem (a : D.Γ.Arc) (p : D.mirror.Γ.Pt) : (D.mirrorArc a).Mem p ↔ a.Mem p :=
  Iff.rfl

theorem mirrorArc_before (a : D.Γ.Arc) (p q : D.mirror.Γ.Pt) :
    (D.mirrorArc a).Before p q ↔ a.Before p q := Iff.rfl

theorem mirrorArc_isArc (a : D.Γ.Arc) :
    D.mirror.Γ.IsArc (reflect '' U) (D.mirrorArc a) ↔ D.Γ.IsArc U a := by
  constructor
  · intro h
    exact ⟨h.start_ne_stop, (D.mirror_eval_mem_frontier_iff _).mp h.start_frontier,
      (D.mirror_eval_mem_frontier_iff _).mp h.stop_frontier,
      fun p hp => (D.mirror_eval_mem_interior_iff p).mp (h.inner_interior p hp)⟩
  · intro h
    exact ⟨h.start_ne_stop, (D.mirror_eval_mem_frontier_iff _).mpr h.start_frontier,
      (D.mirror_eval_mem_frontier_iff _).mpr h.stop_frontier,
      fun p hp => (D.mirror_eval_mem_interior_iff p).mpr (h.inner_interior p hp)⟩

/-- The mirror image of an arc cover. -/
theorem _root_.SM.Link.Shadow.ArcCover.mirror {A : Set D.Γ.Arc} (h : D.Γ.ArcCover U A) :
    D.mirror.Γ.ArcCover (reflect '' U) (D.mirrorArc '' A) where
  isArc := by
    rintro _ ⟨a, ha, rfl⟩
    exact (D.mirrorArc_isArc a).mpr (h.isArc a ha)
  mem_iff := fun p => by
    rw [D.mirror_eval_mem_iff, h.mem_iff p, Set.exists_mem_image]
    exact Iff.rfl
  disjoint := by
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩ hab p hp
    exact h.disjoint a ha b hb (fun e => hab (congrArg D.mirrorArc e)) p hp

theorem mirror_overOn (a : D.Γ.Arc) (x : D.mirror.Γ.Crossing) :
    D.mirror.OverOn (D.mirrorArc a) x ↔ D.OverOn a (D.mirrorCrossing x) := by
  unfold OverOn
  rw [D.mirror_visitPt_overVisit]
  exact Iff.rfl

theorem mirror_underOn (a : D.Γ.Arc) (x : D.mirror.Γ.Crossing) :
    D.mirror.UnderOn (D.mirrorArc a) x ↔ D.UnderOn a (D.mirrorCrossing x) := by
  unfold UnderOn
  rw [D.mirror_visitPt_underVisit]
  exact Iff.rfl

theorem mirror_separates (a b : D.Γ.Arc) (x : D.mirror.Γ.Crossing) :
    D.mirror.Separates (D.mirrorArc a) (D.mirrorArc b) x ↔ D.Separates a b (D.mirrorCrossing x) := by
  unfold Separates
  rw [mirror_overOn, mirror_overOn, mirror_underOn, mirror_underOn]

theorem mirror_beforeOn (a : D.Γ.Arc) (x y : D.mirror.Γ.Crossing) :
    D.mirror.BeforeOn (D.mirrorArc a) x y ↔
      D.BeforeOn a (D.mirrorCrossing x) (D.mirrorCrossing y) := by
  constructor
  · rintro ⟨v, w, hv, hw, h⟩
    refine ⟨D.mirrorVisit v, D.mirrorVisit w, by rw [mirrorVisit_fst, hv],
      by rw [mirrorVisit_fst, hw], ?_⟩
    rw [D.visitPt_of_mirror v, D.visitPt_of_mirror w] at h
    exact h
  · rintro ⟨v, w, hv, hw, h⟩
    refine ⟨D.mirrorVisit.symm v, D.mirrorVisit.symm w, ?_, ?_, ?_⟩
    · rw [mirrorVisit_symm_fst, hv, Equiv.symm_apply_apply]
    · rw [mirrorVisit_symm_fst, hw, Equiv.symm_apply_apply]
    · have h' : (D.mirrorArc a).Before (D.mirror.visitPt (D.mirrorVisit.symm v))
          (D.mirror.visitPt (D.mirrorVisit.symm w)) := by
        rw [D.visitPt_of_mirror, D.visitPt_of_mirror, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        exact h
      exact h'

/-- Reflection of the shadow (`Diagram.mirror`) with the crossing relabelled. -/
theorem mirror_isPositive_iff' (x : D.mirror.Γ.Crossing) :
    D.mirror.IsPositive x ↔ ¬ D.IsPositive (D.mirrorCrossing x) :=
  D.mirror_isPositive_iff x

end Diagram

theorem Clean.mirror {U : Set Plane} {D : Diagram} (h : Clean U D) :
    Clean (reflect '' U) D.mirror where
  frontier_injOn := by
    intro p hp q hq hpq
    have hp' : D.Γ.eval p ∈ frontier U := (D.mirror_eval_mem_frontier_iff p).mp hp
    have hq' : D.Γ.eval q ∈ frontier U := (D.mirror_eval_mem_frontier_iff q).mp hq
    apply h.frontier_injOn hp' hq'
    rw [D.mirror_eval, D.mirror_eval] at hpq
    exact reflect_injective hpq
  exits := fun i => by
    obtain ⟨p, hp⟩ := h.exits i
    exact ⟨p, fun hmem => hp ((D.mirror_eval_mem_iff ⟨i, p⟩).mp hmem)⟩

theorem LocalFrame.mirror {U : Set Plane} {D D' : Diagram} (h : LocalFrame U D D') :
    LocalFrame (reflect '' U) D.mirror D'.mirror :=
  ⟨h.disc.reflect_image, h.clean.mirror, h.clean'.mirror⟩

/-- The mirror image of an outside match. -/
def OutsideMatch.mirror {U : Set Plane} {D D' : Diagram} (m : OutsideMatch U D D') :
    OutsideMatch (reflect '' U) D.mirror D'.mirror where
  φ := (D.mirrorOutside U).trans (m.φ.trans (D'.mirrorOutside U).symm)
  eval_eq := fun p => by
    show D'.mirror.Γ.eval ((D'.mirrorOutside U).symm (m.φ (D.mirrorOutside U p))).1 =
      D.mirror.Γ.eval p.1
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect (m.eval_eq (D.mirrorOutside U p))
  dir_pos := fun p hp => by
    obtain ⟨l, hl, h⟩ := m.dir_pos (D.mirrorOutside U p) (fun h => hp ((D.mirror_eval_mem_iff p.1).mpr h))
    refine ⟨l, hl, ?_⟩
    show D'.mirror.Γ.dir (D'.mirror.Γ.strandOf
        ((D'.mirrorOutside U).symm (m.φ (D.mirrorOutside U p))).1) =
      l • D.mirror.Γ.dir (D.mirror.Γ.strandOf p.1)
    rw [D'.mirror_dir, D.mirror_dir, ← reflect_smul]
    exact congrArg reflect h
  dir_pos_before := fun p hp => by
    obtain ⟨l, hl, h⟩ := m.dir_pos_before (D.mirrorOutside U p)
      (fun h => hp ((D.mirror_eval_mem_iff p.1).mpr h))
    refine ⟨l, hl, ?_⟩
    show D'.mirror.Γ.dir (D'.mirror.Γ.strandBefore
        ((D'.mirrorOutside U).symm (m.φ (D.mirrorOutside U p))).1) =
      l • D.mirror.Γ.dir (D.mirror.Γ.strandBefore p.1)
    rw [D'.mirror_dir, D.mirror_dir, ← reflect_smul]
    exact congrArg reflect h
  ψ := (D.mirrorOuter U).trans (m.ψ.trans (D'.mirrorOuter U).symm)
  over_eq := fun x => by
    apply Subtype.ext
    show ((D'.mirrorOutside U).symm (m.φ (D.mirrorOutside U (D.mirror.outerOverPt x)))).1 =
      D'.mirror.visitPt (D'.mirror.overVisit ((D'.mirrorOuter U).symm (m.ψ (D.mirrorOuter U x))).1)
    rw [D.mirrorOutside_outerOverPt, m.over_eq]
    exact (D'.mirror_visitPt_overVisit_symm _).symm
  under_eq := fun x => by
    apply Subtype.ext
    show ((D'.mirrorOutside U).symm (m.φ (D.mirrorOutside U (D.mirror.outerUnderPt x)))).1 =
      D'.mirror.visitPt (D'.mirror.underVisit ((D'.mirrorOuter U).symm (m.ψ (D.mirrorOuter U x))).1)
    rw [D.mirrorOutside_outerUnderPt, m.under_eq]
    exact (D'.mirror_visitPt_underVisit_symm _).symm

theorem AgreeOutside.mirror {U : Set Plane} {D D' : Diagram} (h : AgreeOutside U D D') :
    AgreeOutside (reflect '' U) D.mirror D'.mirror :=
  h.elim fun m => ⟨m.mirror⟩

/-- The mirror image of a move match (same component bijection). -/
def MoveMatch.mirror {U : Set Plane} {D D' : Diagram} (m : MoveMatch U D D') :
    MoveMatch (reflect '' U) D.mirror D'.mirror :=
  { m.toOutsideMatch.mirror with
    e := m.e
    comp_eq := fun p => m.comp_eq (D.mirrorOutside U p) }

/-! ## Mirror transport, part 4: the three moves, the smoothing, skein triples -/

/-- The mirror image of a Reidemeister I site. -/
def RIData.mirror {U : Set Plane} {D D' : Diagram} (h : RIData U D D') :
    RIData (reflect '' U) D.mirror D'.mirror where
  frame := h.frame.mirror
  out := h.out.mirror
  a := D.mirrorArc h.a
  a' := D'.mirrorArc h.a'
  cover := by
    have := h.cover.mirror
    rwa [Set.image_singleton] at this
  cover' := by
    have := h.cover'.mirror
    rwa [Set.image_singleton] at this
  start_eq := by
    show D'.mirror.Γ.eval (D'.mirrorArc h.a').startPt = D.mirror.Γ.eval (D.mirrorArc h.a).startPt
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.start_eq
  stop_eq := by
    show D'.mirror.Γ.eval (D'.mirrorArc h.a').stopPt = D.mirror.Γ.eval (D.mirrorArc h.a).stopPt
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.stop_eq
  no_inner := fun x hx =>
    h.no_inner (D.mirrorCrossing x) ((D.mirror_crossingPoint_mem_interior_iff x).mp hx)
  kink := D'.mirrorCrossing.symm h.kink
  inner_iff' := fun y => by
    rw [D'.mirror_crossingPoint_mem_interior_iff, h.inner_iff']
    exact D'.mirrorCrossing.eq_symm_apply.symm

/-- The mirror image carries Reidemeister I to Reidemeister I. -/
theorem mirrorCarries_RI : MirrorCarries RI := by
  rintro D D' ⟨U, h | h⟩
  · exact ⟨reflect '' U, Or.inl ⟨h.some.mirror⟩⟩
  · exact ⟨reflect '' U, Or.inr ⟨h.some.mirror⟩⟩

/-- The mirror image of a Reidemeister II site (the common over strand is kept: over data is kept
by the mirror image). -/
def RIIData.mirror {U : Set Plane} {D D' : Diagram} (h : RIIData U D D') :
    RIIData (reflect '' U) D.mirror D'.mirror where
  frame := h.frame.mirror
  out := h.out.mirror
  a := D.mirrorArc h.a
  b := D.mirrorArc h.b
  a' := D'.mirrorArc h.a'
  b' := D'.mirrorArc h.b'
  ab := fun e => h.ab (D.mirrorArc_injective e)
  ab' := fun e => h.ab' (D'.mirrorArc_injective e)
  cover := by
    have := h.cover.mirror
    rwa [Set.image_insert_eq, Set.image_singleton] at this
  cover' := by
    have := h.cover'.mirror
    rwa [Set.image_insert_eq, Set.image_singleton] at this
  a_start := by
    show D'.mirror.Γ.eval (D'.mirrorArc h.a').startPt = D.mirror.Γ.eval (D.mirrorArc h.a).startPt
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.a_start
  a_stop := by
    show D'.mirror.Γ.eval (D'.mirrorArc h.a').stopPt = D.mirror.Γ.eval (D.mirrorArc h.a).stopPt
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.a_stop
  b_start := by
    show D'.mirror.Γ.eval (D'.mirrorArc h.b').startPt = D.mirror.Γ.eval (D.mirrorArc h.b).startPt
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.b_start
  b_stop := by
    show D'.mirror.Γ.eval (D'.mirrorArc h.b').stopPt = D.mirror.Γ.eval (D.mirrorArc h.b).stopPt
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.b_stop
  no_inner := fun x hx =>
    h.no_inner (D.mirrorCrossing x) ((D.mirror_crossingPoint_mem_interior_iff x).mp hx)
  x₁ := D'.mirrorCrossing.symm h.x₁
  x₂ := D'.mirrorCrossing.symm h.x₂
  ne := fun e => h.ne (D'.mirrorCrossing.symm.injective e)
  inner_iff' := fun y => by
    rw [D'.mirror_crossingPoint_mem_interior_iff, h.inner_iff',
      ← D'.mirrorCrossing.eq_symm_apply, ← D'.mirrorCrossing.eq_symm_apply]
  sep₁ := (D'.mirror_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep₁)
  sep₂ := (D'.mirror_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep₂)
  same_over := by
    rw [D'.mirror_overOn, D'.mirror_overOn, D'.mirror_overOn, D'.mirror_overOn,
      Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    exact h.same_over

/-- The mirror image carries Reidemeister II to Reidemeister II. -/
theorem mirrorCarries_RII : MirrorCarries RII := by
  rintro D D' ⟨U, h | h⟩
  · exact ⟨reflect '' U, Or.inl ⟨h.some.mirror⟩⟩
  · exact ⟨reflect '' U, Or.inr ⟨h.some.mirror⟩⟩

/-- The mirror image of a Reidemeister III site (the strict height order is kept: over data is
kept by the mirror image). -/
def RIIIData.mirror {U : Set Plane} {D D' : Diagram} (h : RIIIData U D D') :
    RIIIData (reflect '' U) D.mirror D'.mirror where
  frame := h.frame.mirror
  out := h.out.mirror
  a := D.mirrorArc h.a
  b := D.mirrorArc h.b
  c := D.mirrorArc h.c
  a' := D'.mirrorArc h.a'
  b' := D'.mirrorArc h.b'
  c' := D'.mirrorArc h.c'
  ab := fun e => h.ab (D.mirrorArc_injective e)
  bc := fun e => h.bc (D.mirrorArc_injective e)
  ac := fun e => h.ac (D.mirrorArc_injective e)
  ab' := fun e => h.ab' (D'.mirrorArc_injective e)
  bc' := fun e => h.bc' (D'.mirrorArc_injective e)
  ac' := fun e => h.ac' (D'.mirrorArc_injective e)
  cover := by
    have := h.cover.mirror
    rwa [Set.image_insert_eq, Set.image_insert_eq, Set.image_singleton] at this
  cover' := by
    have := h.cover'.mirror
    rwa [Set.image_insert_eq, Set.image_insert_eq, Set.image_singleton] at this
  a_start := by
    show D'.mirror.Γ.eval (D'.mirrorArc h.a').startPt = D.mirror.Γ.eval (D.mirrorArc h.a).startPt
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.a_start
  a_stop := by
    show D'.mirror.Γ.eval (D'.mirrorArc h.a').stopPt = D.mirror.Γ.eval (D.mirrorArc h.a).stopPt
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.a_stop
  b_start := by
    show D'.mirror.Γ.eval (D'.mirrorArc h.b').startPt = D.mirror.Γ.eval (D.mirrorArc h.b).startPt
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.b_start
  b_stop := by
    show D'.mirror.Γ.eval (D'.mirrorArc h.b').stopPt = D.mirror.Γ.eval (D.mirrorArc h.b).stopPt
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.b_stop
  c_start := by
    show D'.mirror.Γ.eval (D'.mirrorArc h.c').startPt = D.mirror.Γ.eval (D.mirrorArc h.c).startPt
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.c_start
  c_stop := by
    show D'.mirror.Γ.eval (D'.mirrorArc h.c').stopPt = D.mirror.Γ.eval (D.mirrorArc h.c).stopPt
    rw [D'.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.c_stop
  xab := D.mirrorCrossing.symm h.xab
  xac := D.mirrorCrossing.symm h.xac
  xbc := D.mirrorCrossing.symm h.xbc
  xab_ne_xac := fun e => h.xab_ne_xac (D.mirrorCrossing.symm.injective e)
  xab_ne_xbc := fun e => h.xab_ne_xbc (D.mirrorCrossing.symm.injective e)
  xac_ne_xbc := fun e => h.xac_ne_xbc (D.mirrorCrossing.symm.injective e)
  inner_iff := fun y => by
    rw [D.mirror_crossingPoint_mem_interior_iff, h.inner_iff,
      ← D.mirrorCrossing.eq_symm_apply, ← D.mirrorCrossing.eq_symm_apply,
      ← D.mirrorCrossing.eq_symm_apply]
  sep_ab := (D.mirror_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep_ab)
  sep_ac := (D.mirror_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep_ac)
  sep_bc := (D.mirror_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep_bc)
  xab' := D'.mirrorCrossing.symm h.xab'
  xac' := D'.mirrorCrossing.symm h.xac'
  xbc' := D'.mirrorCrossing.symm h.xbc'
  xab_ne_xac' := fun e => h.xab_ne_xac' (D'.mirrorCrossing.symm.injective e)
  xab_ne_xbc' := fun e => h.xab_ne_xbc' (D'.mirrorCrossing.symm.injective e)
  xac_ne_xbc' := fun e => h.xac_ne_xbc' (D'.mirrorCrossing.symm.injective e)
  inner_iff' := fun y => by
    rw [D'.mirror_crossingPoint_mem_interior_iff, h.inner_iff',
      ← D'.mirrorCrossing.eq_symm_apply, ← D'.mirrorCrossing.eq_symm_apply,
      ← D'.mirrorCrossing.eq_symm_apply]
  sep_ab' := (D'.mirror_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep_ab')
  sep_ac' := (D'.mirror_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep_ac')
  sep_bc' := (D'.mirror_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep_bc')
  top_ab := (D.mirror_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.top_ab)
  top_ac := (D.mirror_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.top_ac)
  mid_bc := (D.mirror_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.mid_bc)
  top_ab' := (D'.mirror_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.top_ab')
  top_ac' := (D'.mirror_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.top_ac')
  mid_bc' := (D'.mirror_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.mid_bc')
  rev_a := by
    rw [D.mirror_beforeOn, D'.mirror_beforeOn, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    exact h.rev_a
  rev_b := by
    rw [D.mirror_beforeOn, D'.mirror_beforeOn, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    exact h.rev_b
  rev_c := by
    rw [D.mirror_beforeOn, D'.mirror_beforeOn, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    exact h.rev_c

/-- The mirror image carries Reidemeister III to Reidemeister III. -/
theorem mirrorCarries_RIII : MirrorCarries RIII := by
  rintro D D' ⟨U, h | h⟩
  · exact ⟨reflect '' U, Or.inl ⟨h.some.mirror⟩⟩
  · exact ⟨reflect '' U, Or.inr ⟨h.some.mirror⟩⟩

/-- The mirror image carries link equivalence to link equivalence (the mirror paragraph of
cf:thm-carrierfloor; design decision D2's reviewer check, mirror half). -/
theorem mirrorCarries_linkEquiv : MirrorCarries LinkEquiv :=
  mirrorCarries_linkEquiv_of mirrorCarries_planarIsotopic mirrorCarries_RI mirrorCarries_RII
    mirrorCarries_RIII

theorem LinkEquiv.mirror {D D' : Diagram} (h : LinkEquiv D D') : LinkEquiv D.mirror D'.mirror :=
  mirrorCarries_linkEquiv D D' h

/-- The mirror image of a smoothing site. -/
def OrientedSmoothingData.mirror {U : Set Plane} {D : Diagram} {x : D.Γ.Crossing} {D₀ : Diagram}
    (h : OrientedSmoothingData U D x D₀) :
    OrientedSmoothingData (reflect '' U) D.mirror (D.mirrorCrossing.symm x) D₀.mirror where
  frame := h.frame.mirror
  center := (D.mirror_crossingPoint_mem_interior_iff _).mpr
    (by rw [Equiv.apply_symm_apply]; exact h.center)
  out := h.out.mirror
  a := D.mirrorArc h.a
  b := D.mirrorArc h.b
  ab := fun e => h.ab (D.mirrorArc_injective e)
  cover := by
    have := h.cover.mirror
    rwa [Set.image_insert_eq, Set.image_singleton] at this
  over_on_a := (D.mirror_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.over_on_a)
  under_on_b := (D.mirror_underOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.under_on_b)
  inner_iff := fun y => by
    rw [D.mirror_crossingPoint_mem_interior_iff, h.inner_iff]
    exact D.mirrorCrossing.eq_symm_apply.symm
  a₀ := D₀.mirrorArc h.a₀
  b₀ := D₀.mirrorArc h.b₀
  ab₀ := fun e => h.ab₀ (D₀.mirrorArc_injective e)
  cover₀ := by
    have := h.cover₀.mirror
    rwa [Set.image_insert_eq, Set.image_singleton] at this
  no_inner₀ := fun y hy =>
    h.no_inner₀ (D₀.mirrorCrossing y) ((D₀.mirror_crossingPoint_mem_interior_iff y).mp hy)
  a₀_start := by
    show D₀.mirror.Γ.eval (D₀.mirrorArc h.a₀).startPt = D.mirror.Γ.eval (D.mirrorArc h.a).startPt
    rw [D₀.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.a₀_start
  a₀_stop := by
    show D₀.mirror.Γ.eval (D₀.mirrorArc h.a₀).stopPt = D.mirror.Γ.eval (D.mirrorArc h.b).stopPt
    rw [D₀.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.a₀_stop
  b₀_start := by
    show D₀.mirror.Γ.eval (D₀.mirrorArc h.b₀).startPt = D.mirror.Γ.eval (D.mirrorArc h.b).startPt
    rw [D₀.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.b₀_start
  b₀_stop := by
    show D₀.mirror.Γ.eval (D₀.mirrorArc h.b₀).stopPt = D.mirror.Γ.eval (D.mirrorArc h.a).stopPt
    rw [D₀.mirror_eval, D.mirror_eval]
    exact congrArg reflect h.b₀_stop

/-- The mirror image carries oriented smoothings to oriented smoothings. -/
theorem IsOrientedSmoothing.mirror {D : Diagram} {x : D.Γ.Crossing} {D₀ : Diagram}
    (h : IsOrientedSmoothing D x D₀) :
    IsOrientedSmoothing D.mirror (D.mirrorCrossing.symm x) D₀.mirror := by
  obtain ⟨U, h⟩ := h
  exact ⟨reflect '' U, ⟨h.some.mirror⟩⟩

/-! ### The smoothing does not see the over data at the smoothed crossing -/

namespace Diagram

variable (D : Diagram) (x : D.Γ.Crossing)

/-- Sanity: switching keeps the traversal point of every occurrence (same shadow). -/
theorem switch_visitPt_mv (v : D.Γ.Visit) : (D.switch x).visitPt v = D.visitPt v := rfl

theorem switch_overVisit_self : (D.switch x).overVisit x = D.underVisit x := by
  refine Sigma.ext rfl ?_
  exact heq_of_eq (Subtype.ext (D.switch_overStrand_self x))

theorem switch_underVisit_self : (D.switch x).underVisit x = D.overVisit x := by
  refine Sigma.ext rfl ?_
  exact heq_of_eq (Subtype.ext (D.switch_underStrand_self x))

theorem switch_overVisit_of_ne {y : D.Γ.Crossing} (h : y ≠ x) :
    (D.switch x).overVisit y = D.overVisit y := by
  refine Sigma.ext rfl ?_
  exact heq_of_eq (Subtype.ext (D.switch_overStrand_of_ne h))

theorem switch_underVisit_of_ne {y : D.Γ.Crossing} (h : y ≠ x) :
    (D.switch x).underVisit y = D.underVisit y := by
  refine Sigma.ext rfl ?_
  exact heq_of_eq (Subtype.ext (D.switch_underStrand_of_ne h))

end Diagram

/-- An outside match of `D` transports to the switch of `D` at an inner crossing (the outer over
data is unchanged). -/
def OutsideMatch.switch {U : Set Plane} {D D₀ : Diagram} (m : OutsideMatch U D D₀)
    (x : D.Γ.Crossing) (hx : D.Γ.crossingPoint x ∈ interior U) :
    OutsideMatch U (D.switch x) D₀ where
  φ := m.φ
  eval_eq := m.eval_eq
  dir_pos := m.dir_pos
  dir_pos_before := m.dir_pos_before
  ψ := m.ψ
  over_eq := fun y => by
    have hy : y.1 ≠ x := fun e => y.2 (by rw [e]; exact hx)
    refine (congrArg m.φ (Subtype.ext ?_)).trans (m.over_eq y)
    show (D.switch x).visitPt ((D.switch x).overVisit y.1) = D.visitPt (D.overVisit y.1)
    rw [D.switch_overVisit_of_ne x hy]
    rfl
  under_eq := fun y => by
    have hy : y.1 ≠ x := fun e => y.2 (by rw [e]; exact hx)
    refine (congrArg m.φ (Subtype.ext ?_)).trans (m.under_eq y)
    show (D.switch x).visitPt ((D.switch x).underVisit y.1) = D.visitPt (D.underVisit y.1)
    rw [D.switch_underVisit_of_ne x hy]
    rfl

/-- Cleanness is a property of the shadow: it is kept by a switch. -/
theorem Clean.switch {U : Set Plane} {D : Diagram} (h : Clean U D) (x : D.Γ.Crossing) :
    Clean U (D.switch x) :=
  ⟨h.frontier_injOn, h.exits⟩

/-- A smoothing site of `D` at `x` is a smoothing site of `D^{sw}` at `x` (with the roles of the
two arcs exchanged): the oriented smoothing does not depend on which strand is over
(sm-3:1084-1085 "reconnects each incoming strand to the other strand's outgoing end"). -/
def OrientedSmoothingData.switch {U : Set Plane} {D : Diagram} {x : D.Γ.Crossing} {D₀ : Diagram}
    (h : OrientedSmoothingData U D x D₀) : OrientedSmoothingData U (D.switch x) x D₀ where
  frame := ⟨h.frame.disc, h.frame.clean.switch x, h.frame.clean'⟩
  center := h.center
  out := h.out.switch x h.center
  a := h.b
  b := h.a
  ab := h.ab.symm
  cover := by
    have := h.cover
    rwa [Set.pair_comm] at this
  over_on_a := by
    show h.b.Mem ((D.switch x).visitPt ((D.switch x).overVisit x))
    rw [D.switch_overVisit_self x]
    exact h.under_on_b
  under_on_b := by
    show h.a.Mem ((D.switch x).visitPt ((D.switch x).underVisit x))
    rw [D.switch_underVisit_self x]
    exact h.over_on_a
  inner_iff := h.inner_iff
  a₀ := h.b₀
  b₀ := h.a₀
  ab₀ := h.ab₀.symm
  cover₀ := by
    have := h.cover₀
    rwa [Set.pair_comm] at this
  no_inner₀ := h.no_inner₀
  a₀_start := h.b₀_start
  a₀_stop := h.b₀_stop
  b₀_start := h.a₀_start
  b₀_stop := h.a₀_stop

/-- Sanity: an oriented smoothing of `D` at `x` is an oriented smoothing of `D^{sw}` at `x`. -/
theorem IsOrientedSmoothing.switch {D : Diagram} {x : D.Γ.Crossing} {D₀ : Diagram}
    (h : IsOrientedSmoothing D x D₀) : IsOrientedSmoothing (D.switch x) x D₀ := by
  obtain ⟨U, h⟩ := h
  exact ⟨U, ⟨h.some.switch⟩⟩

/-- The mirror image of a switch is the switch of the mirror image. -/
theorem Diagram.mirror_of_switch (D : Diagram) (x : D.Γ.Crossing) :
    (D.switch x).mirror = D.mirror.switch (D.mirrorCrossing.symm x) := by
  apply Diagram.mk_eq_of_overStrand_eq
  funext y
  show (D.switch x).mirror.overStrand y = (D.mirror.switch (D.mirrorCrossing.symm x)).overStrand y
  have e1 : (D.switch x).mirror.overStrand y = (D.switch x).overStrand (D.mirrorCrossing y) :=
    (D.switch x).mirror_overStrand_mv y
  by_cases hy : D.mirrorCrossing y = x
  · have hy' : y = D.mirrorCrossing.symm x := D.mirrorCrossing.eq_symm_apply.mpr hy
    have l1 : (D.switch x).overStrand (D.mirrorCrossing y) = D.underStrand x :=
      (congrArg (D.switch x).overStrand hy).trans (D.switch_overStrand_self x)
    have r1 : (D.mirror.switch (D.mirrorCrossing.symm x)).overStrand y = D.underStrand x :=
      (congrArg (D.mirror.switch (D.mirrorCrossing.symm x)).overStrand hy').trans
        ((D.mirror.switch_overStrand_self _).trans ((D.mirror_underStrand_mv _).trans
          (congrArg D.underStrand (Equiv.apply_symm_apply _ _))))
    exact e1.trans (l1.trans r1.symm)
  · have hy' : y ≠ D.mirrorCrossing.symm x := fun e => hy (D.mirrorCrossing.eq_symm_apply.mp e)
    have l1 : (D.switch x).overStrand (D.mirrorCrossing y) = D.overStrand (D.mirrorCrossing y) :=
      D.switch_overStrand_of_ne hy
    have r1 : (D.mirror.switch (D.mirrorCrossing.symm x)).overStrand y =
        D.overStrand (D.mirrorCrossing y) :=
      (D.mirror.switch_overStrand_of_ne hy').trans (D.mirror_overStrand_mv y)
    exact e1.trans (l1.trans r1.symm)

/-- The mirror image is the switch of the mirror image of the switch (the form used for skein
triples). -/
theorem Diagram.mirror_eq_switch_mirror_switch (D : Diagram) (x : D.Γ.Crossing) :
    D.mirror = (D.switch x).mirror.switch ((D.switch x).mirrorCrossing.symm x) := by
  apply Diagram.mk_eq_of_overStrand_eq
  funext y
  show D.mirror.overStrand y =
    ((D.switch x).mirror.switch ((D.switch x).mirrorCrossing.symm x)).overStrand y
  have e1 : D.mirror.overStrand y = D.overStrand (D.mirrorCrossing y) := D.mirror_overStrand_mv y
  by_cases hy : D.mirrorCrossing y = x
  · have hy' : y = (D.switch x).mirrorCrossing.symm x := (D.switch x).mirrorCrossing.eq_symm_apply.mpr hy
    have l1 : D.overStrand (D.mirrorCrossing y) = D.overStrand x := congrArg D.overStrand hy
    have r1 : ((D.switch x).mirror.switch ((D.switch x).mirrorCrossing.symm x)).overStrand y =
        D.overStrand x :=
      (congrArg ((D.switch x).mirror.switch ((D.switch x).mirrorCrossing.symm x)).overStrand hy').trans
        (((D.switch x).mirror.switch_overStrand_self _).trans
          (((D.switch x).mirror_underStrand_mv _).trans
            ((congrArg (D.switch x).underStrand (Equiv.apply_symm_apply _ _)).trans
              (D.switch_underStrand_self x))))
    exact e1.trans (l1.trans r1.symm)
  · have hy' : y ≠ (D.switch x).mirrorCrossing.symm x := fun e =>
      hy ((D.switch x).mirrorCrossing.eq_symm_apply.mp e)
    have r1 : ((D.switch x).mirror.switch ((D.switch x).mirrorCrossing.symm x)).overStrand y =
        D.overStrand (D.mirrorCrossing y) :=
      ((D.switch x).mirror.switch_overStrand_of_ne hy').trans
        (((D.switch x).mirror_overStrand_mv y).trans (D.switch_overStrand_of_ne hy))
    exact e1.trans r1.symm

/-- The mirror image of a skein triple is a skein triple with `D₊` and `D₋` exchanged (the mirror
negates every sign, `Diagram.mirror_sign`; the mirror paragraph of cf:thm-carrierfloor). -/
theorem IsSkeinTriple.mirror {Dp Dm D0 : Diagram} (h : IsSkeinTriple Dp Dm D0) :
    IsSkeinTriple Dm.mirror Dp.mirror D0.mirror := by
  obtain ⟨x, hx, rfl, hs⟩ := h
  refine ⟨(Dp.switch x).mirrorCrossing.symm x, ?_, Dp.mirror_eq_switch_mirror_switch x,
    hs.switch.mirror⟩
  refine ((Dp.switch x).mirror_isPositive_iff' _).mpr ?_
  have h2 : (Dp.switch x).mirrorCrossing ((Dp.switch x).mirrorCrossing.symm x) = x :=
    Equiv.apply_symm_apply _ _
  have h3 : ¬ (Dp.switch x).IsPositive x := by
    rw [Dp.switch_isPositive_self]
    exact not_not.mpr hx
  exact Eq.mpr (congrArg (fun y => ¬ (Dp.switch x).IsPositive y) h2) h3

/-- The mirror image exchanges the two sides of every skein triple. -/
theorem mirror_skein : ∀ Dp Dm D0, IsSkeinTriple Dp Dm D0 → IsSkeinTriple Dm.mirror Dp.mirror D0.mirror :=
  fun _ _ _ h => h.mirror

/-- Statement (reversal keeps signs, `Diagram.reverse_sign`): reversal carries skein triples to
skein triples with the sides kept.  Proved below as `reverse_skein`. -/
def ReverseSkein : Prop :=
  ∀ Dp Dm D0, IsSkeinTriple Dp Dm D0 → IsSkeinTriple Dp.reverse Dm.reverse D0.reverse

/-! ## Reversal transport, part 1: the parameter circle under `reversal`

`Diagram.reverse` (LinkDiagram) reverses every component by the accepted `reversal P = fun i => P (2 − i)`.
On the parameter circle this is the involution `revPt` below: the traversal point `(j, t)` of the
reversed polygon is the point `(1 − j, 1 − t)` of the original (the vertex `(j, 0)` goes to the
vertex `(2 − j, 0)`); it reverses the strict cyclic order `traversalBetween`.  The construction goes
through the negation `traversalNeg` (key `x ↦ n − x`) and the accepted shift
`traversalShift`/`traversalBetween_shift` (SM.TraversalRelabel). -/

section TraversalReversal

variable {n : ℕ}

/-- Negation of the parameter circle: the traversal point with key `n − x` (and `0 ↦ 0`). -/
def traversalNeg (p : TraversalPoint n) : TraversalPoint n :=
  if h : p.2.val = 0 then (-p.1, ⟨0, le_rfl, zero_lt_one⟩)
  else (-p.1 - 1, ⟨1 - p.2.val, by have := p.2.2.2; linarith, by
    have h0 := p.2.2.1
    have : 0 < p.2.val := lt_of_le_of_ne h0 (Ne.symm h)
    linarith⟩)

theorem traversalNeg_of_zero (p : TraversalPoint n) (h : p.2.val = 0) :
    traversalNeg p = (-p.1, ⟨0, le_rfl, zero_lt_one⟩) := by
  unfold traversalNeg; rw [dite_eq_left h]

theorem traversalNeg_of_ne_zero (p : TraversalPoint n) (h : p.2.val ≠ 0) :
    (traversalNeg p).1 = -p.1 - 1 ∧ (traversalNeg p).2.val = 1 - p.2.val := by
  unfold traversalNeg; rw [dite_eq_right h]; exact ⟨rfl, rfl⟩

theorem traversalKey_eq_zero_iff [NeZero n] (p : TraversalPoint n) :
    traversalKey p = 0 ↔ p.1 = 0 ∧ p.2.val = 0 := by
  unfold traversalKey
  constructor
  · intro h
    have h1 : (p.1.val : ℝ) = 0 := by linarith [p.2.2.1, Nat.cast_nonneg (α := ℝ) p.1.val]
    have h2 : p.2.val = 0 := by linarith [p.2.2.1, Nat.cast_nonneg (α := ℝ) p.1.val]
    refine ⟨?_, h2⟩
    have : p.1.val = 0 := by exact_mod_cast h1
    exact (ZMod.val_eq_zero p.1).mp this
  · rintro ⟨h1, h2⟩
    rw [h1, h2, ZMod.val_zero]; simp

theorem val_add_one_of_ne_neg_one [NeZero n] (hn : 3 ≤ n) (j : ZMod n) (h : j + 1 ≠ 0) :
    (j + 1).val = j.val + 1 := by
  have : Fact (1 < n) := ⟨by omega⟩
  rw [ZMod.val_add, ZMod.val_one]
  apply Nat.mod_eq_of_lt
  have hlt := j.val_lt
  rcases Nat.lt_or_ge (j.val + 1) n with hl | hge
  · exact hl
  · exfalso
    have heq : j.val + 1 = n := by omega
    apply h
    rw [← ZMod.natCast_zmod_val j, ← Nat.cast_one, ← Nat.cast_add, heq, ZMod.natCast_self]

theorem traversalKey_neg [NeZero n] (hn : 3 ≤ n) (p : TraversalPoint n) :
    traversalKey (traversalNeg p) =
      if 0 < traversalKey p then (n : ℝ) - traversalKey p else 0 := by
  have hp0 := traversalKey_nonneg p
  by_cases h : p.2.val = 0
  · rw [traversalNeg_of_zero p h]
    by_cases hj : p.1 = 0
    · have hz : traversalKey p = 0 := (traversalKey_eq_zero_iff p).mpr ⟨hj, h⟩
      rw [ite_eq_right (by rw [hz]; exact lt_irrefl 0)]
      unfold traversalKey; rw [hj, neg_zero, ZMod.val_zero]; simp
    · have hne : traversalKey p ≠ 0 := fun hz => hj ((traversalKey_eq_zero_iff p).mp hz).1
      rw [ite_eq_left (lt_of_le_of_ne hp0 (Ne.symm hne))]
      unfold traversalKey
      rw [ZMod.neg_val, ite_eq_right hj, h, Nat.cast_sub p.1.val_lt.le]
      simp
  · have hne : traversalKey p ≠ 0 := fun hz => h ((traversalKey_eq_zero_iff p).mp hz).2
    rw [ite_eq_left (lt_of_le_of_ne hp0 (Ne.symm hne))]
    obtain ⟨h1, h2⟩ := traversalNeg_of_ne_zero p h
    unfold traversalKey
    rw [h1, h2]
    have e : -p.1 - 1 = -(p.1 + 1) := by ring
    rw [e, ZMod.neg_val]
    have hfact : Fact (1 < n) := ⟨by omega⟩
    by_cases hj : p.1 + 1 = 0
    · rw [ite_eq_left hj]
      have hv : p.1.val = n - 1 := by
        have hz : (p.1 + 1).val = 0 := by rw [hj, ZMod.val_zero]
        rw [ZMod.val_add, ZMod.val_one] at hz
        have hlt := p.1.val_lt
        rcases Nat.lt_or_ge (p.1.val + 1) n with hl | hge
        · rw [Nat.mod_eq_of_lt hl] at hz; omega
        · omega
      rw [hv, Nat.cast_sub (by omega : 1 ≤ n)]
      push_cast
      ring
    · rw [ite_eq_right hj, val_add_one_of_ne_neg_one hn p.1 hj]
      have hlt : p.1.val + 1 ≤ n := p.1.val_lt
      rw [Nat.cast_sub hlt]
      push_cast
      ring

/-- Negation reverses the strict cyclic order. -/
theorem traversalBetween_neg [NeZero n] (hn : 3 ≤ n) (p q r : TraversalPoint n) :
    traversalBetween (traversalNeg r) (traversalNeg q) (traversalNeg p) ↔ traversalBetween p q r := by
  have hp0 := traversalKey_nonneg p
  have hq0 := traversalKey_nonneg q
  have hr0 := traversalKey_nonneg r
  have hpn := traversalKey_lt_size p
  have hqn := traversalKey_lt_size q
  have hrn := traversalKey_lt_size r
  unfold traversalBetween
  rw [traversalKey_neg hn, traversalKey_neg hn, traversalKey_neg hn]
  split_ifs <;>
    constructor <;>
    rintro (⟨h₁, h₂⟩ | ⟨h₁, h₂⟩ | ⟨h₁, h₂⟩) <;>
    first
    | exact Or.inl ⟨by linarith, by linarith⟩
    | exact Or.inr (Or.inl ⟨by linarith, by linarith⟩)
    | exact Or.inr (Or.inr ⟨by linarith, by linarith⟩)

theorem traversalNeg_neg (p : TraversalPoint n) : traversalNeg (traversalNeg p) = p := by
  by_cases h : p.2.val = 0
  · rw [traversalNeg_of_zero p h, traversalNeg_of_zero _ rfl, neg_neg]
    exact Prod.ext rfl (Subtype.ext h.symm)
  · obtain ⟨h1, h2⟩ := traversalNeg_of_ne_zero p h
    have h' : (traversalNeg p).2.val ≠ 0 := by rw [h2]; have := p.2.2.2; linarith
    obtain ⟨h3, h4⟩ := traversalNeg_of_ne_zero _ h'
    refine Prod.ext ?_ (Subtype.ext ?_)
    · rw [h3, h1]; ring
    · rw [h4, h2]; ring

/-- The parameter-circle bijection induced by reversing a component (`reversal P`): the traversal
point `(j, t)` of the reversed polygon is the point `(1 − j, 1 − t)` of the original (`(2 − j, 0)`
for a vertex). -/
def revPt (p : TraversalPoint n) : TraversalPoint n := traversalShift (-2) (traversalNeg p)

theorem traversalBetween_revPt [NeZero n] (hn : 3 ≤ n) (p q r : TraversalPoint n) :
    traversalBetween (revPt r) (revPt q) (revPt p) ↔ traversalBetween p q r := by
  unfold revPt
  rw [traversalBetween_shift, traversalBetween_neg hn]

theorem traversalNeg_shift (a : ZMod n) (p : TraversalPoint n) :
    traversalNeg (traversalShift a p) = traversalShift (-a) (traversalNeg p) := by
  by_cases h : p.2.val = 0
  · rw [traversalNeg_of_zero (traversalShift a p) h, traversalNeg_of_zero p h]
    refine Prod.ext ?_ rfl
    show -(p.1 - a) = -p.1 - -a
    ring
  · obtain ⟨h1, h2⟩ := traversalNeg_of_ne_zero p h
    obtain ⟨h3, h4⟩ := traversalNeg_of_ne_zero (traversalShift a p) h
    refine Prod.ext ?_ (Subtype.ext ?_)
    · rw [h3]
      show -(p.1 - a) - 1 = (traversalNeg p).1 - -a
      rw [h1]; ring
    · rw [h4]
      show 1 - p.2.val = (traversalNeg p).2.val
      rw [h2]

theorem revPt_revPt (p : TraversalPoint n) : revPt (revPt p) = p := by
  unfold revPt
  rw [traversalNeg_shift, neg_neg, traversalNeg_neg]
  show (p.1 - 2 - -2, p.2) = p
  refine Prod.ext ?_ rfl
  ring

theorem revPt_of_ne_zero (p : TraversalPoint n) (h : p.2.val ≠ 0) :
    (revPt p).1 = 1 - p.1 ∧ (revPt p).2.val = 1 - p.2.val := by
  obtain ⟨h1, h2⟩ := traversalNeg_of_ne_zero p h
  refine ⟨?_, h2⟩
  show (traversalNeg p).1 - -2 = 1 - p.1
  rw [h1]; ring

theorem revPt_of_zero (p : TraversalPoint n) (h : p.2.val = 0) :
    (revPt p).1 = 2 - p.1 ∧ (revPt p).2.val = 0 := by
  unfold revPt
  rw [traversalNeg_of_zero p h]
  exact ⟨by show -p.1 - -2 = 2 - p.1; ring, rfl⟩

/-- Reversal of a polygon in traversal coordinates. -/
theorem traversalEvaluation_reversal (P : LabelledTuple n) (p : TraversalPoint n) :
    traversalEvaluation (reversal P) p = traversalEvaluation P (revPt p) := by
  unfold traversalEvaluation
  rw [edgePoint_reversal]
  by_cases h : p.2.val = 0
  · obtain ⟨h1, h2⟩ := revPt_of_zero p h
    rw [h, h1, h2, sub_zero, edgePoint_one, edgePoint_zero]
    congr 1; ring
  · obtain ⟨h1, h2⟩ := revPt_of_ne_zero p h
    rw [h1, h2]


/-- The involution `revPt` as a permutation of the parameter circle. -/
def revPtEquiv (n : ℕ) : Equiv.Perm (TraversalPoint n) := Function.Involutive.toPerm revPt revPt_revPt

@[simp] theorem revPtEquiv_apply (p : TraversalPoint n) : revPtEquiv n p = revPt p := rfl


end TraversalReversal

/-! ## Reversal transport, part 2: shadows, crossings, visits and traversal points of `D.reverse` -/

namespace Shadow

variable (Γ : Shadow)

theorem reverse_generic {Γ : Shadow} (h : Γ.Generic) : Γ.reverseShadow.Generic :=
  Γ.reverseMap.generic_pullback h fun i => regular_reversal_forward (h.regular i)

/-- Sanity: the crossing pairs of the reversed shadow are the relabelled crossing pairs. -/
theorem reverse_isCrossing_iff (x : Finset Γ.Strand) :
    Γ.reverseShadow.IsCrossing x ↔ Γ.IsCrossing (x.map Γ.reverseMap.emb) :=
  (Γ.reverseMap.isCrossing_map_iff x).symm

end Shadow

namespace Diagram
variable (D : Diagram)

@[simp] theorem reverse_Γ : D.reverse.Γ = D.Γ.reverseShadow := rfl

def reverseCrossing : D.reverse.Γ.Crossing ≃ D.Γ.Crossing := D.Γ.reverseCrossingEquiv

/-- The strand relabelling of the reversal: the strand `⟨i, a⟩` of `D.reverse` is the strand
`⟨i, 1 − a⟩` of `D` traversed backwards. -/
def revStrand (s : D.reverse.Γ.Strand) : D.Γ.Strand := D.Γ.reverseMap.toFun s

theorem mem_reverseCrossing {x : D.reverse.Γ.Crossing} {s : D.reverse.Γ.Strand} (hs : s ∈ x.val) :
    D.revStrand s ∈ (D.reverseCrossing x).val :=
  D.Γ.reverseMap.toFun_mem_of_mem hs

theorem mem_of_revStrand_mem {x : D.reverse.Γ.Crossing} {s : D.reverse.Γ.Strand}
    (hs : D.revStrand s ∈ (D.reverseCrossing x).val) : s ∈ x.val :=
  (D.Γ.reverseMap.toFun_mem_mapCrossing_iff x s).mp hs

theorem reverse_overStrand (x : D.reverse.Γ.Crossing) :
    D.revStrand (D.reverse.overStrand x) = D.overStrand (D.reverseCrossing x) :=
  toFun_pullback_overStrand D D.Γ.reverseMap (fun i => regular_reversal_forward (D.generic.regular i)) x

theorem reverse_underStrand (x : D.reverse.Γ.Crossing) :
    D.revStrand (D.reverse.underStrand x) = D.underStrand (D.reverseCrossing x) :=
  toFun_pullback_underStrand D D.Γ.reverseMap (fun i => regular_reversal_forward (D.generic.regular i)) x

def revStrandEquiv : D.reverse.Γ.Strand ≃ D.Γ.Strand where
  toFun := D.revStrand
  invFun := fun s => ⟨s.1, (1 : ZMod (D.Γ.comp s.1).k) - s.2⟩
  left_inv := fun _ => Sigma.ext rfl (heq_of_eq (sub_sub_cancel _ _))
  right_inv := fun _ => Sigma.ext rfl (heq_of_eq (sub_sub_cancel _ _))

def reverseVisit : D.reverse.Γ.Visit ≃ D.Γ.Visit :=
  Equiv.sigmaCongr D.reverseCrossing fun _ =>
    Equiv.subtypeEquiv D.revStrandEquiv fun _ => ⟨D.mem_reverseCrossing, D.mem_of_revStrand_mem⟩

@[simp] theorem reverseVisit_fst (v : D.reverse.Γ.Visit) : (D.reverseVisit v).1 = D.reverseCrossing v.1 := rfl
@[simp] theorem reverseVisit_snd (v : D.reverse.Γ.Visit) : (D.reverseVisit v).2.1 = D.revStrand v.2.1 := rfl

theorem reverseVisit_overVisit (x : D.reverse.Γ.Crossing) :
    D.reverseVisit (D.reverse.overVisit x) = D.overVisit (D.reverseCrossing x) := by
  refine Sigma.ext rfl ?_
  exact heq_of_eq (Subtype.ext (D.reverse_overStrand x))

theorem reverseVisit_underVisit (x : D.reverse.Γ.Crossing) :
    D.reverseVisit (D.reverse.underVisit x) = D.underVisit (D.reverseCrossing x) := by
  refine Sigma.ext rfl ?_
  exact heq_of_eq (Subtype.ext (D.reverse_underStrand x))

/-- traversal points of the reversal ↦ traversal points of `D` -/
def revPtΓ (p : D.reverse.Γ.Pt) : D.Γ.Pt := ⟨p.1, revPt p.2⟩
/-- and back -/
def unrevPtΓ (q : D.Γ.Pt) : D.reverse.Γ.Pt := ⟨q.1, revPt q.2⟩

theorem unrevPtΓ_revPtΓ (p : D.reverse.Γ.Pt) : D.unrevPtΓ (D.revPtΓ p) = p :=
  Sigma.ext rfl (heq_of_eq (revPt_revPt _))

theorem revPtΓ_unrevPtΓ (q : D.Γ.Pt) : D.revPtΓ (D.unrevPtΓ q) = q :=
  Sigma.ext rfl (heq_of_eq (revPt_revPt _))

theorem reverse_eval (p : D.reverse.Γ.Pt) : D.reverse.Γ.eval p = D.Γ.eval (D.revPtΓ p) :=
  traversalEvaluation_reversal _ _

theorem reverse_crossingPoint (x : D.reverse.Γ.Crossing) :
    D.reverse.Γ.crossingPoint x = D.Γ.crossingPoint (D.reverseCrossing x) :=
  (D.Γ.reverseMap.crossingPoint_mapCrossing D.generic x).symm

theorem reverse_crossingParam (x : D.reverse.Γ.Crossing) {s : D.reverse.Γ.Strand} (hs : s ∈ x.val) :
    D.reverse.crossingParam x hs =
      1 - D.crossingParam (D.reverseCrossing x) (D.mem_reverseCrossing hs) := by
  have h1 := (D.reverse.crossingParam_spec x hs).2.2
  have h2 := (D.crossingParam_spec (D.reverseCrossing x) (D.mem_reverseCrossing hs)).2.2
  have h3 : edgePoint (D.Γ.comp s.1).P (D.revStrand s).2
        (D.crossingParam (D.reverseCrossing x) (D.mem_reverseCrossing hs)) =
      edgePoint (D.Γ.comp s.1).P (D.revStrand s).2 (1 - D.reverse.crossingParam x hs) :=
    h2.symm.trans ((D.reverse_crossingPoint x).symm.trans (h1.trans (edgePoint_reversal _ _ _)))
  have := edgePoint_injective (D.Γ.edge_ne_zero D.generic (D.revStrand s)) h3
  linarith

theorem reverse_visitPt (v : D.reverse.Γ.Visit) :
    D.revPtΓ (D.reverse.visitPt v) = D.visitPt (D.reverseVisit v) := by
  have hpos : (D.reverse.visitPt v).2.2.val ≠ 0 := (D.reverse.visitPt_param_pos v).ne'
  obtain ⟨h1, h2⟩ := revPt_of_ne_zero _ hpos
  refine Sigma.ext rfl (heq_of_eq (Prod.ext h1 (Subtype.ext (h2.trans ?_))))
  show 1 - D.reverse.crossingParam v.1 v.2.2 =
    D.crossingParam (D.reverseCrossing v.1) (D.reverseVisit v).2.2
  rw [D.reverse_crossingParam, sub_sub_cancel]
  rfl

theorem reverse_visitPt_overVisit (x : D.reverse.Γ.Crossing) :
    D.revPtΓ (D.reverse.visitPt (D.reverse.overVisit x)) = D.visitPt (D.overVisit (D.reverseCrossing x)) := by
  rw [reverse_visitPt, reverseVisit_overVisit]

theorem reverse_visitPt_overVisit_symm (x : D.Γ.Crossing) :
    D.revPtΓ (D.reverse.visitPt (D.reverse.overVisit (D.reverseCrossing.symm x))) = D.visitPt (D.overVisit x) := by
  rw [reverse_visitPt_overVisit, Equiv.apply_symm_apply]

end Diagram


/-! ## Reversal transport, part 3: reparametrizations, deformations, planar isotopy -/

/-- The reversal of a reparametrization: `φ` conjugated by the parameter-circle reversal
(`revPt`), which preserves the strict cyclic order because both reversals reverse it. -/
def ReparamData.reverse {D D' : Diagram} (r : ReparamData D D') : ReparamData D.reverse D'.reverse where
  e := r.e
  φ := fun i => (revPtEquiv _).trans ((r.φ i).trans (revPtEquiv _))
  between := fun i p q s h => by
    have h1 : traversalBetween (revPt s) (revPt q) (revPt p) :=
      (traversalBetween_revPt (D.Γ.comp i).hk p q s).mpr h
    have h2 := r.between i _ _ _ h1
    exact (traversalBetween_revPt (D'.Γ.comp (r.e i)).hk _ _ _).mpr h2
  eval_eq := fun i p =>
    (D'.reverse_eval _).trans
      ((congrArg (fun q => D'.Γ.eval ⟨r.e i, q⟩) (revPt_revPt _)).trans
        ((r.eval_eq i (revPt p)).trans (D.reverse_eval ⟨i, p⟩).symm))
  over_map := fun x => by
    obtain ⟨x', hx'⟩ := r.over_map (D.reverseCrossing x)
    refine ⟨D'.reverseCrossing.symm x', ?_⟩
    have h1 := congrArg r.mapPt (D.reverse_visitPt_overVisit x)
    have h2 := D'.reverse_visitPt_overVisit_symm x'
    have h3 : r.mapPt (D.revPtΓ (D.reverse.visitPt (D.reverse.overVisit x))) =
        D'.revPtΓ (D'.reverse.visitPt (D'.reverse.overVisit (D'.reverseCrossing.symm x'))) :=
      h1.trans (hx'.trans h2.symm)
    exact (congrArg D'.unrevPtΓ h3).trans (D'.unrevPtΓ_revPtΓ _)
  over_surj := fun x' => by
    obtain ⟨x, hx⟩ := r.over_surj (D'.reverseCrossing x')
    refine ⟨D.reverseCrossing.symm x, ?_⟩
    have h1 := congrArg r.mapPt (D.reverse_visitPt_overVisit_symm x)
    have h2 := D'.reverse_visitPt_overVisit x'
    have h3 : r.mapPt (D.revPtΓ (D.reverse.visitPt (D.reverse.overVisit (D.reverseCrossing.symm x)))) =
        D'.revPtΓ (D'.reverse.visitPt (D'.reverse.overVisit x')) :=
      h1.trans (hx.trans h2.symm)
    exact (congrArg D'.unrevPtΓ h3).trans (D'.unrevPtΓ_revPtΓ _)


/-- Reversal carries reparametrizations to reparametrizations. -/
theorem reverseCarries_reparam : ReverseCarries Reparam := fun _ _ h => h.elim fun r => ⟨r.reverse⟩

/-- Sanity: reversal and generic re-vertexing commute. -/
theorem Diagram.reverse_deform (D : Diagram) (V : D.Γ.Vertices) (hgen : (D.Γ.withVertices V).Generic)
    (hcross : ∀ x : Finset D.Γ.Strand, (D.Γ.withVertices V).IsCrossing x ↔ D.Γ.IsCrossing x)
    (hgen' : (D.reverse.Γ.withVertices (fun i => reversal (V i))).Generic)
    (hcross' : ∀ x : Finset D.reverse.Γ.Strand,
      (D.reverse.Γ.withVertices (fun i => reversal (V i))).IsCrossing x ↔ D.reverse.Γ.IsCrossing x) :
    (D.deform V hgen hcross).reverse = D.reverse.deform (fun i => reversal (V i)) hgen' hcross' := by
  apply Diagram.mk_eq_of_overStrand_eq
  funext y
  apply D.Γ.reverseMap.inj
  have e1 : D.Γ.reverseMap.toFun ((D.deform V hgen hcross).reverse.overStrand y) =
      D.overStrand ⟨((D.deform V hgen hcross).reverseCrossing y).val, _⟩ :=
    (D.deform V hgen hcross).reverse_overStrand y
  have e2 : D.Γ.reverseMap.toFun (D.reverse.overStrand ⟨y.val, (hcross' y.val).mp y.2⟩) =
      D.overStrand (D.reverseCrossing ⟨y.val, (hcross' y.val).mp y.2⟩) :=
    D.reverse_overStrand _
  exact e1.trans ((congrArg D.overStrand (Subtype.ext rfl)).trans e2.symm)

/-- The reversal of a generic deformation (every component of every intermediate shadow
reversed). -/
def DeformData.reverse {D D' : Diagram} (d : DeformData D D') : DeformData D.reverse D'.reverse := by
  obtain ⟨γ, cont, start, gen, cross, rfl⟩ := d
  exact
    { γ := fun t i => reversal (γ t i)
      continuous := fun i (j : ZMod (D.Γ.comp i).k) => cont i (2 - j)
      start := funext fun i => by
        show reversal (γ 0 i) = reversal (D.Γ.comp i).P
        rw [start]; rfl
      generic := fun t ht => Shadow.reverse_generic (gen t ht)
      crossings := fun t ht x =>
        ((D.Γ.withVertices (γ t)).reverse_isCrossing_iff x).trans
          ((cross t ht _).trans (D.Γ.reverse_isCrossing_iff x).symm)
      stop := D.reverse_deform (γ 1) _ _ _ _ }

/-- Reversal carries generic deformations to generic deformations. -/
theorem reverseCarries_deform : ReverseCarries Deform := fun _ _ h => h.elim fun d => ⟨d.reverse⟩

/-- Reversal carries planar isotopy to planar isotopy (design decision D2, reviewer check
"reversal and mirror carry generators to generators", reversal half; cf:thm-carrierfloor (R)). -/
theorem reverseCarries_planarIsotopic : ReverseCarries PlanarIsotopic :=
  reverseCarries_planarIsotopic_of reverseCarries_reparam reverseCarries_deform

theorem PlanarIsotopic.reverse {D D' : Diagram} (h : PlanarIsotopic D D') :
    PlanarIsotopic D.reverse D'.reverse :=
  reverseCarries_planarIsotopic D D' h

/-! ## Reversal transport, part 4: directions, regions and the outside match under reversal -/

namespace Shadow

variable (Γ : Shadow)

/-- Traversal points of the reversed shadow ↦ traversal points of the shadow (`revPt` on the
parameter circle). -/
def reversePt (p : Γ.reverseShadow.Pt) : Γ.Pt := ⟨p.1, revPt p.2⟩

/-- ... and back. -/
def unreversePt (q : Γ.Pt) : Γ.reverseShadow.Pt := ⟨q.1, revPt q.2⟩

theorem unreversePt_reversePt (p : Γ.reverseShadow.Pt) : Γ.unreversePt (Γ.reversePt p) = p :=
  Sigma.ext rfl (heq_of_eq (revPt_revPt _))

theorem reversePt_unreversePt (q : Γ.Pt) : Γ.reversePt (Γ.unreversePt q) = q :=
  Sigma.ext rfl (heq_of_eq (revPt_revPt _))

theorem reversePt_eq_iff (p : Γ.reverseShadow.Pt) (q : Γ.Pt) :
    Γ.reversePt p = q ↔ p = Γ.unreversePt q := by
  constructor
  · rintro rfl; exact (Γ.unreversePt_reversePt p).symm
  · rintro rfl; exact Γ.reversePt_unreversePt q

theorem reverse_eval_pt (p : Γ.reverseShadow.Pt) : Γ.reverseShadow.eval p = Γ.eval (Γ.reversePt p) :=
  traversalEvaluation_reversal _ _

theorem reverse_dir (s : Γ.reverseShadow.Strand) :
    Γ.reverseShadow.dir s = -Γ.dir ⟨s.1, 1 - (s.2 : ZMod (Γ.comp s.1).k)⟩ :=
  edge_reversal _ _

/-- The forward direction of the reversed shadow at a point is the negated arriving direction of the
shadow at the corresponding point. -/
theorem reverse_dir_strandOf (p : Γ.reverseShadow.Pt) :
    Γ.reverseShadow.dir (Γ.reverseShadow.strandOf p) = -Γ.dir (Γ.strandBefore (Γ.reversePt p)) := by
  rw [strandOf_mk, reverse_dir]
  by_cases h : p.2.2.val = 0
  · obtain ⟨h1, h2⟩ := revPt_of_zero p.2 h
    rw [Γ.strandBefore_of_zero (Γ.reversePt p) h2]
    have e : (⟨p.1, (revPt p.2).1 - 1⟩ : Γ.Strand) = ⟨p.1, 1 - (p.2.1 : ZMod (Γ.comp p.1).k)⟩ :=
      Sigma.ext rfl (heq_of_eq (by rw [h1]; ring))
    show -Γ.dir ⟨p.1, 1 - (p.2.1 : ZMod (Γ.comp p.1).k)⟩ = -Γ.dir ⟨p.1, (revPt p.2).1 - 1⟩
    rw [e]
  · obtain ⟨h1, h2⟩ := revPt_of_ne_zero p.2 h
    have h2' : (revPt p.2).2.val ≠ 0 := by rw [h2]; have := p.2.2.2.2; linarith
    rw [Γ.strandBefore_of_ne_zero (Γ.reversePt p) h2']
    have e : (Γ.strandOf (Γ.reversePt p)) = ⟨p.1, 1 - (p.2.1 : ZMod (Γ.comp p.1).k)⟩ :=
      Sigma.ext rfl (heq_of_eq h1)
    show -Γ.dir ⟨p.1, 1 - (p.2.1 : ZMod (Γ.comp p.1).k)⟩ = -Γ.dir (Γ.strandOf (Γ.reversePt p))
    rw [e]

/-- The arriving direction of the reversed shadow at a point is the negated forward direction of the
shadow at the corresponding point. -/
theorem reverse_dir_strandBefore (p : Γ.reverseShadow.Pt) :
    Γ.reverseShadow.dir (Γ.reverseShadow.strandBefore p) = -Γ.dir (Γ.strandOf (Γ.reversePt p)) := by
  by_cases h : p.2.2.val = 0
  · obtain ⟨h1, h2⟩ := revPt_of_zero p.2 h
    rw [Γ.reverseShadow.strandBefore_of_zero p h, reverse_dir]
    have e : (⟨p.1, 1 - ((p.2.1 - 1 : ZMod (Γ.reverseShadow.comp p.1).k) : ZMod (Γ.comp p.1).k)⟩ :
        Γ.Strand) = Γ.strandOf (Γ.reversePt p) :=
      Sigma.ext rfl (heq_of_eq (by show 1 - (p.2.1 - 1) = (revPt p.2).1; rw [h1]; ring))
    show -Γ.dir ⟨p.1, 1 - ((p.2.1 - 1 : ZMod (Γ.reverseShadow.comp p.1).k) : ZMod (Γ.comp p.1).k)⟩ =
      -Γ.dir (Γ.strandOf (Γ.reversePt p))
    rw [e]
  · obtain ⟨h1, h2⟩ := revPt_of_ne_zero p.2 h
    rw [Γ.reverseShadow.strandBefore_of_ne_zero p h, strandOf_mk, reverse_dir]
    have e : (⟨p.1, 1 - (p.2.1 : ZMod (Γ.comp p.1).k)⟩ : Γ.Strand) = Γ.strandOf (Γ.reversePt p) :=
      Sigma.ext rfl (heq_of_eq h1.symm)
    show -Γ.dir ⟨p.1, 1 - (p.2.1 : ZMod (Γ.comp p.1).k)⟩ = -Γ.dir (Γ.strandOf (Γ.reversePt p))
    rw [e]

end Shadow

namespace Diagram

variable (D : Diagram)

theorem revPtΓ_eq (p : D.reverse.Γ.Pt) : D.revPtΓ p = D.Γ.reversePt p := rfl

theorem reverse_dir_strandOf (p : D.reverse.Γ.Pt) :
    D.reverse.Γ.dir (D.reverse.Γ.strandOf p) = -D.Γ.dir (D.Γ.strandBefore (D.revPtΓ p)) :=
  D.Γ.reverse_dir_strandOf p

theorem reverse_dir_strandBefore (p : D.reverse.Γ.Pt) :
    D.reverse.Γ.dir (D.reverse.Γ.strandBefore p) = -D.Γ.dir (D.Γ.strandOf (D.revPtΓ p)) :=
  D.Γ.reverse_dir_strandBefore p

/-- The parameter-circle bijection of the reversal, on the traversal points of the whole shadow. -/
def revPtΓEquiv : D.reverse.Γ.Pt ≃ D.Γ.Pt :=
  ⟨D.revPtΓ, D.unrevPtΓ, D.unrevPtΓ_revPtΓ, D.revPtΓ_unrevPtΓ⟩

@[simp] theorem revPtΓEquiv_apply (p : D.reverse.Γ.Pt) : D.revPtΓEquiv p = D.revPtΓ p := rfl

theorem reverse_visitPt_underVisit (x : D.reverse.Γ.Crossing) :
    D.revPtΓ (D.reverse.visitPt (D.reverse.underVisit x)) =
      D.visitPt (D.underVisit (D.reverseCrossing x)) := by
  rw [reverse_visitPt, reverseVisit_underVisit]

theorem reverse_visitPt_underVisit_symm (x : D.Γ.Crossing) :
    D.revPtΓ (D.reverse.visitPt (D.reverse.underVisit (D.reverseCrossing.symm x))) =
      D.visitPt (D.underVisit x) := by
  rw [reverse_visitPt_underVisit, Equiv.apply_symm_apply]

variable {U : Set Plane}

theorem reverse_eval_mem_iff (p : D.reverse.Γ.Pt) : D.reverse.Γ.eval p ∈ U ↔ D.Γ.eval (D.revPtΓ p) ∈ U := by
  rw [D.reverse_eval]

/-- The outside traversal points of the reversal. -/
def reverseOutside (U : Set Plane) : D.reverse.Γ.Outside U ≃ D.Γ.Outside U :=
  Equiv.subtypeEquiv D.revPtΓEquiv fun p => by rw [D.reverse_eval p]; exact Iff.rfl

@[simp] theorem reverseOutside_val (p : D.reverse.Γ.Outside U) :
    (D.reverseOutside U p).1 = D.revPtΓ p.1 := rfl

@[simp] theorem reverseOutside_symm_val (q : D.Γ.Outside U) :
    ((D.reverseOutside U).symm q).1 = D.unrevPtΓ q.1 := rfl

/-- The outer crossings of the reversal. -/
def reverseOuter (U : Set Plane) : D.reverse.OuterCrossing U ≃ D.OuterCrossing U :=
  Equiv.subtypeEquiv D.reverseCrossing fun x => by rw [D.reverse_crossingPoint x]

@[simp] theorem reverseOuter_val (x : D.reverse.OuterCrossing U) :
    (D.reverseOuter U x).1 = D.reverseCrossing x.1 := rfl

@[simp] theorem reverseOuter_symm_val (x : D.OuterCrossing U) :
    ((D.reverseOuter U).symm x).1 = D.reverseCrossing.symm x.1 := rfl

theorem reverseOutside_outerOverPt (x : D.reverse.OuterCrossing U) :
    D.reverseOutside U (D.reverse.outerOverPt x) = D.outerOverPt (D.reverseOuter U x) :=
  Subtype.ext (D.reverse_visitPt_overVisit x.1)

theorem reverseOutside_outerUnderPt (x : D.reverse.OuterCrossing U) :
    D.reverseOutside U (D.reverse.outerUnderPt x) = D.outerUnderPt (D.reverseOuter U x) :=
  Subtype.ext (D.reverse_visitPt_underVisit x.1)

end Diagram

theorem Clean.reverse {U : Set Plane} {D : Diagram} (h : Clean U D) : Clean U D.reverse where
  frontier_injOn := by
    intro p hp q hq hpq
    have hp' : D.Γ.eval (D.revPtΓ p) ∈ frontier U := by rw [← D.reverse_eval]; exact hp
    have hq' : D.Γ.eval (D.revPtΓ q) ∈ frontier U := by rw [← D.reverse_eval]; exact hq
    have hpq' : D.Γ.eval (D.revPtΓ p) = D.Γ.eval (D.revPtΓ q) := by
      rw [← D.reverse_eval, ← D.reverse_eval]; exact hpq
    exact D.revPtΓEquiv.injective (h.frontier_injOn hp' hq' hpq')
  exits := fun i => by
    obtain ⟨p, hp⟩ := h.exits i
    refine ⟨revPt p, fun hmem => hp ?_⟩
    have e : D.reverse.Γ.eval ⟨i, revPt p⟩ = D.Γ.eval ⟨i, p⟩ :=
      (D.reverse_eval _).trans (congrArg (fun q => D.Γ.eval ⟨i, q⟩) (revPt_revPt p))
    exact e ▸ hmem

theorem LocalFrame.reverse {U : Set Plane} {D D' : Diagram} (h : LocalFrame U D D') :
    LocalFrame U D.reverse D'.reverse :=
  ⟨h.disc, h.clean.reverse, h.clean'.reverse⟩

/-- The reversal of an outside match: the forward and arriving direction clauses are exchanged
(and both negated). -/
def OutsideMatch.reverse {U : Set Plane} {D D' : Diagram} (m : OutsideMatch U D D') :
    OutsideMatch U D.reverse D'.reverse where
  φ := (D.reverseOutside U).trans (m.φ.trans (D'.reverseOutside U).symm)
  eval_eq := fun p => by
    show D'.reverse.Γ.eval ((D'.reverseOutside U).symm (m.φ (D.reverseOutside U p))).1 =
      D.reverse.Γ.eval p.1
    rw [D'.reverse_eval, D.reverse_eval, D'.reverseOutside_symm_val, D'.revPtΓ_unrevPtΓ]
    exact m.eval_eq (D.reverseOutside U p)
  dir_pos := fun p hp => by
    have hp' : D.Γ.eval (D.reverseOutside U p).1 ∉ U := by
      rw [D.reverseOutside_val, ← D.reverse_eval]; exact hp
    obtain ⟨l, hl, h⟩ := m.dir_pos_before (D.reverseOutside U p) hp'
    refine ⟨l, hl, ?_⟩
    show D'.reverse.Γ.dir (D'.reverse.Γ.strandOf
        ((D'.reverseOutside U).symm (m.φ (D.reverseOutside U p))).1) =
      l • D.reverse.Γ.dir (D.reverse.Γ.strandOf p.1)
    rw [D'.reverse_dir_strandOf, D.reverse_dir_strandOf, D'.reverseOutside_symm_val,
      D'.revPtΓ_unrevPtΓ, smul_neg]
    exact congrArg Neg.neg h
  dir_pos_before := fun p hp => by
    have hp' : D.Γ.eval (D.reverseOutside U p).1 ∉ U := by
      rw [D.reverseOutside_val, ← D.reverse_eval]; exact hp
    obtain ⟨l, hl, h⟩ := m.dir_pos (D.reverseOutside U p) hp'
    refine ⟨l, hl, ?_⟩
    show D'.reverse.Γ.dir (D'.reverse.Γ.strandBefore
        ((D'.reverseOutside U).symm (m.φ (D.reverseOutside U p))).1) =
      l • D.reverse.Γ.dir (D.reverse.Γ.strandBefore p.1)
    rw [D'.reverse_dir_strandBefore, D.reverse_dir_strandBefore, D'.reverseOutside_symm_val,
      D'.revPtΓ_unrevPtΓ, smul_neg]
    exact congrArg Neg.neg h
  ψ := (D.reverseOuter U).trans (m.ψ.trans (D'.reverseOuter U).symm)
  over_eq := fun x => by
    apply Subtype.ext
    show ((D'.reverseOutside U).symm (m.φ (D.reverseOutside U (D.reverse.outerOverPt x)))).1 =
      D'.reverse.visitPt (D'.reverse.overVisit ((D'.reverseOuter U).symm (m.ψ (D.reverseOuter U x))).1)
    rw [D.reverseOutside_outerOverPt, m.over_eq, D'.reverseOutside_symm_val, D'.reverseOuter_symm_val]
    exact (congrArg D'.unrevPtΓ (D'.reverse_visitPt_overVisit_symm _).symm).trans
      (D'.unrevPtΓ_revPtΓ _)
  under_eq := fun x => by
    apply Subtype.ext
    show ((D'.reverseOutside U).symm (m.φ (D.reverseOutside U (D.reverse.outerUnderPt x)))).1 =
      D'.reverse.visitPt (D'.reverse.underVisit ((D'.reverseOuter U).symm (m.ψ (D.reverseOuter U x))).1)
    rw [D.reverseOutside_outerUnderPt, m.under_eq, D'.reverseOutside_symm_val, D'.reverseOuter_symm_val]
    exact (congrArg D'.unrevPtΓ (D'.reverse_visitPt_underVisit_symm _).symm).trans
      (D'.unrevPtΓ_revPtΓ _)

theorem AgreeOutside.reverse {U : Set Plane} {D D' : Diagram} (h : AgreeOutside U D D') :
    AgreeOutside U D.reverse D'.reverse :=
  h.elim fun m => ⟨m.reverse⟩

/-- The reversal of a move match (same component bijection). -/
def MoveMatch.reverse {U : Set Plane} {D D' : Diagram} (m : MoveMatch U D D') :
    MoveMatch U D.reverse D'.reverse :=
  { m.toOutsideMatch.reverse with
    e := m.e
    comp_eq := fun p => m.comp_eq (D.reverseOutside U p) }

/-! ## Reversal transport, part 5: arcs under reversal -/

section CyclicOrderLemmas

variable {n : ℕ}

/-- For two points `r`, `s` inside the arc from `a` to `b`, "`r` before `s` from `a`" is
"`s` after `r` before `b`". -/
theorem traversalBetween_inner_iff {a b r s : TraversalPoint n} (hr : traversalBetween a r b)
    (hs : traversalBetween a s b) : traversalBetween a r s ↔ traversalBetween r s b := by
  unfold traversalBetween at *
  rcases hr with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rcases hs with ⟨h3, h4⟩ | ⟨h3, h4⟩ | ⟨h3, h4⟩ <;>
    constructor <;> rintro (⟨h5, h6⟩ | ⟨h5, h6⟩ | ⟨h5, h6⟩) <;>
    first
    | exact Or.inl ⟨by linarith, by linarith⟩
    | exact Or.inr (Or.inl ⟨by linarith, by linarith⟩)
    | exact Or.inr (Or.inr ⟨by linarith, by linarith⟩)

/-- Two distinct points inside an arc are comparable along it. -/
theorem traversalBetween_total_inner {a b r s : TraversalPoint n} (hr : traversalBetween a r b)
    (hs : traversalBetween a s b) (hrs : traversalKey r ≠ traversalKey s) :
    traversalBetween a r s ∨ traversalBetween a s r := by
  unfold traversalBetween at *
  rcases lt_or_gt_of_ne hrs with hlt | hlt <;>
  rcases hr with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> rcases hs with ⟨h3, h4⟩ | ⟨h3, h4⟩ | ⟨h3, h4⟩ <;>
    first
    | exact Or.inl (Or.inl ⟨by linarith, by linarith⟩)
    | exact Or.inl (Or.inr (Or.inl ⟨by linarith, by linarith⟩))
    | exact Or.inl (Or.inr (Or.inr ⟨by linarith, by linarith⟩))
    | exact Or.inr (Or.inl ⟨by linarith, by linarith⟩)
    | exact Or.inr (Or.inr (Or.inl ⟨by linarith, by linarith⟩))
    | exact Or.inr (Or.inr (Or.inr ⟨by linarith, by linarith⟩))

/-- The order along an arc is asymmetric. -/
theorem traversalBetween_asymm' {a r s : TraversalPoint n} (h : traversalBetween a r s) :
    ¬ traversalBetween a s r := by
  unfold traversalBetween at *
  rintro (⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩) <;> rcases h with ⟨h3, h4⟩ | ⟨h3, h4⟩ | ⟨h3, h4⟩ <;> linarith

end CyclicOrderLemmas

namespace Shadow

/-- Membership of a point of the arc's component in the open arc, by its parameter. -/
theorem Arc.inner_mk_iff {Γ : Shadow} (a : Γ.Arc) (r : TraversalPoint (Γ.comp a.i).k) :
    a.Inner ⟨a.i, r⟩ ↔ traversalBetween a.start r a.stop := by
  constructor
  · rintro ⟨r', h, e⟩
    rw [Sigma.mk.inj_iff] at e
    rw [eq_of_heq e.2]; exact h
  · intro h; exact ⟨r, h, rfl⟩

variable (Γ : Shadow)

/-- The arc of the reversed shadow with the same points: its ends are the reversed ends of `a`,
exchanged. -/
abbrev revArc (a : Γ.Arc) : Γ.reverseShadow.Arc := ⟨a.i, revPt a.stop, revPt a.start⟩

/-- The inverse relabelling of arcs. -/
abbrev unrevArc (a : Γ.reverseShadow.Arc) : Γ.Arc := ⟨a.i, revPt a.stop, revPt a.start⟩

theorem unrevArc_revArc (a : Γ.Arc) : Γ.unrevArc (Γ.revArc a) = a := by
  show (⟨a.i, revPt (revPt a.start), revPt (revPt a.stop)⟩ : Γ.Arc) = a
  rw [revPt_revPt, revPt_revPt]

theorem revArc_injective : Function.Injective Γ.revArc :=
  Function.LeftInverse.injective Γ.unrevArc_revArc

theorem revArc_startPt (a : Γ.Arc) : Γ.reversePt (Γ.revArc a).startPt = a.stopPt :=
  Sigma.ext rfl (heq_of_eq (revPt_revPt _))

theorem revArc_stopPt (a : Γ.Arc) : Γ.reversePt (Γ.revArc a).stopPt = a.startPt :=
  Sigma.ext rfl (heq_of_eq (revPt_revPt _))

theorem revArc_inner (a : Γ.Arc) (p : Γ.reverseShadow.Pt) :
    (Γ.revArc a).Inner p ↔ a.Inner (Γ.reversePt p) := by
  have hk := (Γ.comp a.i).hk
  constructor
  · rintro ⟨r, hb, rfl⟩
    refine ⟨revPt r, ?_, rfl⟩
    have h := traversalBetween_revPt hk a.start (revPt r) a.stop
    rw [revPt_revPt] at h
    exact h.mp hb
  · rintro ⟨r, hb, hp⟩
    refine ⟨revPt r, (traversalBetween_revPt hk a.start r a.stop).mpr hb, ?_⟩
    exact (Γ.reversePt_eq_iff p ⟨a.i, r⟩).mp hp

theorem revArc_mem (a : Γ.Arc) (p : Γ.reverseShadow.Pt) :
    (Γ.revArc a).Mem p ↔ a.Mem (Γ.reversePt p) := by
  unfold Arc.Mem
  rw [revArc_inner]
  have h1 : p = (Γ.revArc a).startPt ↔ Γ.reversePt p = a.stopPt := by
    rw [Γ.reversePt_eq_iff]; exact Iff.rfl
  have h2 : p = (Γ.revArc a).stopPt ↔ Γ.reversePt p = a.startPt := by
    rw [Γ.reversePt_eq_iff]; exact Iff.rfl
  rw [h1, h2]
  tauto

/-- Along the reversed arc the order of two inner points is reversed. -/
theorem between_revArc {a : Γ.Arc} {r s : TraversalPoint (Γ.comp a.i).k}
    (hr : traversalBetween (revPt a.stop) r (revPt a.start))
    (hs : traversalBetween (revPt a.stop) s (revPt a.start)) :
    traversalBetween (revPt a.stop) r s ↔ traversalBetween a.start (revPt s) (revPt r) := by
  rw [traversalBetween_inner_iff hr hs]
  have h := traversalBetween_revPt (Γ.comp a.i).hk a.start (revPt s) (revPt r)
  rw [revPt_revPt, revPt_revPt] at h
  exact h

theorem revArc_before (a : Γ.Arc) (p q : Γ.reverseShadow.Pt) :
    (Γ.revArc a).Before p q ↔ a.Before (Γ.reversePt q) (Γ.reversePt p) := by
  constructor
  · rintro ⟨hp, hq, r, s, rfl, rfl, hb⟩
    have hr := (Arc.inner_mk_iff (Γ.revArc a) r).mp hp
    have hs := (Arc.inner_mk_iff (Γ.revArc a) s).mp hq
    refine ⟨(Γ.revArc_inner a _).mp hq, (Γ.revArc_inner a _).mp hp, revPt s, revPt r, rfl, rfl, ?_⟩
    exact (Γ.between_revArc hr hs).mp hb
  · rintro ⟨hq, hp, r', s', hq', hp', hb⟩
    rw [Γ.reversePt_eq_iff] at hq' hp'
    subst hq' hp'
    have hpI : (Γ.revArc a).Inner (Γ.unreversePt ⟨a.i, s'⟩) := (Γ.revArc_inner a _).mpr hp
    have hqI : (Γ.revArc a).Inner (Γ.unreversePt ⟨a.i, r'⟩) := (Γ.revArc_inner a _).mpr hq
    refine ⟨hpI, hqI, revPt s', revPt r', rfl, rfl, ?_⟩
    have hr := (Arc.inner_mk_iff (Γ.revArc a) (revPt s')).mp hpI
    have hs := (Arc.inner_mk_iff (Γ.revArc a) (revPt r')).mp hqI
    have h := (Γ.between_revArc hr hs).mpr
    rw [revPt_revPt, revPt_revPt] at h
    exact h hb

theorem revArc_isArc (U : Set Plane) (a : Γ.Arc) :
    Γ.reverseShadow.IsArc U (Γ.revArc a) ↔ Γ.IsArc U a := by
  constructor
  · intro h
    refine ⟨fun e => h.start_ne_stop (by show revPt a.stop = revPt a.start; rw [e]), ?_, ?_, ?_⟩
    · have := h.stop_frontier
      rwa [reverse_eval_pt, revArc_stopPt] at this
    · have := h.start_frontier
      rwa [reverse_eval_pt, revArc_startPt] at this
    · intro p hp
      have := h.inner_interior (Γ.unreversePt p)
        ((Γ.revArc_inner a _).mpr (by rwa [reversePt_unreversePt]))
      rwa [reverse_eval_pt, reversePt_unreversePt] at this
  · intro h
    refine ⟨fun e => h.start_ne_stop ?_, ?_, ?_, ?_⟩
    · have := congrArg revPt e
      rw [revPt_revPt, revPt_revPt] at this
      exact this.symm
    · rw [reverse_eval_pt, revArc_startPt]; exact h.stop_frontier
    · rw [reverse_eval_pt, revArc_stopPt]; exact h.start_frontier
    · intro p hp
      rw [reverse_eval_pt]
      exact h.inner_interior _ ((Γ.revArc_inner a p).mp hp)

/-- The reversal of an arc cover. -/
theorem ArcCover.reverse {U : Set Plane} {Γ : Shadow} {A : Set Γ.Arc} (h : Γ.ArcCover U A) :
    Γ.reverseShadow.ArcCover U (Γ.revArc '' A) where
  isArc := by
    rintro _ ⟨a, ha, rfl⟩
    exact (Γ.revArc_isArc U a).mpr (h.isArc a ha)
  mem_iff := fun p => by
    rw [reverse_eval_pt, h.mem_iff (Γ.reversePt p), Set.exists_mem_image]
    exact exists_congr fun a => and_congr_right fun _ => (Γ.revArc_mem a p).symm
  disjoint := by
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩ hab p hp
    rw [revArc_mem] at hp ⊢
    exact h.disjoint a ha b hb (fun e => hab (congrArg Γ.revArc e)) _ hp

end Shadow

namespace Diagram

variable (D : Diagram)

/-- Arcs of the reversal (typed on `D.reverse`). -/
def revArc (a : D.Γ.Arc) : D.reverse.Γ.Arc := D.Γ.revArc a

theorem revArc_injective : Function.Injective D.revArc := D.Γ.revArc_injective

theorem revArc_inner (a : D.Γ.Arc) (p : D.reverse.Γ.Pt) :
    (D.revArc a).Inner p ↔ a.Inner (D.revPtΓ p) := D.Γ.revArc_inner a p

theorem revArc_mem (a : D.Γ.Arc) (p : D.reverse.Γ.Pt) : (D.revArc a).Mem p ↔ a.Mem (D.revPtΓ p) :=
  D.Γ.revArc_mem a p

theorem revArc_before (a : D.Γ.Arc) (p q : D.reverse.Γ.Pt) :
    (D.revArc a).Before p q ↔ a.Before (D.revPtΓ q) (D.revPtΓ p) := D.Γ.revArc_before a p q

theorem revArc_isArc (U : Set Plane) (a : D.Γ.Arc) :
    D.reverse.Γ.IsArc U (D.revArc a) ↔ D.Γ.IsArc U a := D.Γ.revArc_isArc U a

theorem arcCover_reverse {U : Set Plane} {A : Set D.Γ.Arc} (h : D.Γ.ArcCover U A) :
    D.reverse.Γ.ArcCover U (D.revArc '' A) := Shadow.ArcCover.reverse h

theorem reverse_eval_revArc_startPt (a : D.Γ.Arc) :
    D.reverse.Γ.eval (D.revArc a).startPt = D.Γ.eval a.stopPt := by
  rw [D.reverse_eval]; exact congrArg D.Γ.eval (D.Γ.revArc_startPt a)

theorem reverse_eval_revArc_stopPt (a : D.Γ.Arc) :
    D.reverse.Γ.eval (D.revArc a).stopPt = D.Γ.eval a.startPt := by
  rw [D.reverse_eval]; exact congrArg D.Γ.eval (D.Γ.revArc_stopPt a)

theorem reverseVisit_symm_fst (v : D.Γ.Visit) :
    (D.reverseVisit.symm v).1 = D.reverseCrossing.symm v.1 := by
  apply D.reverseCrossing.injective
  rw [Equiv.apply_symm_apply, ← reverseVisit_fst, Equiv.apply_symm_apply]

theorem reverse_overOn (a : D.Γ.Arc) (x : D.reverse.Γ.Crossing) :
    D.reverse.OverOn (D.revArc a) x ↔ D.OverOn a (D.reverseCrossing x) := by
  unfold OverOn
  rw [D.revArc_mem, D.reverse_visitPt_overVisit]

theorem reverse_underOn (a : D.Γ.Arc) (x : D.reverse.Γ.Crossing) :
    D.reverse.UnderOn (D.revArc a) x ↔ D.UnderOn a (D.reverseCrossing x) := by
  unfold UnderOn
  rw [D.revArc_mem, D.reverse_visitPt_underVisit]

theorem reverse_separates (a b : D.Γ.Arc) (x : D.reverse.Γ.Crossing) :
    D.reverse.Separates (D.revArc a) (D.revArc b) x ↔ D.Separates a b (D.reverseCrossing x) := by
  unfold Separates
  rw [reverse_overOn, reverse_overOn, reverse_underOn, reverse_underOn]

/-- Reversal reverses the order of the occurrences along every arc. -/
theorem reverse_beforeOn (a : D.Γ.Arc) (x y : D.reverse.Γ.Crossing) :
    D.reverse.BeforeOn (D.revArc a) x y ↔
      D.BeforeOn a (D.reverseCrossing y) (D.reverseCrossing x) := by
  constructor
  · rintro ⟨v, w, hv, hw, h⟩
    refine ⟨D.reverseVisit w, D.reverseVisit v, by rw [reverseVisit_fst, hw],
      by rw [reverseVisit_fst, hv], ?_⟩
    rw [D.revArc_before, D.reverse_visitPt, D.reverse_visitPt] at h
    exact h
  · rintro ⟨v, w, hv, hw, h⟩
    refine ⟨D.reverseVisit.symm w, D.reverseVisit.symm v, ?_, ?_, ?_⟩
    · rw [reverseVisit_symm_fst, hw, Equiv.symm_apply_apply]
    · rw [reverseVisit_symm_fst, hv, Equiv.symm_apply_apply]
    · rw [D.revArc_before, D.reverse_visitPt, D.reverse_visitPt, Equiv.apply_symm_apply,
        Equiv.apply_symm_apply]
      exact h

end Diagram

/-! ## The order of two crossings along an arc is asymmetric and total

For two crossings between an arc `a` and two other arcs of a cover, "the `a`-occurrence of `x` is
met before that of `y`" and its converse are exclusive and exhaustive.  Used to transport the
reversed-visit-order clauses of a Reidemeister III site under reversal (which reverses the order
along every arc). -/

namespace Shadow.Arc

variable {Γ : Shadow} {a : Γ.Arc}

theorem before_asymm {p q : Γ.Pt} (h : a.Before p q) : ¬ a.Before q p := by
  rintro ⟨-, -, r', s', hq, hp, hb'⟩
  obtain ⟨-, -, r, s, rfl, rfl, hb⟩ := h
  rw [Sigma.mk.inj_iff] at hq hp
  rw [← eq_of_heq hq.2, ← eq_of_heq hp.2] at hb'
  exact traversalBetween_asymm' hb hb'

theorem before_total {p q : Γ.Pt} (hp : a.Inner p) (hq : a.Inner q) (hpq : p ≠ q) :
    a.Before p q ∨ a.Before q p := by
  obtain ⟨r, hr, rfl⟩ := hp
  obtain ⟨s, hs, rfl⟩ := hq
  have hrs : traversalKey r ≠ traversalKey s := fun h => hpq (by rw [traversalKey_injective h])
  rcases traversalBetween_total_inner hr hs hrs with h | h
  · exact Or.inl ⟨⟨r, hr, rfl⟩, ⟨s, hs, rfl⟩, r, s, rfl, rfl, h⟩
  · exact Or.inr ⟨⟨s, hs, rfl⟩, ⟨r, hr, rfl⟩, s, r, rfl, rfl, h⟩

end Shadow.Arc

namespace Diagram

variable (D : Diagram)

theorem Separates.symm {a b : D.Γ.Arc} {x : D.Γ.Crossing} (h : D.Separates a b x) :
    D.Separates b a x := Or.symm h

/-- A crossing between two arcs has an occurrence on the first arc. -/
theorem exists_visit_on_arc {a b : D.Γ.Arc} {x : D.Γ.Crossing} (sep : D.Separates a b x) :
    ∃ v : D.Γ.Visit, v.1 = x ∧ a.Mem (D.visitPt v) := by
  rcases sep with ⟨h, -⟩ | ⟨-, h⟩
  · exact ⟨D.overVisit x, rfl, h⟩
  · exact ⟨D.underVisit x, rfl, h⟩

/-- The occurrence on `a` of a crossing between `a` and a disjoint arc `b` is unique. -/
theorem visit_on_arc_unique {U : Set Plane} {A : Set D.Γ.Arc} (cover : D.Γ.ArcCover U A)
    {a b : D.Γ.Arc} (ha : a ∈ A) (hb : b ∈ A) (hab : a ≠ b) {x : D.Γ.Crossing}
    (sep : D.Separates a b x) {v w : D.Γ.Visit} (hv : v.1 = x) (hw : w.1 = x)
    (hva : a.Mem (D.visitPt v)) (hwa : a.Mem (D.visitPt w)) : v = w := by
  rcases sep with ⟨-, hub⟩ | ⟨hob, -⟩
  · have key : ∀ u : D.Γ.Visit, u.1 = x → a.Mem (D.visitPt u) → u = D.overVisit x := by
      intro u hu hua
      have h := D.visit_eq_over_or_under u
      rw [hu] at h
      rcases h with h | h
      · exact h
      · exfalso
        rw [h] at hua
        exact cover.disjoint a ha b hb hab _ hua hub
    rw [key v hv hva, key w hw hwa]
  · have key : ∀ u : D.Γ.Visit, u.1 = x → a.Mem (D.visitPt u) → u = D.underVisit x := by
      intro u hu hua
      have h := D.visit_eq_over_or_under u
      rw [hu] at h
      rcases h with h | h
      · exfalso
        rw [h] at hua
        exact cover.disjoint a ha b hb hab _ hua hob
      · exact h
    rw [key v hv hva, key w hw hwa]

/-- A point of an arc of `U` whose plane point is in the interior of `U` is an inner point. -/
theorem inner_of_mem_of_interior {U : Set Plane} {a : D.Γ.Arc} (ha : D.Γ.IsArc U a) {p : D.Γ.Pt}
    (hp : a.Mem p) (hin : D.Γ.eval p ∈ interior U) : a.Inner p := by
  rcases hp with rfl | rfl | h
  · exact absurd hin ha.start_frontier.2
  · exact absurd hin ha.stop_frontier.2
  · exact h

theorem beforeOn_iff_before {U : Set Plane} {A : Set D.Γ.Arc} (cover : D.Γ.ArcCover U A)
    {a b c : D.Γ.Arc} (ha : a ∈ A) (hb : b ∈ A) (hc : c ∈ A) (hab : a ≠ b) (hac : a ≠ c)
    {x y : D.Γ.Crossing} (sepx : D.Separates a b x) (sepy : D.Separates a c y)
    {vx vy : D.Γ.Visit} (hvx : vx.1 = x) (hvy : vy.1 = y) (hvxa : a.Mem (D.visitPt vx))
    (hvya : a.Mem (D.visitPt vy)) :
    D.BeforeOn a x y ↔ a.Before (D.visitPt vx) (D.visitPt vy) := by
  constructor
  · rintro ⟨v, w, hv, hw, h⟩
    rw [D.visit_on_arc_unique cover ha hb hab sepx hv hvx h.inner_left.mem hvxa,
      D.visit_on_arc_unique cover ha hc hac sepy hw hvy h.inner_right.mem hvya] at h
    exact h
  · intro h
    exact ⟨vx, vy, hvx, hvy, h⟩

/-- Sanity (the "reversed visit order" clauses of a Reidemeister III site are unambiguous): for two
crossings `x`, `y` of `a` with disjoint arcs `b`, `c` inside `U`, the `a`-occurrence of `y`
precedes that of `x` exactly when that of `x` does not precede that of `y`. -/
theorem beforeOn_swap_iff {U : Set Plane} {A : Set D.Γ.Arc} (cover : D.Γ.ArcCover U A)
    {a b c : D.Γ.Arc} (ha : a ∈ A) (hb : b ∈ A) (hc : c ∈ A) (hab : a ≠ b) (hac : a ≠ c)
    {x y : D.Γ.Crossing} (hxy : x ≠ y) (hx : D.Γ.crossingPoint x ∈ interior U)
    (hy : D.Γ.crossingPoint y ∈ interior U) (sepx : D.Separates a b x) (sepy : D.Separates a c y) :
    D.BeforeOn a y x ↔ ¬ D.BeforeOn a x y := by
  obtain ⟨vx, hvx, hvxa⟩ := D.exists_visit_on_arc sepx
  obtain ⟨vy, hvy, hvya⟩ := D.exists_visit_on_arc sepy
  have hxa : a.Inner (D.visitPt vx) :=
    D.inner_of_mem_of_interior (cover.isArc a ha) hvxa (by rw [D.eval_visitPt, hvx]; exact hx)
  have hya : a.Inner (D.visitPt vy) :=
    D.inner_of_mem_of_interior (cover.isArc a ha) hvya (by rw [D.eval_visitPt, hvy]; exact hy)
  have hne : D.visitPt vx ≠ D.visitPt vy := fun e => by
    have := congrArg Sigma.fst (D.visitPt_injective e)
    rw [hvx, hvy] at this
    exact hxy this
  rw [D.beforeOn_iff_before cover ha hc hb hac hab sepy sepx hvy hvx hvya hvxa,
    D.beforeOn_iff_before cover ha hb hc hab hac sepx sepy hvx hvy hvxa hvya]
  constructor
  · exact fun h => Shadow.Arc.before_asymm h
  · intro h
    rcases Shadow.Arc.before_total hxa hya hne with h' | h'
    · exact absurd h' h
    · exact h'

end Diagram

/-! ## Reversal transport, part 6: the three moves, the smoothing, skein triples -/

/-- The reversal of a Reidemeister I site (the arc ends are exchanged). -/
def RIData.reverse {U : Set Plane} {D D' : Diagram} (h : RIData U D D') :
    RIData U D.reverse D'.reverse where
  frame := h.frame.reverse
  out := h.out.reverse
  a := D.revArc h.a
  a' := D'.revArc h.a'
  cover := by
    have := D.arcCover_reverse h.cover
    rwa [Set.image_singleton] at this
  cover' := by
    have := D'.arcCover_reverse h.cover'
    rwa [Set.image_singleton] at this
  start_eq := by
    rw [D'.reverse_eval_revArc_startPt, D.reverse_eval_revArc_startPt]; exact h.stop_eq
  stop_eq := by
    rw [D'.reverse_eval_revArc_stopPt, D.reverse_eval_revArc_stopPt]; exact h.start_eq
  no_inner := fun x hx =>
    h.no_inner (D.reverseCrossing x) (by rw [← D.reverse_crossingPoint]; exact hx)
  kink := D'.reverseCrossing.symm h.kink
  inner_iff' := fun y => by
    rw [D'.reverse_crossingPoint, h.inner_iff']
    exact D'.reverseCrossing.eq_symm_apply.symm

/-- Reversal carries Reidemeister I to Reidemeister I. -/
theorem reverseCarries_RI : ReverseCarries RI := by
  rintro D D' ⟨U, h | h⟩
  · exact ⟨U, Or.inl ⟨h.some.reverse⟩⟩
  · exact ⟨U, Or.inr ⟨h.some.reverse⟩⟩

/-- The reversal of a Reidemeister II site. -/
def RIIData.reverse {U : Set Plane} {D D' : Diagram} (h : RIIData U D D') :
    RIIData U D.reverse D'.reverse where
  frame := h.frame.reverse
  out := h.out.reverse
  a := D.revArc h.a
  b := D.revArc h.b
  a' := D'.revArc h.a'
  b' := D'.revArc h.b'
  ab := fun e => h.ab (D.revArc_injective e)
  ab' := fun e => h.ab' (D'.revArc_injective e)
  cover := by
    have := D.arcCover_reverse h.cover
    rwa [Set.image_insert_eq, Set.image_singleton] at this
  cover' := by
    have := D'.arcCover_reverse h.cover'
    rwa [Set.image_insert_eq, Set.image_singleton] at this
  a_start := by
    rw [D'.reverse_eval_revArc_startPt, D.reverse_eval_revArc_startPt]; exact h.a_stop
  a_stop := by
    rw [D'.reverse_eval_revArc_stopPt, D.reverse_eval_revArc_stopPt]; exact h.a_start
  b_start := by
    rw [D'.reverse_eval_revArc_startPt, D.reverse_eval_revArc_startPt]; exact h.b_stop
  b_stop := by
    rw [D'.reverse_eval_revArc_stopPt, D.reverse_eval_revArc_stopPt]; exact h.b_start
  no_inner := fun x hx =>
    h.no_inner (D.reverseCrossing x) (by rw [← D.reverse_crossingPoint]; exact hx)
  x₁ := D'.reverseCrossing.symm h.x₁
  x₂ := D'.reverseCrossing.symm h.x₂
  ne := fun e => h.ne (D'.reverseCrossing.symm.injective e)
  inner_iff' := fun y => by
    rw [D'.reverse_crossingPoint, h.inner_iff', ← D'.reverseCrossing.eq_symm_apply,
      ← D'.reverseCrossing.eq_symm_apply]
  sep₁ := (D'.reverse_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep₁)
  sep₂ := (D'.reverse_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep₂)
  same_over := by
    rw [D'.reverse_overOn, D'.reverse_overOn, D'.reverse_overOn, D'.reverse_overOn,
      Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    exact h.same_over

/-- Reversal carries Reidemeister II to Reidemeister II. -/
theorem reverseCarries_RII : ReverseCarries RII := by
  rintro D D' ⟨U, h | h⟩
  · exact ⟨U, Or.inl ⟨h.some.reverse⟩⟩
  · exact ⟨U, Or.inr ⟨h.some.reverse⟩⟩

/-- The reversal of a Reidemeister III site: the height order is kept (over data kept), the arc
ends are exchanged, and the visit orders along every arc are reversed on both sides, so the
"reversed order" clauses are transported through `beforeOn_swap_iff`. -/
def RIIIData.reverse {U : Set Plane} {D D' : Diagram} (h : RIIIData U D D') :
    RIIIData U D.reverse D'.reverse where
  frame := h.frame.reverse
  out := h.out.reverse
  a := D.revArc h.a
  b := D.revArc h.b
  c := D.revArc h.c
  a' := D'.revArc h.a'
  b' := D'.revArc h.b'
  c' := D'.revArc h.c'
  ab := fun e => h.ab (D.revArc_injective e)
  bc := fun e => h.bc (D.revArc_injective e)
  ac := fun e => h.ac (D.revArc_injective e)
  ab' := fun e => h.ab' (D'.revArc_injective e)
  bc' := fun e => h.bc' (D'.revArc_injective e)
  ac' := fun e => h.ac' (D'.revArc_injective e)
  cover := by
    have := D.arcCover_reverse h.cover
    rwa [Set.image_insert_eq, Set.image_insert_eq, Set.image_singleton] at this
  cover' := by
    have := D'.arcCover_reverse h.cover'
    rwa [Set.image_insert_eq, Set.image_insert_eq, Set.image_singleton] at this
  a_start := by
    rw [D'.reverse_eval_revArc_startPt, D.reverse_eval_revArc_startPt]; exact h.a_stop
  a_stop := by
    rw [D'.reverse_eval_revArc_stopPt, D.reverse_eval_revArc_stopPt]; exact h.a_start
  b_start := by
    rw [D'.reverse_eval_revArc_startPt, D.reverse_eval_revArc_startPt]; exact h.b_stop
  b_stop := by
    rw [D'.reverse_eval_revArc_stopPt, D.reverse_eval_revArc_stopPt]; exact h.b_start
  c_start := by
    rw [D'.reverse_eval_revArc_startPt, D.reverse_eval_revArc_startPt]; exact h.c_stop
  c_stop := by
    rw [D'.reverse_eval_revArc_stopPt, D.reverse_eval_revArc_stopPt]; exact h.c_start
  xab := D.reverseCrossing.symm h.xab
  xac := D.reverseCrossing.symm h.xac
  xbc := D.reverseCrossing.symm h.xbc
  xab_ne_xac := fun e => h.xab_ne_xac (D.reverseCrossing.symm.injective e)
  xab_ne_xbc := fun e => h.xab_ne_xbc (D.reverseCrossing.symm.injective e)
  xac_ne_xbc := fun e => h.xac_ne_xbc (D.reverseCrossing.symm.injective e)
  inner_iff := fun y => by
    rw [D.reverse_crossingPoint, h.inner_iff, ← D.reverseCrossing.eq_symm_apply,
      ← D.reverseCrossing.eq_symm_apply, ← D.reverseCrossing.eq_symm_apply]
  sep_ab := (D.reverse_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep_ab)
  sep_ac := (D.reverse_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep_ac)
  sep_bc := (D.reverse_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep_bc)
  xab' := D'.reverseCrossing.symm h.xab'
  xac' := D'.reverseCrossing.symm h.xac'
  xbc' := D'.reverseCrossing.symm h.xbc'
  xab_ne_xac' := fun e => h.xab_ne_xac' (D'.reverseCrossing.symm.injective e)
  xab_ne_xbc' := fun e => h.xab_ne_xbc' (D'.reverseCrossing.symm.injective e)
  xac_ne_xbc' := fun e => h.xac_ne_xbc' (D'.reverseCrossing.symm.injective e)
  inner_iff' := fun y => by
    rw [D'.reverse_crossingPoint, h.inner_iff', ← D'.reverseCrossing.eq_symm_apply,
      ← D'.reverseCrossing.eq_symm_apply, ← D'.reverseCrossing.eq_symm_apply]
  sep_ab' := (D'.reverse_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep_ab')
  sep_ac' := (D'.reverse_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep_ac')
  sep_bc' := (D'.reverse_separates _ _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.sep_bc')
  top_ab := (D.reverse_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.top_ab)
  top_ac := (D.reverse_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.top_ac)
  mid_bc := (D.reverse_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.mid_bc)
  top_ab' := (D'.reverse_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.top_ab')
  top_ac' := (D'.reverse_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.top_ac')
  mid_bc' := (D'.reverse_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.mid_bc')
  rev_a := by
    have hxab : D.Γ.crossingPoint h.xab ∈ interior U := (h.inner_iff _).mpr (Or.inl rfl)
    have hxac : D.Γ.crossingPoint h.xac ∈ interior U := (h.inner_iff _).mpr (Or.inr (Or.inl rfl))
    have hxab' : D'.Γ.crossingPoint h.xab' ∈ interior U := (h.inner_iff' _).mpr (Or.inl rfl)
    have hxac' : D'.Γ.crossingPoint h.xac' ∈ interior U :=
      (h.inner_iff' _).mpr (Or.inr (Or.inl rfl))
    rw [D.reverse_beforeOn, D'.reverse_beforeOn, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      D.beforeOn_swap_iff h.cover (by simp) (by simp) (by simp) h.ab h.ac h.xab_ne_xac hxab hxac
        h.sep_ab h.sep_ac,
      D'.beforeOn_swap_iff h.cover' (by simp) (by simp) (by simp) h.ac' h.ab' h.xab_ne_xac'.symm
        hxac' hxab' h.sep_ac' h.sep_ab']
    exact not_congr h.rev_a
  rev_b := by
    have hxab : D.Γ.crossingPoint h.xab ∈ interior U := (h.inner_iff _).mpr (Or.inl rfl)
    have hxbc : D.Γ.crossingPoint h.xbc ∈ interior U := (h.inner_iff _).mpr (Or.inr (Or.inr rfl))
    have hxab' : D'.Γ.crossingPoint h.xab' ∈ interior U := (h.inner_iff' _).mpr (Or.inl rfl)
    have hxbc' : D'.Γ.crossingPoint h.xbc' ∈ interior U :=
      (h.inner_iff' _).mpr (Or.inr (Or.inr rfl))
    rw [D.reverse_beforeOn, D'.reverse_beforeOn, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      D.beforeOn_swap_iff h.cover (by simp) (by simp) (by simp) h.ab.symm h.bc h.xab_ne_xbc hxab
        hxbc h.sep_ab.symm h.sep_bc,
      D'.beforeOn_swap_iff h.cover' (by simp) (by simp) (by simp) h.bc' h.ab'.symm
        h.xab_ne_xbc'.symm hxbc' hxab' h.sep_bc' h.sep_ab'.symm]
    exact not_congr h.rev_b
  rev_c := by
    have hxac : D.Γ.crossingPoint h.xac ∈ interior U := (h.inner_iff _).mpr (Or.inr (Or.inl rfl))
    have hxbc : D.Γ.crossingPoint h.xbc ∈ interior U := (h.inner_iff _).mpr (Or.inr (Or.inr rfl))
    have hxac' : D'.Γ.crossingPoint h.xac' ∈ interior U :=
      (h.inner_iff' _).mpr (Or.inr (Or.inl rfl))
    have hxbc' : D'.Γ.crossingPoint h.xbc' ∈ interior U :=
      (h.inner_iff' _).mpr (Or.inr (Or.inr rfl))
    rw [D.reverse_beforeOn, D'.reverse_beforeOn, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      Equiv.apply_symm_apply, Equiv.apply_symm_apply,
      D.beforeOn_swap_iff h.cover (by simp) (by simp) (by simp) h.ac.symm h.bc.symm h.xac_ne_xbc
        hxac hxbc h.sep_ac.symm h.sep_bc.symm,
      D'.beforeOn_swap_iff h.cover' (by simp) (by simp) (by simp) h.bc'.symm h.ac'.symm
        h.xac_ne_xbc'.symm hxbc' hxac' h.sep_bc'.symm h.sep_ac'.symm]
    exact not_congr h.rev_c

/-- Reversal carries Reidemeister III to Reidemeister III. -/
theorem reverseCarries_RIII : ReverseCarries RIII := by
  rintro D D' ⟨U, h | h⟩
  · exact ⟨U, Or.inl ⟨h.some.reverse⟩⟩
  · exact ⟨U, Or.inr ⟨h.some.reverse⟩⟩

/-- Reversal carries link equivalence to link equivalence (cf:thm-carrierfloor (R); design
decision D2's reviewer check, reversal half). -/
theorem reverseCarries_linkEquiv : ReverseCarries LinkEquiv :=
  reverseCarries_linkEquiv_of reverseCarries_planarIsotopic reverseCarries_RI reverseCarries_RII
    reverseCarries_RIII

theorem LinkEquiv.reverse {D D' : Diagram} (h : LinkEquiv D D') : LinkEquiv D.reverse D'.reverse :=
  reverseCarries_linkEquiv D D' h

/-- The reversal of a smoothing site: the two arcs of the smoothing exchange their roles (each
still runs from the entering end of one strand to the exiting end of the other). -/
def OrientedSmoothingData.reverse {U : Set Plane} {D : Diagram} {x : D.Γ.Crossing} {D₀ : Diagram}
    (h : OrientedSmoothingData U D x D₀) :
    OrientedSmoothingData U D.reverse (D.reverseCrossing.symm x) D₀.reverse where
  frame := h.frame.reverse
  center := by rw [D.reverse_crossingPoint, Equiv.apply_symm_apply]; exact h.center
  out := h.out.reverse
  a := D.revArc h.a
  b := D.revArc h.b
  ab := fun e => h.ab (D.revArc_injective e)
  cover := by
    have := D.arcCover_reverse h.cover
    rwa [Set.image_insert_eq, Set.image_singleton] at this
  over_on_a := (D.reverse_overOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.over_on_a)
  under_on_b := (D.reverse_underOn _ _).mpr (by rw [Equiv.apply_symm_apply]; exact h.under_on_b)
  inner_iff := fun y => by
    rw [D.reverse_crossingPoint, h.inner_iff]
    exact D.reverseCrossing.eq_symm_apply.symm
  a₀ := D₀.revArc h.b₀
  b₀ := D₀.revArc h.a₀
  ab₀ := fun e => h.ab₀ (D₀.revArc_injective e).symm
  cover₀ := by
    have := D₀.arcCover_reverse h.cover₀
    rwa [Set.image_insert_eq, Set.image_singleton, Set.pair_comm] at this
  no_inner₀ := fun y hy =>
    h.no_inner₀ (D₀.reverseCrossing y) (by rw [← D₀.reverse_crossingPoint]; exact hy)
  a₀_start := by
    rw [D₀.reverse_eval_revArc_startPt, D.reverse_eval_revArc_startPt]; exact h.b₀_stop
  a₀_stop := by
    rw [D₀.reverse_eval_revArc_stopPt, D.reverse_eval_revArc_stopPt]; exact h.b₀_start
  b₀_start := by
    rw [D₀.reverse_eval_revArc_startPt, D.reverse_eval_revArc_startPt]; exact h.a₀_stop
  b₀_stop := by
    rw [D₀.reverse_eval_revArc_stopPt, D.reverse_eval_revArc_stopPt]; exact h.a₀_start

/-- Reversal carries oriented smoothings to oriented smoothings. -/
theorem IsOrientedSmoothing.reverse {D : Diagram} {x : D.Γ.Crossing} {D₀ : Diagram}
    (h : IsOrientedSmoothing D x D₀) :
    IsOrientedSmoothing D.reverse (D.reverseCrossing.symm x) D₀.reverse := by
  obtain ⟨U, h⟩ := h
  exact ⟨U, ⟨h.some.reverse⟩⟩

/-- The reversal of a switch is the switch of the reversal. -/
theorem Diagram.reverse_of_switch (D : Diagram) (x : D.Γ.Crossing) :
    (D.switch x).reverse = D.reverse.switch (D.reverseCrossing.symm x) := by
  apply Diagram.mk_eq_of_overStrand_eq
  funext y
  apply D.Γ.reverseMap.inj
  have e1 : D.Γ.reverseMap.toFun ((D.switch x).reverse.overStrand y) =
      (D.switch x).overStrand (D.reverseCrossing y) := (D.switch x).reverse_overStrand y
  by_cases hy : D.reverseCrossing y = x
  · have hy' : y = D.reverseCrossing.symm x := D.reverseCrossing.eq_symm_apply.mpr hy
    have l1 : (D.switch x).overStrand (D.reverseCrossing y) = D.underStrand x :=
      (congrArg (D.switch x).overStrand hy).trans (D.switch_overStrand_self x)
    have r1 : D.Γ.reverseMap.toFun ((D.reverse.switch (D.reverseCrossing.symm x)).overStrand y) =
        D.underStrand x :=
      (congrArg (fun z => D.Γ.reverseMap.toFun
        ((D.reverse.switch (D.reverseCrossing.symm x)).overStrand z)) hy').trans
        ((congrArg D.Γ.reverseMap.toFun (D.reverse.switch_overStrand_self _)).trans
          ((D.reverse_underStrand _).trans (congrArg D.underStrand (Equiv.apply_symm_apply _ _))))
    exact e1.trans (l1.trans r1.symm)
  · have hy' : y ≠ D.reverseCrossing.symm x := fun e => hy (D.reverseCrossing.eq_symm_apply.mp e)
    have l1 : (D.switch x).overStrand (D.reverseCrossing y) = D.overStrand (D.reverseCrossing y) :=
      D.switch_overStrand_of_ne hy
    have r1 : D.Γ.reverseMap.toFun ((D.reverse.switch (D.reverseCrossing.symm x)).overStrand y) =
        D.overStrand (D.reverseCrossing y) :=
      (congrArg D.Γ.reverseMap.toFun (D.reverse.switch_overStrand_of_ne hy')).trans
        (D.reverse_overStrand y)
    exact e1.trans (l1.trans r1.symm)

/-- Reversal carries skein triples to skein triples with the sides kept (reversal keeps every
sign, `Diagram.reverse_sign`; cf:thm-carrierfloor (R)). -/
theorem IsSkeinTriple.reverse {Dp Dm D0 : Diagram} (h : IsSkeinTriple Dp Dm D0) :
    IsSkeinTriple Dp.reverse Dm.reverse D0.reverse := by
  obtain ⟨x, hx, rfl, hs⟩ := h
  refine ⟨Dp.reverseCrossing.symm x, ?_, Dp.reverse_of_switch x, hs.reverse⟩
  have e : Dp.reverse.sign (Dp.reverseCrossing.symm x) = Dp.sign x :=
    (Dp.reverse_sign (Dp.reverseCrossing.symm x)).trans
      (congrArg Dp.sign (Equiv.apply_symm_apply Dp.reverseCrossing x))
  rw [Dp.reverse.isPositive_iff_sign_eq_one, e]
  exact (Dp.isPositive_iff_sign_eq_one x).mp hx

theorem reverse_skein : ReverseSkein := fun _ _ _ h => h.reverse

